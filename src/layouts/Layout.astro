---
interface FaqItem { q: string; a: string; }
interface Props {
  title: string;
  description?: string;
  faq?: FaqItem[];
}

const defaultFaq: FaqItem[] = [
  { q: "What is FileFlex and how does it secure unstructured data?", a: "FileFlex is a Zero Trust Data Access platform that provides secure, policy-driven access to unstructured data across on-premises, cloud, and hybrid storage without moving or copying the data. It enforces least-privilege access and records all activity for audit and compliance." },
  { q: "How does FileFlex enforce Zero Trust principles?", a: "FileFlex enforces Zero Trust by authenticating each request, evaluating access against centrally defined policies, and ensuring only authorized users receive access based on context and permissions. Storage systems remain dark unless explicitly accessed through FileFlex policy workflows." },
  { q: "Can FileFlex help reduce ransomware and data exfiltration risk?", a: "Yes. FileFlex\u2019s Zero Trust model limits open access to file shares and network drives, reducing the attack surface. Its detailed activity logs and ability to detect unusual access or extraction patterns can help identify ransomware behavior during data exfiltration, enabling faster detection and response." },
  { q: "Does FileFlex work with existing enterprise systems like Active Directory and cloud storage?", a: "Yes. FileFlex integrates with enterprise identity providers such as Active Directory and Azure AD for authentication and policy enforcement. It federates access to existing on-premises and cloud file systems, SharePoint, and NAS without requiring changes to your infrastructure." },
];

const { title, description = "FileFlex Enterprise applies Zero Trust Data Access to unstructured data wherever it resides — without migration or VPN.", faq = defaultFaq } = Astro.props;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="9k9cAXiT4tUWTSCDP50YrvqIaRj0eh1QKbIRHi8nXTY" />
  <title>{title}</title>
  <!--
    Google Analytics 4 — loaded lazily (on first interaction, or when the
    browser goes idle) instead of during page load. gtag.js performs geometry
    reads that force a reflow on the main thread; deferring it keeps that work
    off the critical render path. Commands queue in dataLayer and run as soon
    as the library arrives, so no events are lost.
  -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-YKYH32CPDL');

    (function () {
      var loaded = false;
      var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
      function loadGA() {
        if (loaded) return;
        loaded = true;
        events.forEach(function (e) { window.removeEventListener(e, loadGA); });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-YKYH32CPDL';
        document.head.appendChild(s);
      }
      events.forEach(function (e) { window.addEventListener(e, loadGA, { passive: true }); });
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGA, { timeout: 5000 });
      } else {
        setTimeout(loadGA, 4000);
      }
    })();
  </script>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="shortcut icon" type="image/x-icon" href="https://fileflex.com/wp-content/uploads/2015/03/favicon.ico" />
  {/*
    Preconnect is reserved for the 2-3 origins on the critical render path.
    Google PSI warns when there are more than 4 preconnects, since each one
    holds an open socket the browser may not use. Other third-parties get
    dns-prefetch only — cheaper and sufficient for non-render-blocking work.
  */}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  {isHome && (
    <>
      {/* Hero image origin — preconnected because the LCP image lives here */}
      <link rel="preconnect" href="https://fileflex.com" crossorigin />
      {/* YT iframe only loads on click — dns-prefetch is enough, preconnect would hold an unused socket */}
      <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
      {/* Analytics is async + non-blocking → dns-prefetch is enough */}
      <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
      <link rel="dns-prefetch" href="https://www.google-analytics.com" />
      {/* Preload the hero background image (LCP) so it's discoverable in the initial HTML */}
      <link rel="preload" as="image" href="https://fileflex.com/wp-content/uploads/2015/03/iStock-1445140730-scaled.jpg.webp" fetchpriority="high" />
      {/* Preload the hero logo so it paints with the first frame */}
      <link rel="preload" as="image" href="https://fileflex.com/wp-content/uploads/2015/03/fileflex-enterprise-logo-small.png.webp" fetchpriority="high" />
    </>
  )}
  {/*
    Fonts: load async to avoid blocking the critical render path.
    - Trimmed to the 3 families actually used in CSS (Syne, DM Sans, Inter).
    - Dropped Roboto and Montserrat (unused) — eliminates ~16 font file requests.
    - rel="preload" with media-swap pattern: browser fetches the CSS at high
      priority but does not block rendering on it. font-display:swap (in the
      Google CSS) then paints text in a fallback while the webfont arrives.
  */}
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500;600;700&family=Inter:ital,wght@0,400..700;1,400..700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500;600;700&family=Inter:ital,wght@0,400..700;1,400..700&display=swap"
    />
  </noscript>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />
</head>
<body>
  <slot />
</body>
</html>
