---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "FileFlex Enterprise applies Zero Trust Data Access to unstructured data wherever it resides — without migration or VPN." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="shortcut icon" type="image/x-icon" href="https://fileflex.com/wp-content/uploads/2015/03/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,700&family=Montserrat:wght@200;300;400;600&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is FileFlex and how does it secure unstructured data?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "FileFlex is a Zero Trust Data Access platform that provides secure, policy-driven access to unstructured data across on-premises, cloud, and hybrid storage without moving or copying the data. It enforces least-privilege access and records all activity for audit and compliance."
        }
      },
      {
        "@type": "Question",
        "name": "How does FileFlex enforce Zero Trust principles?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "FileFlex enforces Zero Trust by authenticating each request, evaluating access against centrally defined policies, and ensuring only authorized users receive access based on context and permissions. Storage systems remain dark unless explicitly accessed through FileFlex policy workflows."
        }
      },
      {
        "@type": "Question",
        "name": "Can FileFlex help reduce ransomware and data exfiltration risk?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. FileFlex\u2019s Zero Trust model limits open access to file shares and network drives, reducing the attack surface. Its detailed activity logs and ability to detect unusual access or extraction patterns can help identify ransomware behavior during data exfiltration, enabling faster detection and response."
        }
      },
      {
        "@type": "Question",
        "name": "Does FileFlex work with existing enterprise systems like Active Directory and cloud storage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. FileFlex integrates with enterprise identity providers such as Active Directory and Azure AD for authentication and policy enforcement. It federates access to existing on-premises and cloud file systems, SharePoint, and NAS without requiring changes to your infrastructure."
        }
      }
    ]
  })} />
</head>
<body>
  <slot />
</body>
</html>
