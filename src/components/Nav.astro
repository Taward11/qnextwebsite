---
const { current } = Astro.props as { current?: string };
const isPlatform = current === 'platform';
const isSecurity = current === 'security';
---
<nav id="ff-nav" aria-label="Main navigation">
  <input type="checkbox" id="ff-nav-toggle" class="ff-nav__toggle" aria-label="Toggle navigation" />
  <div class="ff-nav__inner">
    <a href="/" class="ff-nav__logo" aria-label="FileFlex Enterprise home">
      <img src="https://fileflex.com/wp-content/uploads/2015/03/fileflex-enterprise-logo-small.png.webp" alt="FileFlex Enterprise" loading="eager" fetchpriority="high" decoding="async" />
    </a>
    <div class="ff-nav__divider" aria-hidden="true"></div>
    <span class="ff-nav__tagline">The Genius of Zero Trust Data Access™</span>
    <ul class="ff-nav__links">
      <li><a href="https://fileflex.com/the-challenge/">The Challenge</a></li>
      <li><a href="/platform" aria-current={isPlatform ? 'page' : undefined}>Platform</a></li>
      <li><a href="/security" aria-current={isSecurity ? 'page' : undefined}>Security</a></li>
      <li><a href="https://fileflex.com/partner/">Partner</a></li>
      <li><a href="https://fileflex.com/contact-us/">Support</a></li>
      <li><a href="https://fileflex.com/company/blog/">Blog</a></li>
      <li><a href="https://fileflex.com/fileflex-enterprise/try-plus/" class="ff-nav__cta">Try FileFlex</a></li>
    </ul>
    <label class="ff-nav__hamburger" for="ff-nav-toggle" aria-hidden="true">&#9776;</label>
  </div>
</nav>
