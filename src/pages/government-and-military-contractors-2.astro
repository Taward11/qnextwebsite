  { title: 'GDPR-Compliant File Sharing: Secure, Legal & Easy with Zero Trust', blurb: 'GDPR-compliant file sharing means exchanging personal data in a way that meets the EU’s strict data protection rules. It requires encryption, strict […]', img: '/images/government/iStock-668751452-e1703105188127-400x300.jpg', href: 'https://fileflex.com/blog/' },
  { title: 'Regulatory Compliance in the Digital Age: Unveiling Quebec Bill 64 and How FileFlex Enterprise Can Help', blurb: 'Regulatory compliance is a key concern for organizations in the digital age, as privacy regulations like Quebec Bill 64 emerge to protect […]', img: '/images/government/iStock-906002360-2022q4-e1690562130415-400x300.jpg', href: 'https://fileflex.com/blog/' },
  { title: 'How to Meet NIST SP-800-171v2 Access Control Practices for Remote Data Access', blurb: 'The Zero Trust Data Access architecture of FileFlex Enterprise can greatly aid in compliance with NIST access control requirements as outlined in […]', img: '/images/government/iStock-502806184-e1678994380758-400x300.jpg', href: 'https://fileflex.com/blog/' },
  { title: 'How to Meet CMMC Access Control Practices for Remote Data Access', blurb: 'The Zero Trust Data Access architecture of FileFlex Enterprise can greatly aid in compliance with CMMC requirements and provides remote access and […]', img: '/images/government/iStock-1158791540-e1678995967398-400x300.jpg', href: 'https://fileflex.com/blog/' },
  { title: 'How to Meet NIST Guidelines for Zero Trust for Remote Data Access', blurb: 'The National Institute of Standards and Technology (NIST) has produced NIST Special Publication 800-207 outlining Zero Trust principles and guidelines that can […]', img: '/images/government/NIST-full-transparent-400x300.png', href: 'https://fileflex.com/blog/' },
