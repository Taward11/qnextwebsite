---

<Layout title="Government and Military Contractors — Zero Trust Windows Productivity that Aids Compliance | FileFlex" description="FileFlex Enterprise gives government and DoD contractors Zero Trust Data Access and sharing of CUI from within Windows — aiding CMMC, NIST, FedRAMP and GDPR compliance.">
<Nav />

<section id="gov-hero" aria-labelledby="gov-hero-heading">
  <div class="gov-hero__inner">
    <p class="gov-hero__eyebrow">GOVERNMENT AND MILITARY CONTRACTORS</p>
    <h1 id="gov-hero-heading" class="gov-hero__title">Zero Trust Windows Productivity That Aids Government Compliance</h1>
  </div>
</section>

<section id="fin-body" class="fin-body" aria-label="Government use cases">
  <div class="fin-body__inner">
    {rows.map((r, i) => (
      <>
        <div class="fin-block fin-row">
          <div class="fin-row__media">
            <img src={r.img} alt={r.title} loading="lazy" decoding="async" />
          </div>
          <div class="fin-row__copy">
            <h2 class="fin-h2">{r.title}</h2>
            <p class="fin-p">{r.body}</p>
          </div>
        </div>
        {i < rows.length - 1 && <hr class="fin-sep" />}
      </>
    ))}
  </div>
</section>

<section id="fin-blogs" class="fin-section fin-section--white" aria-labelledby="gov-blogs-heading">
  <div class="fin-section__inner">
    <h2 id="gov-blogs-heading" class="fin-h2 fin-h2--center">Check Out These Related Blogs</h2>
    <div class="fin-blog-grid">
      {blogs.map((b) => (
        <a class="fin-blog" href={b.href} target="_blank" rel="noopener noreferrer">
          <img class="fin-blog__img" src={b.img} alt="" loading="lazy" decoding="async" width="400" height="300" />
          <div class="fin-blog__body">
            <h3 class="fin-blog__title">{b.title}</h3>
            <p class="fin-blog__blurb">{b.blurb}</p>
            <span class="fin-blog__more">Read more →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

</Layout>
