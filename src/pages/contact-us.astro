---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';
import '../styles/platform.css';
import '../styles/partner.css';
---

<Layout
  title="Support — Contact FileFlex | FileFlex Enterprise"
  description="Need help with FileFlex? Contact the FileFlex support team, download clients and connectors, or visit the Help Center and FAQ."
>

<Nav current="support" />

<!-- ============================================================
     HERO
     ============================================================ -->
<section id="ptr-hero" class="cu-hero" aria-labelledby="cu-hero-heading">
  <div class="ptr-hero__inner">
    <h1 id="cu-hero-heading" class="ptr-hero__title">Support</h1>
    <p class="ptr-hero__lede">
      Need help with FileFlex? Our support team, downloads, knowledge base and FAQs are all here.
    </p>
  </div>
</section>

<!-- ============================================================
     CONTACT — two columns: icon boxes + email contact
     ============================================================ -->
<section id="cu-main" class="pf-section pf-section--white" aria-label="Contact information">
  <div class="pf-section__inner">
    <div class="cu-grid">
      <!-- LEFT: 4 icon-boxes -->
      <div class="cu-boxes">
        <article class="cu-box">
          <div class="cu-box__icon cu-box__icon--outline" aria-hidden="true"><i class="fa fa-question"></i></div>
          <div class="cu-box__body">
            <h2 class="cu-box__title">Help</h2>
            <p><a href="https://help.fileflex.com/display/FcH" target="_blank" rel="noopener">Click here for Help</a></p>
          </div>
        </article>

        <article class="cu-box">
          <div class="cu-box__icon" aria-hidden="true"><i class="fa fa-download"></i></div>
          <div class="cu-box__body">
            <h2 class="cu-box__title">Client and Connector Downloads</h2>
            <p><a href="/support/downloads/">FileFlex Client and Connector Downloads</a></p>
          </div>
        </article>

        <article class="cu-box">
          <div class="cu-box__icon" aria-hidden="true"><i class="fa fa-home"></i></div>
          <div class="cu-box__body">
            <h2 class="cu-box__title">Address</h2>
            <p>
              200 E. Grayson Street, Suite 210<br />
              San Antonio TX 78215
            </p>
          </div>
        </article>

        <article class="cu-box">
          <div class="cu-box__icon" aria-hidden="true"><i class="fa fa-envelope"></i></div>
          <div class="cu-box__body">
            <h2 class="cu-box__title">Email</h2>
            <p><a href="mailto:support@fileflex.com">support@fileflex.com</a></p>
          </div>
        </article>
      </div>

      <!-- RIGHT: Contact Us card -->
      <aside class="cu-card" aria-labelledby="cu-contact-heading">
        <h2 id="cu-contact-heading" class="cu-card__title">Contact Us</h2>
        <p class="cu-card__copy">
          Please email support issues directly to
          <a href="mailto:support@fileflex.com">support@fileflex.com</a>.
        </p>
        <a class="ptr-btn ptr-btn--orange" href="mailto:support@fileflex.com">
          <span>Email Support</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Hero override for contact page */
  #ptr-hero.cu-hero {
    background: #0b1224 url('/images/support/iStock-1135951621-web.jpg') center/cover no-repeat;
    min-height: 420px;
    padding: 100px 6vw 80px;
  }

  /* Two-column grid */
  .cu-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .cu-grid { grid-template-columns: 1fr; gap: 36px; }
  }

  /* Icon boxes */
  .cu-boxes {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .cu-box {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .cu-box__icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fff;
    color: #e8590a;
    border: 2px solid #e8590a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cu-box__icon i { font-size: 26px; line-height: 1; }
  .cu-box__title {
    font-weight: 700;
    font-size: 20px;
    color: #0E1A2B;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .cu-box__body p {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    color: #51606F;
    line-height: 1.55;
    margin: 0;
  }
  .cu-box__body a {
    color: #1c398e;
    text-decoration: none;
    font-weight: 600;
  }
  .cu-box__body a:hover { color: #e8590a; text-decoration: underline; }

  /* Contact card */
  .cu-card {
    background: #f0f1f3;
    border-radius: 8px;
    padding: 40px 36px;
    border-top: 4px solid #e8590a;
  }
  .cu-card__title {
    font-weight: 700;
    font-size: clamp(23px, 2.4vw, 30px);
    color: #0E1A2B;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .cu-card__copy {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    color: #51606F;
    line-height: 1.6;
    margin: 0 0 24px;
  }
  .cu-card__copy a {
    color: #1c398e;
    font-weight: 600;
    text-decoration: none;
  }
  .cu-card__copy a:hover { color: #e8590a; text-decoration: underline; }
</style>

</Layout>
