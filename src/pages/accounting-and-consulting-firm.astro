---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import GranularPermissionsPanel from '../components/GranularPermissionsPanel.astro';
import '../styles/fileflex.css';
import '../styles/platform.css';
import '../styles/accounting.css';

const engagements = [
  ['Audit & Assurance', 'Provide engagement teams and authorized clients controlled access to financial statements, working documents and supporting information.', 'engagement-audit.webp'],
  ['Tax & Advisory', 'Securely access and exchange sensitive financial, tax and personally identifiable information with clients.', 'engagement-tax.webp'],
  ['Consulting Engagements', 'Give project teams controlled access to client information and working documents across the lifecycle of an engagement.', 'engagement-consulting.webp'],
  ['M&A & Due Diligence', 'Create secure virtual data rooms for transactions, due diligence and other confidential projects without moving information into another storage platform.', 'engagement-ma.webp'],
  ['External Specialists', 'Provide lawyers, accountants, contractors and other outside advisors access only to the files and folders required for their work.', 'engagement-specialists.webp'],
  ['Client Portals', 'Give clients an intuitive way to securely access and exchange documents while the firm maintains centralized control.', 'engagement-portal.webp'],
];
const benefits = [
  ['Protect Client Confidentiality', 'Apply granular controls to sensitive client information at the file and folder level.', 'shield'],
  ['Simplify External Collaboration', 'Give clients and outside participants secure access without exposing the underlying storage infrastructure.', 'users'],
  ['Keep Data in Place', 'Extend controlled access across existing repositories without migrating information into another storage platform.', 'storage'],
  ['Maintain Visibility', 'Activity logging provides visibility into access and sharing actions across FileFlex-controlled data access.', 'eye'],
  ['Support Existing Workflows', 'Give authorized users secure access to existing information without forcing the organization to replace its underlying storage infrastructure.', 'workflow'],
  ['Strengthen Zero Trust', 'Extend Zero Trust beyond identities, endpoints, applications and networks to the data itself.', 'lock'],
];
const graphic = (file: string) => `/images/accounting-consulting-updated/${file}`;
---
<Layout title="Zero Trust Data Access for Accounting & Consulting Firms | FileFlex" description="FileFlex Enterprise helps accounting and consulting firms keep client data confidential across existing storage and familiar workflows.">
  <Nav />
  <main>
    <section class="acu-hero" aria-labelledby="acu-title"><div class="acu-shell acu-hero__copy">
      <p class="acu-eyebrow acu-eyebrow--light">Accounting &amp; Consulting</p>
      <h1 id="acu-title">Protect Client Data Wherever the Work Happens</h1>
      <p>Give employees, clients and external collaborators secure, controlled access to confidential information across existing storage—without moving the data.</p>
      <p>FileFlex Enterprise extends Zero Trust to the data layer, giving accounting and consulting firms centralized control over who can access client information and what they can do with it.</p>
      <a class="pf-btn pf-btn--lg pf-btn--uppercase" href="/demo-request/">Request a Demo</a>
    </div></section>

    <section class="acu-section acu-section--mist"><div class="acu-shell acu-split">
      <div class="acu-copy"><p class="acu-eyebrow">Client data reality</p><h2>Client Data Is Everywhere. Access Needs to Remain Controlled.</h2><p>Accounting and consulting firms operate across clients, offices, practices, project teams and external partners. Confidential information may reside across Windows file servers, NAS, SharePoint, cloud storage, FTP and private or hybrid infrastructure.</p><p>At the same time, employees need remote access, clients need to exchange documents, and outside specialists may need temporary access to specific information.</p><p class="acu-emphasis">The challenge isn't simply sharing files. It's controlling access to client data wherever that data resides.</p></div>
      <figure class="acu-graphic"><img src={graphic('graphic-1.webp')} alt="Controlled access to distributed client data" loading="lazy" decoding="async" /></figure>
    </div></section>

    <section class="acu-section acu-section--white"><div class="acu-shell acu-split">
      <div class="acu-copy"><p class="acu-eyebrow">Every engagement</p><h2>Secure Collaboration Across Every Client Engagement</h2><p>From routine client services to highly sensitive transactions, professional-services firms need to give the right people access to the right information—without creating unnecessary copies or exposing underlying storage infrastructure.</p></div>
      <figure class="acu-graphic"><img src={graphic('visual-2.webp')} alt="Professional services collaboration" loading="lazy" decoding="async" /></figure>
    </div><div class="acu-shell acu-engagements">{engagements.map(([title, text, image]) => <article><img src={graphic(image)} alt="" loading="lazy" decoding="async" /><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></section>

    <section class="acu-section acu-section--tint"><div class="acu-shell acu-split">
      <figure class="acu-graphic"><img src={graphic('graphic-3.webp')} alt="Move governance, not data" loading="lazy" decoding="async" /></figure>
      <div class="acu-copy"><p class="acu-eyebrow">Existing storage</p><h2>Protect Client Data Without Moving It</h2><p>Traditional collaboration platforms can require organizations to upload, copy or synchronize information into another repository before it can be remotely accessed or shared externally.</p><p>FileFlex takes a different approach.</p><p class="acu-emphasis">Data stays in place.</p><p>FileFlex Enterprise provides a secure access layer across existing storage infrastructure. There is no need to migrate client information into a FileFlex repository or create another storage silo.</p><p class="acu-list">Windows File Servers • NAS • SharePoint • Cloud Storage • FTP • Private &amp; Hybrid Infrastructure</p><p>Your firm maintains its existing storage architecture while FileFlex governs access to the data.</p></div>
    </div></section>

    <GranularPermissionsPanel />

    <section class="acu-section acu-section--white"><div class="acu-shell acu-split"><div class="acu-copy"><p class="acu-eyebrow">Secure client workspaces</p><h2>Turn Existing Client Data Into Secure Virtual Data Rooms</h2><p>Client engagements, audits, transactions and due diligence frequently require firms to provide outside participants with controlled access to confidential information.</p><p>FileFlex Enterprise enables firms to create secure virtual data rooms without uploading that information into a separate VDR repository.</p><p>Authorized clients, advisors and project participants can access the information they need while the firm controls what they are permitted to do with it.</p><p class="acu-emphasis">The data stays in its existing repository. FileFlex governs access to it.</p></div><figure class="acu-graphic"><img src={graphic('graphic-4.webp')} alt="Secure client virtual data room" loading="lazy" decoding="async" /></figure></div></section>
    <section class="acu-section acu-section--tint"><div class="acu-shell acu-split"><figure class="acu-graphic"><img src={graphic('graphic-5.webp')} alt="How client data access works" loading="lazy" decoding="async" /></figure><div class="acu-copy"><p class="acu-eyebrow">Policy enforced</p><h2>How Secure Client Data Access Works</h2><p>FileFlex Enterprise separates users from the underlying storage infrastructure. Users request information through FileFlex, access policies are evaluated, and only authorized data is retrieved.</p></div></div></section>
    <section class="acu-section acu-section--white"><div class="acu-shell acu-split"><div class="acu-copy"><p class="acu-eyebrow">Governance at scale</p><h2>Centralized Governance. Distributed Client Engagements.</h2><p>Large accounting and consulting organizations often operate across multiple practices, offices, business units and client teams.</p><p>Corporate IT needs centralized governance and visibility, while authorized administrators need the flexibility to manage access for their own users, clients and engagements.</p><p>FileFlex Enterprise supports both.</p><p>Corporate IT can establish centralized policies and maintain visibility across the organization, while access can be administered closer to the individual practice, office or engagement.</p></div><figure class="acu-graphic"><img src={graphic('graphic-6.webp')} alt="Centralized governance and distributed engagements" loading="lazy" decoding="async" /></figure></div></section>
    <section class="acu-section acu-section--tint"><div class="acu-shell acu-split"><figure class="acu-graphic"><img src={graphic('graphic-7.webp')} alt="Complete Zero Trust at the data layer" loading="lazy" decoding="async" /></figure><div class="acu-copy"><p class="acu-eyebrow">The data layer</p><h2>Extend Zero Trust to Client Data</h2><p>Accounting and consulting firms have invested in identity, MFA, endpoint security and secure network access.</p><p>But verifying identity and securing a connection do not by themselves determine which individual files an authorized user should be permitted to access—or what that user should be permitted to do with them.</p><p class="acu-emphasis">FileFlex Enterprise extends Zero Trust to the data layer.</p></div></div></section>

    <section class="acu-section acu-section--mist"><div class="acu-shell"><div class="acu-center"><p class="acu-eyebrow">Professional services</p><h2>Zero Trust Data Access for Professional Services</h2></div><div class="acu-benefits">{benefits.map(([title, text, icon]) => <article><svg viewBox="0 0 48 48" aria-hidden="true"><use href={`/images/accounting-consulting-updated/icons.svg#${icon}`}></use></svg><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
    <section class="acu-final"><div class="acu-final__veil"></div><div class="acu-shell acu-final__content"><p class="acu-eyebrow acu-eyebrow--light">FileFlex Enterprise</p><h2>Protect Client Data Without Changing Where It Lives</h2><p>Your clients trust you with some of their most sensitive information.</p><p>FileFlex Enterprise helps accounting and consulting firms protect that trust by extending Zero Trust directly to the data at the center of every client engagement.</p><p class="acu-final__line">Control access. Simplify collaboration. Keep data in place.</p><a class="pf-btn pf-btn--lg pf-btn--uppercase" href="/demo-request/">Request an Accounting &amp; Consulting Demo</a></div></section>
  </main>
</Layout>