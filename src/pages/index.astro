---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Qnext Corp — SEO & AI Search for Enterprise">

<a href="#main-content" class="sr-only">Skip to main content</a>

<!-- NAV -->
<nav aria-label="Main navigation">
  <a href="/" class="nav-logo" aria-label="Qnext Corp home">Qnext<span>.</span></a>
  <ul class="nav-links" id="nav-links">
    <li><a href="#opportunity">Why Now</a></li>
    <li><a href="#services">Services</a></li>
    <li><a href="#process">Process</a></li>
    <li><a href="#proof">Results</a></li>
    <li><a href="#contact" class="nav-cta" aria-label="Get in contact with Qnext Corp">Get in Touch</a></li>
  </ul>
  <button class="hamburger" id="hamburger" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle navigation">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- HERO -->
<main id="main-content">
<section id="hero" aria-labelledby="hero-heading">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-eyebrow" aria-label="Enterprise SEO and AI Search Agency">Enterprise SEO &amp; AI Search Agency</div>
    <h1 id="hero-heading">
      Be found where<br />
      your buyers <em>actually</em><br />
      search today.
    </h1>
    <p class="hero-sub">
      Traditional SEO isn't enough anymore. Your Fortune 500 competitors are already optimizing for ChatGPT, Perplexity, and Google AI Overviews. Qnext Corp makes sure you're there first.
    </p>
    <div class="hero-actions">
      <a href="#contact" class="btn-primary">Get a Strategy Brief</a>
      <a href="#services" class="btn-ghost">See Our Services</a>
    </div>
    <div class="hero-trust">
      <span class="hero-trust-label">Trusted by enterprise teams at</span>
      <div class="trust-logos" aria-label="Client industries">
        <span class="trust-logo">Financial Services</span>
        <span class="trust-logo">Healthcare</span>
        <span class="trust-logo">Technology</span>
        <span class="trust-logo">Manufacturing</span>
        <span class="trust-logo">Retail</span>
      </div>
    </div>
  </div>
</section>

<!-- OPPORTUNITY -->
<section id="opportunity" aria-labelledby="opp-heading">
  <div class="opp-grid">
    <div>
      <p class="section-label">The Shift Has Happened</p>
      <h2 id="opp-heading">Search changed.<br /><em>Most enterprises haven't.</em></h2>
      <p class="section-sub">
        Over half of all searches now end without a click. AI answers are displacing traditional results. The companies winning attention are those built for both — and the window to act is closing.
      </p>
      <a href="#contact" class="btn-primary">Talk to a Strategist</a>
    </div>
    <div class="opp-stats fade-up" aria-label="Key industry statistics">
      <div class="opp-stat">
        <div class="opp-stat-num">62%</div>
        <div class="opp-stat-label">of enterprise search queries now trigger an AI Overview before organic results</div>
      </div>
      <div class="opp-stat">
        <div class="opp-stat-num">3.4×</div>
        <div class="opp-stat-label">higher pipeline conversion for brands appearing in AI-generated answers</div>
      </div>
      <div class="opp-stat">
        <div class="opp-stat-num">58%</div>
        <div class="opp-stat-label">of B2B buyers use AI chat tools before ever contacting a vendor</div>
      </div>
      <div class="opp-stat">
        <div class="opp-stat-num">90</div>
        <div class="opp-stat-label">days — typical time to establish AI search authority in a new vertical</div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services" aria-labelledby="services-heading">
  <p class="section-label">What We Do</p>
  <h2 id="services-heading">Full-spectrum visibility.<br /><em>Every surface. Every engine.</em></h2>
  <p class="section-sub">We combine deep technical SEO with forward-looking AI search strategy — so your brand dominates both what is and what's coming.</p>

  <div class="services-grid fade-up">
    <article class="service-card">
      <div class="service-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
      <h3>Technical SEO at Scale</h3>
      <p>Enterprise-grade crawl optimization, Core Web Vitals, structured data architecture, and international SEO for complex, multi-domain environments.</p>
    </article>
    <article class="service-card">
      <div class="service-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v6l4 2"/><path d="M18 2v4h4"/></svg>
      </div>
      <h3>AI Search Optimization</h3>
      <p>Position your brand as the authoritative source cited in ChatGPT, Perplexity, Gemini, and Google AI Overviews — where buyer intent is highest.</p>
    </article>
    <article class="service-card">
      <div class="service-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
      </div>
      <h3>Content Strategy &amp; Authority</h3>
      <p>Topical authority mapping, expert-driven content programs, and entity optimization that signals expertise to both algorithms and AI models.</p>
    </article>
    <article class="service-card">
      <div class="service-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <h3>Competitive Intelligence</h3>
      <p>Real-time visibility tracking across traditional SERP and AI surfaces. Know exactly where you stand and where your competitors are gaining ground.</p>
    </article>
    <article class="service-card">
      <div class="service-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      </div>
      <h3>Digital PR &amp; Link Acquisition</h3>
      <p>High-authority link building and digital PR campaigns that strengthen domain authority and amplify your brand's trustworthiness signals at scale.</p>
    </article>
    <article class="service-card">
      <div class="service-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <h3>Executive Advisory</h3>
      <p>Dedicated senior strategists embedded with your marketing leadership. Quarterly roadmaps, board-ready reporting, and direct access when it matters.</p>
    </article>
  </div>
</section>

<!-- PROCESS -->
<section id="process" aria-labelledby="process-heading">
  <p class="section-label">How We Work</p>
  <h2 id="process-heading">From audit to <em>authority</em> in 90 days.</h2>
  <p class="section-sub">A proven enterprise onboarding track that moves fast without cutting corners.</p>
  <div class="process-steps fade-up">
    <div class="process-step">
      <div class="step-num">01</div>
      <h3>Discovery &amp; Audit</h3>
      <p>We map your current technical health, content gaps, competitive landscape, and AI search presence across every major platform.</p>
    </div>
    <div class="process-step">
      <div class="step-num">02</div>
      <h3>Strategy &amp; Roadmap</h3>
      <p>A prioritized 90-day roadmap aligned with your revenue targets — no vanity metrics, only initiatives that move pipeline.</p>
    </div>
    <div class="process-step">
      <div class="step-num">03</div>
      <h3>Execution</h3>
      <p>Our team deploys in parallel streams: technical fixes, content production, link acquisition, and AI optimization simultaneously.</p>
    </div>
    <div class="process-step">
      <div class="step-num">04</div>
      <h3>Measure &amp; Scale</h3>
      <p>Monthly reporting tied to business outcomes. We identify what's compounding and double down — then expand to new channels and markets.</p>
    </div>
  </div>
</section>

<!-- PROOF -->
<section id="proof" aria-labelledby="proof-heading">
  <p class="section-label">Client Results</p>
  <h2 id="proof-heading">The kind of outcomes<br /><em>CFOs notice.</em></h2>
  <p class="section-sub">Real results from enterprise engagements. Details anonymized at client request.</p>

  <div class="proof-grid fade-up">
    <article class="proof-card">
      <p class="proof-quote">Qnext didn't just improve our rankings — they repositioned our entire brand in the AI search ecosystem. Within six months we were the cited source in ChatGPT responses for our core category.</p>
      <div class="proof-author">
        <div class="proof-avatar" aria-hidden="true">CM</div>
        <div>
          <p class="proof-name">Chief Marketing Officer</p>
          <p class="proof-title">Global Financial Services Firm</p>
        </div>
      </div>
    </article>
    <article class="proof-card">
      <p class="proof-quote">The technical depth is unlike any agency we've worked with. They fixed issues our internal team had flagged for years — and the impact on organic revenue was immediate and measurable.</p>
      <div class="proof-author">
        <div class="proof-avatar" aria-hidden="true">VP</div>
        <div>
          <p class="proof-name">VP of Digital Growth</p>
          <p class="proof-title">Fortune 200 Healthcare System</p>
        </div>
      </div>
    </article>
    <article class="proof-card">
      <p class="proof-quote">Board-ready reporting, proactive strategy, and a team that genuinely understands enterprise complexity. Qnext operates like an extension of our in-house team — not a vendor.</p>
      <div class="proof-author">
        <div class="proof-avatar" aria-hidden="true">DG</div>
        <div>
          <p class="proof-name">Director of Growth</p>
          <p class="proof-title">Enterprise SaaS, Series D</p>
        </div>
      </div>
    </article>
  </div>

  <div class="result-banner fade-up" style="margin-top:1.5rem;" aria-label="Aggregate client results">
    <div class="result-item">
      <span class="result-num">+340%</span>
      <span class="result-label">Average organic traffic growth</span>
    </div>
    <div class="result-divider" aria-hidden="true"></div>
    <div class="result-item">
      <span class="result-num">6.2×</span>
      <span class="result-label">Average ROI on engagement</span>
    </div>
    <div class="result-divider" aria-hidden="true"></div>
    <div class="result-item">
      <span class="result-num">87%</span>
      <span class="result-label">Clients achieve AI citation within 90 days</span>
    </div>
    <div class="result-divider" aria-hidden="true"></div>
    <div class="result-item">
      <span class="result-num">48hr</span>
      <span class="result-label">Average response time for senior strategy</span>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" aria-labelledby="contact-heading">
  <div class="contact-wrap">
    <div class="contact-left">
      <p class="section-label">Let's Talk</p>
      <h2 id="contact-heading">Ready to lead<br /><em>your category</em>?</h2>
      <p class="section-sub">Tell us about your business and we'll respond within one business day with a tailored assessment.</p>
      <ul class="contact-features" aria-label="What to expect">
        <li>
          <div class="cf-check" aria-hidden="true"><svg viewBox="0 0 12 12"><polyline points="2 6 5 9 10 3"/></svg></div>
          <span>Senior strategist assigned — not an account coordinator</span>
        </li>
        <li>
          <div class="cf-check" aria-hidden="true"><svg viewBox="0 0 12 12"><polyline points="2 6 5 9 10 3"/></svg></div>
          <span>Preliminary AI search audit included with first meeting</span>
        </li>
        <li>
          <div class="cf-check" aria-hidden="true"><svg viewBox="0 0 12 12"><polyline points="2 6 5 9 10 3"/></svg></div>
          <span>Strict NDA available before any information is shared</span>
        </li>
        <li>
          <div class="cf-check" aria-hidden="true"><svg viewBox="0 0 12 12"><polyline points="2 6 5 9 10 3"/></svg></div>
          <span>No long-term commitment required for initial engagement</span>
        </li>
      </ul>
    </div>
    <div>
      <form class="contact-form" action="#" method="post" aria-labelledby="contact-heading" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="first-name">First Name</label>
            <input type="text" id="first-name" name="first_name" placeholder="Jane" required autocomplete="given-name" />
          </div>
          <div class="form-group">
            <label for="last-name">Last Name</label>
            <input type="text" id="last-name" name="last_name" placeholder="Smith" required autocomplete="family-name" />
          </div>
        </div>
        <div class="form-group">
          <label for="email">Work Email</label>
          <input type="email" id="email" name="email" placeholder="jane@company.com" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" placeholder="Acme Corporation" autocomplete="organization" />
        </div>
        <div class="form-group">
          <label for="role">Your Role</label>
          <select id="role" name="role">
            <option value="" disabled selected>Select your role</option>
            <option>C-Suite / Executive</option>
            <option>VP / Director</option>
            <option>Head of Marketing / SEO</option>
            <option>Digital / Growth Lead</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">What are you trying to solve?</label>
          <textarea id="message" name="message" placeholder="Tell us about your current SEO challenges, goals, or what prompted you to reach out..."></textarea>
        </div>
        <button type="submit" class="form-submit">Send My Brief &rarr;</button>
        <p class="form-note">No spam. No unsolicited follow-up calls. We respond within 1 business day.</p>
      </form>
    </div>
  </div>
</section>
</main>

<!-- FOOTER -->
<footer>
  <a href="/" class="footer-logo" aria-label="Qnext Corp home">Qnext<span>.</span>Corp</a>
  <p>&copy; 2025 Qnext Corp. All rights reserved.</p>
  <nav aria-label="Footer navigation">
    <ul class="footer-links">
      <li><a href="#services">Services</a></li>
      <li><a href="#process">Process</a></li>
      <li><a href="#proof">Results</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>
</footer>

</Layout>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');
  hamburger.addEventListener('click', () => {
    const open = navLinks.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', open);
  });
  navLinks.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      navLinks.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
    });
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
  }, { threshold: 0.12 });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const target = document.querySelector(a.getAttribute('href'));
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
  });

  document.querySelector('.contact-form').addEventListener('submit', e => {
    e.preventDefault();
    const btn = e.target.querySelector('.form-submit');
    btn.textContent = 'Message Sent \u2713';
    btn.style.background = '#00b89a';
    btn.disabled = true;
  });
</script>
