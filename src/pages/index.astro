      <img src="https://fileflex.com/wp-content/uploads/2015/03/fileflex-enterprise-logo-small.png.webp" alt="FileFlex Enterprise" loading="eager" fetchpriority="high" decoding="async" />
    </a>
    <div class="ff-nav__divider" aria-hidden="true"></div>
    <span class="ff-nav__tagline">The Genius of Zero Trust Data Access™</span>
    <ul class="ff-nav__links">
      <li><a href="https://fileflex.com/the-challenge/">The Challenge</a></li>
