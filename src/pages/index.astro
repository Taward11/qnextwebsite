---
import Layout from '../layouts/Layout.astro';
import '../styles/fileflex.css';
---

<Layout
  title="FileFlex Enterprise - Securing the Data Layer of Zero Trust"
  description="FileFlex Enterprise applies Zero Trust Data Access to unstructured data wherever it resides — without migration or VPN."
>

<!-- ============================================================
     NAVIGATION
     ============================================================ -->
<nav id="ff-nav" aria-label="Main navigation">
