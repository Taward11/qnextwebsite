---
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostBody from '../../components/PostBody.astro';
import { getAllPosts, formatDate, slugify } from '../../lib/blog';
import { getAuthor } from '../../lib/authors';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// TOC from H2s only
const h2s = headings.filter((h) => h.depth === 2);
const showToc = post.data.toc && h2s.length > 1;

// Render the post body to an HTML string so we can split on `<!-- table:ID -->`
// markers and inject our <PostTable> component in place of each marker.
const container = await AstroContainer.create();
const contentHtml = await container.renderToString(Content);

// Fail-safe: if any declared table has no marker in the body, append it
// at the end so the table still appears in the rendered post.
const usedIds = new Set<string>();
const markerRe = /<!--\s*table:([\w-]+)\s*-->/g;
let m: RegExpExecArray | null;
while ((m = markerRe.exec(contentHtml))) usedIds.add(m[1]);
const trailingTables = post.data.tables.filter((t) => !usedIds.has(t.id));

const author = getAuthor(post.data.author);
const url = new URL(`/blog/${post.slug}/`, Astro.site ?? Astro.url.origin).toString();
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(url);
const imgAbs = post.data.featuredImage
  ? new URL(post.data.featuredImage, Astro.site ?? Astro.url.origin).toString()
  : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description ?? post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.modified ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  image: imgAbs,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

const faqSchema = post.data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const tableSchemas = post.data.tables.map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'Table',
  about: t.caption ?? post.data.title,
}));
---

<BlogLayout title={post.data.seoTitle ?? `${post.data.title} | FileFlex Blog`} description={post.data.description ?? post.data.excerpt}>

  <article class="blog-post">

    {post.data.featuredImage && (
      <img class={`blog-post__hero${post.data.heroSize === 'small' ? ' blog-post__hero--small' : ''}`} src={post.data.featuredImage} alt={post.data.featuredImageAlt ?? ''} loading="eager" fetchpriority="high" decoding="async" />
    )}

    <h1 class="blog-post__title">{post.data.title}</h1>

    {post.data.readingTime && (
      <p class="blog-post__reading-time">
        <svg class="blog-post__reading-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
        </svg>
        <span>Estimated reading time: {post.data.readingTime}</span>
      </p>
    )}

    {post.data.excerpt && (
      <p class="blog-post__summary"><em>{post.data.excerpt}</em></p>
    )}

    {showToc && (
      <nav class="blog-post__toc" aria-label="Table of contents">
        <h2 class="blog-post__toc-title">Table of Contents</h2>
        <ol>
          {h2s.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    <PostBody html={contentHtml} tables={post.data.tables} />

    {trailingTables.length > 0 && (
      <div class="blog-post__trailing-tables">
        {trailingTables.map((t) => (
          <PostBody html={`<!-- table:${t.id} -->`} tables={[t]} />
        ))}
      </div>
    )}

    {post.data.faq.length > 0 && (
      <section class="blog-post__faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently Asked Questions</h2>
        <dl>
          {post.data.faq.map((f) => (
            <>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </>
          ))}
        </dl>
      </section>
    )}

    <div class="blog-post__ctas" role="group" aria-label="Calls to action">
      <a class="blog-post__cta blog-post__cta--primary" href="/">Learn More About FileFlex</a>
      <a class="blog-post__cta blog-post__cta--secondary" href="https://fileflex.com/fileflex-enterprise/try-plus/">Sign Up for a Free Trial</a>
    </div>

    <footer class="blog-post__footer">

      <div class="blog-post__byline">
        <p class="blog-post__byline-meta">
          Published <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </p>
        <ul class="blog-post__cats" aria-label="Categories">
          {post.data.categories.map((c) => (
            <li><a href={`/blog/category/${slugify(c)}/`}>{c}</a></li>
          ))}
        </ul>
        {post.data.tags.length > 0 && (
          <ul class="blog-post__tags" aria-label="Tags">
            {post.data.tags.map((t) => (
              <li><a href={`/blog/tag/${slugify(t)}/`}>#{t}</a></li>
            ))}
          </ul>
        )}
      </div>

      <div class="blog-post__share" aria-label="Share this post">
        <span class="blog-post__share-label">Share:</span>
        <a class="blog-post__share-btn" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} target="_blank" rel="noopener" aria-label="Share on X (Twitter)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a class="blog-post__share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.452 20.452h-3.554v-5.569c0-1.328-.026-3.037-1.85-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.358V9h3.414v1.561h.046c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.265 2.37 4.265 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.554V9h3.565v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a class="blog-post__share-btn" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.412c0-3.017 1.792-4.683 4.533-4.683 1.313 0 2.686.235 2.686.235v2.965h-1.514c-1.49 0-1.955.93-1.955 1.886v2.262h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
        </a>
        <a class="blog-post__share-btn" href={`mailto:?subject=${shareTitle}&body=${shareUrl}`} aria-label="Share by email">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M1.5 4.5h21A1.5 1.5 0 0 1 24 6v12a1.5 1.5 0 0 1-1.5 1.5h-21A1.5 1.5 0 0 1 0 18V6a1.5 1.5 0 0 1 1.5-1.5zm.75 2.78v10.47h19.5V7.28L12 13.5z"/></svg>
        </a>
        <a class="blog-post__share-btn" href={`https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${shareTitle}`} target="_blank" rel="noopener" aria-label="Copy link" title={url}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3.9 12a4 4 0 0 1 4-4h3v2h-3a2 2 0 0 0 0 4h3v2h-3a4 4 0 0 1-4-4zm6 1h6v-2H9.9zm6.1-5h-3v2h3a2 2 0 0 1 0 4h-3v2h3a4 4 0 0 0 0-8z"/></svg>
        </a>
      </div>

      <div class="blog-post__author-card">
        <img class="blog-post__author-img" src={author.image} alt={`${author.name} avatar`} loading="lazy" decoding="async" />
        <div class="blog-post__author-body">
          <p class="blog-post__author-label">About the Author</p>
          <p class="blog-post__author-name">{author.name}</p>
          <p class="blog-post__author-bio">{author.bio}</p>
        </div>
      </div>

    </footer>

  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {tableSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

</BlogLayout>
