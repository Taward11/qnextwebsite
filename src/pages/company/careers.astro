---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import '../../styles/fileflex.css';
import '../../styles/platform.css';
import '../../styles/partner.css';

const values = [
  {
    icon: 'fa-solid fa-shield-halved',
    title: 'Security-First Thinking',
    body: 'We build software trusted to protect the most sensitive data in healthcare, defense, finance, and government. Everyone on the team carries that responsibility.',
  },
  {
    icon: 'fa-solid fa-lightbulb',
    title: 'Curiosity Over Comfort',
    body: 'Zero Trust Data Access is an evolving field. We hire people who ask better questions and are not afraid to challenge how things have always been done.',
  },
  {
    icon: 'fa-solid fa-users',
    title: 'Small Team, Outsized Impact',
    body: 'We are intentionally lean. Every contributor sees their work shipped to enterprise customers and shapes the direction of the platform.',
  },
  {
    icon: 'fa-solid fa-globe',
    title: 'Remote-Friendly, Globally Connected',
    body: 'Headquartered in San Antonio, Texas with team members and partners across North America, Europe, and Asia. We work where the talent is.',
  },
];

const interestAreas = [
  'Software Engineering (Java, C++, Mobile)',
  'Security & Cryptography',
  'DevOps & Cloud Infrastructure',
  'Product Management',
  'Enterprise Sales & Channel',
  'Customer Success & Solutions Engineering',
];
---

<Layout icons
  title="Careers - Qnext"
  description="Careers at Qnext Corp — join the team building FileFlex Enterprise, the Zero Trust Data Access platform trusted by regulated enterprises worldwide."
>

<Nav current="" />

<!-- ============================================================
     HERO
     ============================================================ -->
<section id="ptr-hero" class="cr-hero" aria-labelledby="cr-hero-heading">
  <div class="cr-hero__inner">
    <h1 id="cr-hero-heading" class="cr-hero__title">Careers at Qnext</h1>
    <p class="cr-hero__sub">Help build the Zero Trust Data Access platform trusted by hospitals, banks, governments, and Fortune 500 enterprises.</p>
  </div>
</section>

<!-- ============================================================
     INTRO + CURRENT STATUS
     ============================================================ -->
<section class="pf-section pf-section--white cr-intro" aria-labelledby="cr-intro">
  <div class="cr-intro__inner">
    <div class="cr-intro__copy">
      <h2 id="cr-intro" class="cr-intro__title">Work on what matters</h2>
      <p>At Qnext, we build <strong>FileFlex Enterprise</strong> &mdash; the platform that lets organizations share, access, and govern unstructured data across on-premises, hybrid, and multi-cloud storage without ever moving the data into the cloud.</p>
      <p>Our customers operate under the most demanding compliance regimes in the world: <a href="/hipaa-compliance/">HIPAA</a>, <a href="/gdpr-compliance/">GDPR</a>, CMMC, NIST SP-800-171, GLBA, DORA. The code we ship has to be worthy of that trust every day.</p>
      <p>If that sounds like the kind of work you want to do, we&rsquo;d like to hear from you &mdash; even when we&rsquo;re not actively hiring.</p>
    </div>
    <aside class="cr-status" aria-labelledby="cr-status-heading">
      <span class="cr-status__badge">Current Openings</span>
      <h3 id="cr-status-heading" class="cr-status__title">No open positions right now.</h3>
      <p class="cr-status__body">
        We&rsquo;re not actively recruiting today, but we&rsquo;re always interested in connecting with exceptional engineers, security specialists, and enterprise go-to-market talent for future roles.
      </p>
      <p class="cr-status__body">
        Send your r&eacute;sum&eacute; and a short note to <a href="mailto:careers@qnext.com">careers@qnext.com</a> and we&rsquo;ll reach out when a role opens that fits.
      </p>
    </aside>
  </div>
</section>

<!-- ============================================================
     VALUES
     ============================================================ -->
<section class="pf-section pf-section--white cr-values" aria-labelledby="cr-values-heading">
  <div class="cr-values__inner">
    <h2 id="cr-values-heading" class="cr-values__title">What we look for</h2>
    <div class="cr-values__grid">
      {values.map((v) => (
        <article class="cr-value">
          <span class="cr-value__icon" aria-hidden="true"><i class={v.icon}></i></span>
          <h3 class="cr-value__title">{v.title}</h3>
          <p class="cr-value__body">{v.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================
     AREAS OF INTEREST + CTA
     ============================================================ -->
<section class="pf-section pf-section--white cr-areas" aria-labelledby="cr-areas-heading">
  <div class="cr-areas__inner">
    <div class="cr-areas__copy">
      <h2 id="cr-areas-heading" class="cr-areas__title">Areas we hire for</h2>
      <p>When openings appear, they typically fall in one of these areas. Let us know which fits you best.</p>
      <ul class="cr-areas__list">
        {interestAreas.map((a) => (
          <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>{a}</span></li>
        ))}
      </ul>
    </div>
    <aside class="cr-cta" aria-labelledby="cr-cta-heading">
      <h3 id="cr-cta-heading" class="cr-cta__title">Introduce yourself</h3>
      <p class="cr-cta__body">Email <a href="mailto:careers@qnext.com">careers@qnext.com</a> with:</p>
      <ul class="cr-cta__list">
        <li>Your r&eacute;sum&eacute; or LinkedIn profile</li>
        <li>The area you&rsquo;re interested in</li>
        <li>A few sentences on what you&rsquo;d want to work on</li>
      </ul>
      <a class="cr-cta__btn" href="mailto:careers@qnext.com?subject=Future%20Opportunities%20at%20Qnext">
        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
        <span>Send Us Your R&eacute;sum&eacute;</span>
      </a>
    </aside>
  </div>
</section>

<style>
  /* ===== HERO ===== */
  #ptr-hero.cr-hero {
    background: #294063 url('/images/company/hero-bg.jpg') center/cover no-repeat;
    padding: 110px 6vw 100px;
    position: relative;
    text-align: left;
  }
  #ptr-hero.cr-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(14,26,43,0.85) 0%, rgba(14,26,43,0.6) 60%, rgba(14,26,43,0.4) 100%);
    pointer-events: none;
  }
  .cr-hero__inner {
    position: relative; z-index: 1;
    max-width: 1100px; margin: 0 auto;
  }
  .cr-hero__title {
    color: #fff;
    font-size: clamp(34px, 4.4vw, 56px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    line-height: 1.1;
  }
  .cr-hero__sub {
    color: #e6ebf2;
    font-size: clamp(15px, 1.5vw, 18px);
    max-width: 720px;
    line-height: 1.55;
    margin: 0;
  }

  /* ===== INTRO + STATUS ===== */
  .pf-section.cr-intro { background: #fff; padding: 70px 6vw 40px; }
  .cr-intro__inner {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 7fr 5fr;
    gap: 60px; align-items: start;
  }
  .cr-intro__title {
    color: #0E1A2B;
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
  }
  .cr-intro__copy p {
    color: #2a2f3a;
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .cr-intro__copy p:last-child { margin-bottom: 0; }
  .cr-intro__copy a {
    color: #e8590a;
    text-decoration: none;
    font-weight: 600;
  }
  .cr-intro__copy a:hover { text-decoration: underline; }

  .cr-status {
    background: #f6f7f9;
    border-left: 4px solid #e8590a;
    padding: 26px 28px;
    border-radius: 4px;
  }
  .cr-status__badge {
    display: inline-block;
    background: #0E1A2B;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 3px;
    margin-bottom: 14px;
  }
  .cr-status__title {
    color: #0E1A2B;
    font-size: 20px;
    font-weight: 800;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }
  .cr-status__body {
    color: #2a2f3a;
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 12px;
  }
  .cr-status__body:last-child { margin-bottom: 0; }
  .cr-status a {
    color: #e8590a;
    text-decoration: none;
    font-weight: 600;
  }
  .cr-status a:hover { text-decoration: underline; }

  @media (max-width: 820px) {
    .cr-intro__inner { grid-template-columns: 1fr; gap: 30px; }
  }

  /* ===== VALUES ===== */
  .pf-section.cr-values {
    background: #fff;
    padding: 40px 6vw 60px;
  }
  .cr-values__inner { max-width: 1100px; margin: 0 auto; }
  .cr-values__title {
    color: #0E1A2B;
    font-size: clamp(24px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 30px;
  }
  .cr-values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .cr-value {
    border: 1px solid #ececec;
    border-radius: 6px;
    padding: 26px 22px;
    background: #fff;
    transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .cr-value:hover {
    border-color: #e8590a;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(14,26,43,0.08);
  }
  .cr-value__icon {
    display: inline-flex;
    align-items: center; justify-content: center;
    width: 48px; height: 48px;
    border-radius: 8px;
    background: #f6f7f9;
    color: #e8590a;
    font-size: 22px;
    margin-bottom: 16px;
  }
  .cr-value__title {
    color: #0E1A2B;
    font-size: 16px;
    font-weight: 800;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .cr-value__body {
    color: #4a5160;
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 980px) { .cr-values__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .cr-values__grid { grid-template-columns: 1fr; } }

  /* ===== AREAS + CTA ===== */
  .pf-section.cr-areas {
    background: #f6f7f9;
    padding: 60px 6vw 90px;
  }
  .cr-areas__inner {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 7fr 5fr;
    gap: 50px; align-items: start;
  }
  .cr-areas__title {
    color: #0E1A2B;
    font-size: clamp(24px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  .cr-areas__copy > p {
    color: #2a2f3a;
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0 0 20px;
  }
  .cr-areas__list {
    list-style: none;
    padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
  }
  .cr-areas__list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #0E1A2B;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.45;
  }
  .cr-areas__list i {
    color: #e8590a;
    font-size: 16px;
    margin-top: 2px;
  }

  .cr-cta {
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 6px;
    padding: 28px;
  }
  .cr-cta__title {
    color: #0E1A2B;
    font-size: 20px;
    font-weight: 800;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .cr-cta__body {
    color: #2a2f3a;
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .cr-cta__body a {
    color: #e8590a;
    text-decoration: none;
    font-weight: 600;
  }
  .cr-cta__body a:hover { text-decoration: underline; }
  .cr-cta__list {
    list-style: disc;
    padding-left: 20px;
    margin: 0 0 22px;
    color: #2a2f3a;
    font-size: 14px;
    line-height: 1.7;
  }
  .cr-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #e8590a;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.02em;
    padding: 12px 20px;
    border-radius: 4px;
    transition: background .15s ease, transform .15s ease;
  }
  .cr-cta__btn:hover {
    background: #d04e08;
    transform: translateY(-1px);
  }

  @media (max-width: 820px) {
    .cr-areas__inner { grid-template-columns: 1fr; gap: 30px; }
    .cr-areas__list { grid-template-columns: 1fr; }
  }
</style>

</Layout>
