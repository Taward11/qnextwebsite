---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import '../../styles/fileflex.css';
import '../../styles/platform.css';
import '../../styles/partner.css';

const channels = [
  {
    icon: 'fa-brands fa-x-twitter',
    label: 'FOLLOW QNEXT CORPORATE ANNOUNCEMENTS VIA X',
    href: 'https://x.com/fileflex_',
  },
  {
    icon: 'fa-brands fa-facebook-square',
    label: 'FOLLOW QNEXT NEWS ON FACEBOOK',
    href: 'https://www.facebook.com/fileflexenterprise',
  },
  {
    icon: 'fa-brands fa-youtube-square',
    label: 'WATCH OUR CORPORATE AND PRODUCT VIDEOS ON YOUTUBE',
    href: 'https://www.youtube.com/channel/UC4IZccCXCrkznADmg4NFz-w',
  },
  {
    icon: 'fa-brands fa-linkedin',
    label: 'FOLLOW QNEXT VIA LINKEDIN',
    href: 'https://www.linkedin.com/company/147271/',
  },
];
---

<Layout icons
  title="Media Relations - Qnext"
  description="Qnext Media Relations — press inquiries, interview requests, and official channels for FileFlex announcements."
>

<Nav current="" />

<!-- ============================================================
     HERO
     ============================================================ -->
<section id="ptr-hero" class="mr-hero" aria-labelledby="mr-hero-heading">
  <div class="mr-hero__inner">
    <h1 id="mr-hero-heading" class="mr-hero__title">Media Relations</h1>
  </div>
</section>

<!-- ============================================================
     CONTACT + INTRO
     ============================================================ -->
<section class="pf-section pf-section--white mr-intro" aria-labelledby="mr-intro">
  <div class="mr-intro__inner">
    <div class="mr-intro__copy">
      <h2 id="mr-intro" class="mr-intro__title">Media Relations</h2>
      <p>The Qnext Media Relations team speaks on behalf of FileFlex as well as Qnext &amp; its products.</p>
      <p>The unit addresses journalists&rsquo; requests for information about FileFlex and handles media requests for interviews with Qnext executives.</p>
      <p>Media Relations is responsible for press releases and statements about Qnext and its products and is the primary point of contact for media queries.</p>
    </div>
    <aside class="mr-contact" aria-labelledby="mr-contact-heading">
      <h3 id="mr-contact-heading" class="mr-contact__title">Contact Information</h3>
      <p class="mr-contact__body">
        Thomas Ward<br />
        VP<br />
        +1.905.761.5275<br />
        Email: <a href="mailto:mediarelations@qnext.com">mediarelations@qnext.com</a><br />
        Please include &ldquo;Attention Media Relations&rdquo; or &ldquo;Interview Request&rdquo; in the subject line.
      </p>
    </aside>
  </div>
</section>

<!-- ============================================================
     SOCIAL CHANNELS
     ============================================================ -->
<section class="pf-section pf-section--white mr-channels" aria-label="Follow Qnext">
  <div class="mr-channels__inner">
    {channels.map((c) => (
      <a class="mr-channel" href={c.href} target="_blank" rel="noopener">
        <span class="mr-channel__icon" aria-hidden="true">
          <i class={c.icon}></i>
        </span>
        <span class="mr-channel__label">{c.label}</span>
      </a>
    ))}
  </div>
</section>

<style>
  /* ===== HERO ===== */
  #ptr-hero.mr-hero {
    background: #294063 url('/images/company/hero-bg.jpg') center/cover no-repeat;
    padding: 110px 6vw 100px;
    position: relative;
    text-align: left;
  }
  #ptr-hero.mr-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(14,26,43,0.82) 0%, rgba(14,26,43,0.55) 60%, rgba(14,26,43,0.35) 100%);
    pointer-events: none;
  }
  .mr-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }
  .mr-hero__title {
    color: #fff;
    font-size: clamp(34px, 4.4vw, 56px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.1;
  }

  /* ===== INTRO + CONTACT ===== */
  .pf-section.mr-intro {
    background: #fff;
    padding: 70px 6vw 40px;
  }
  .mr-intro__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 60px;
    align-items: start;
  }
  .mr-intro__title {
    color: #0E1A2B;
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
  }
  .mr-intro__copy p {
    color: #2a2f3a;
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .mr-intro__copy p:last-child { margin-bottom: 0; }

  .mr-contact {
    background: #f6f7f9;
    border-left: 4px solid #e8590a;
    padding: 26px 28px;
    border-radius: 4px;
  }
  .mr-contact__title {
    color: #0E1A2B;
    font-size: 20px;
    font-weight: 800;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }
  .mr-contact__body {
    color: #2a2f3a;
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
  }
  .mr-contact a {
    color: #e8590a;
    text-decoration: none;
    font-weight: 600;
  }
  .mr-contact a:hover { text-decoration: underline; }

  @media (max-width: 820px) {
    .mr-intro__inner { grid-template-columns: 1fr; gap: 30px; }
  }

  /* ===== SOCIAL CHANNELS ===== */
  .pf-section.mr-channels {
    background: #fff;
    padding: 30px 6vw 90px;
  }
  .mr-channels__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .mr-channel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 24px 22px;
    border: 1px solid #ececec;
    border-radius: 6px;
    text-decoration: none;
    background: #fff;
    transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .mr-channel:hover {
    border-color: #e8590a;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(14,26,43,0.08);
  }
  .mr-channel__icon {
    width: 56px; height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #f6f7f9;
    color: #0E1A2B;
    font-size: 26px;
  }
  .mr-channel:hover .mr-channel__icon {
    background: #e8590a;
    color: #fff;
  }
  .mr-channel__label {
    color: #0E1A2B;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .mr-channel:hover .mr-channel__label { color: #e8590a; }

  @media (max-width: 980px) {
    .mr-channels__inner { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .mr-channels__inner { grid-template-columns: 1fr; }
  }
</style>

</Layout>
