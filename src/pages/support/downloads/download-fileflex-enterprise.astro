---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import '../../../styles/fileflex.css';
import '../../../styles/platform.css';
import '../../../styles/partner.css';
---

<Layout
  title="Download FileFlex Enterprise | Clients and Connectors"
  description="Download FileFlex Enterprise clients and connectors — Windows, Mac, Linux desktop, Android & iOS mobile, server and NAS connectors (Synology, QNAP, NETGEAR, ASUSTOR, Western Digital)."
>

<Nav current="support" />

<!-- ============================================================
     HERO
     ============================================================ -->
<section id="ptr-hero" class="dle-hero" aria-labelledby="dle-hero-heading">
  <div class="ptr-hero__inner dle-hero__inner">
    <h1 id="dle-hero-heading" class="ptr-hero__title">Download FileFlex Enterprise</h1>
    <p class="ptr-hero__sub">Clients and connectors for your devices, servers and NAS</p>
  </div>
</section>

<!-- ============================================================
     CTA BAR — Try FileFlex Enterprise
     ============================================================ -->
<section class="pf-section pf-section--white dle-try" aria-label="Try FileFlex Enterprise">
  <div class="pf-section__inner dle-try__inner">
    <h2 class="dle-try__title">Looking to try FileFlex Enterprise in your organization?</h2>
    <a class="dle-pill" href="/fileflex-enterprise/try-plus/">Try FileFlex Enterprise</a>
  </div>
</section>

<!-- ============================================================
     DESKTOP CLIENTS
     ============================================================ -->
<section class="pf-section pf-section--white dle-row" aria-labelledby="dle-desktop">
  <div class="pf-section__inner dle-row__inner">
    <div class="dle-row__heading">
      <h2 id="dle-desktop" class="dle-row__title">Desktop Clients</h2>
    </div>
    <div class="dle-grid dle-grid--4">
      <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/windows/FileFlexEnterprise_Prod_x86_64_Latest.exe">
        <span class="dle-tile__text">
          <span class="dle-tile__name">Windows Client</span>
          <span class="dle-tile__desc">FileFlex application for a Windows PC</span>
        </span>
        <span class="dle-icon" aria-hidden="true"><i class="fas fa-desktop"></i></span>
      </a>
      <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/mac/FileFlexEnterprise_Prod_x86_64_Latest.dmg">
        <span class="dle-tile__text">
          <span class="dle-tile__name">Mac Client</span>
          <span class="dle-tile__desc">FileFlex application for an Apple PC</span>
        </span>
        <span class="dle-icon" aria-hidden="true"><i class="fab fa-apple"></i></span>
      </a>
      <a class="dle-tile" href="https://fileflex.com/downloads/installing-linux/" target="_blank" rel="noopener">
        <span class="dle-tile__text">
          <span class="dle-tile__name">Linux Client</span>
          <span class="dle-tile__desc">FileFlex application for a Linux PC</span>
        </span>
        <span class="dle-icon" aria-hidden="true"><i class="fab fa-linux"></i></span>
      </a>
      <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/windows/FileFlexWinIntEnterprise_Prod_x86_64_Latest.exe">
        <span class="dle-tile__text">
          <span class="dle-tile__name">Windows Integrated Client</span>
          <span class="dle-tile__desc">Integrates FileFlex into Windows Explorer</span>
        </span>
        <span class="dle-icon" aria-hidden="true"><i class="fab fa-windows"></i></span>
      </a>
    </div>
  </div>
</section>

<div class="dle-sep" role="presentation"></div>

<!-- ============================================================
     MOBILE CLIENTS
     ============================================================ -->
<section class="pf-section pf-section--white dle-row" aria-labelledby="dle-mobile">
  <div class="pf-section__inner dle-row__inner">
    <div class="dle-row__heading">
      <h2 id="dle-mobile" class="dle-row__title">Mobile Clients</h2>
    </div>
    <div class="dle-badges">
      <a href="https://play.google.com/store/apps/details?id=com.qnext.ent" target="_blank" rel="noopener" class="dle-badge">
        <img src="/images/badges/google-play-badge.jpg" alt="Get it on Google Play" width="196" height="58" />
      </a>
      <a href="https://itunes.apple.com/ca/app/id1206876451" target="_blank" rel="noopener" class="dle-badge">
        <img src="/images/badges/ios_app.jpg" alt="Download on the App Store" width="188" height="58" />
      </a>
    </div>
  </div>
</section>

<div class="dle-sep" role="presentation"></div>

<!-- ============================================================
     SERVER CONNECTORS
     ============================================================ -->
<section class="pf-section pf-section--white dle-row" aria-labelledby="dle-server">
  <div class="pf-section__inner dle-row__inner">
    <div class="dle-row__heading">
      <h2 id="dle-server" class="dle-row__title">Server Connectors</h2>
    </div>
    <div class="dle-grid dle-grid--4">
      <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/windows/FileFlexServer_Prod_x86_64_Latest.exe">
        <span class="dle-tile__name">Windows</span>
        <span class="dle-icon" aria-hidden="true"><i class="fab fa-windows"></i></span>
      </a>
      <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/mac/FileFlexEnterprise_Prod_x86_64_Latest.dmg">
        <span class="dle-tile__name">Mac</span>
        <span class="dle-icon" aria-hidden="true"><i class="fab fa-apple"></i></span>
      </a>
      <a class="dle-tile" href="https://fileflex.com/downloads/installing-linux/" target="_blank" rel="noopener">
        <span class="dle-tile__name">Linux</span>
        <span class="dle-icon" aria-hidden="true"><i class="fab fa-linux"></i></span>
      </a>
      <span class="dle-tile dle-tile--empty" aria-hidden="true"></span>
    </div>
  </div>
</section>

<div class="dle-sep" role="presentation"></div>

<!-- ============================================================
     NAS CONNECTORS
     ============================================================ -->
<section class="pf-section pf-section--white dle-row" aria-labelledby="dle-nas">
  <div class="pf-section__inner dle-row__inner">
    <div class="dle-row__heading">
      <h2 id="dle-nas" class="dle-row__title">NAS<br/>Connectors</h2>
    </div>
    <div class="dle-grid dle-grid--5">
      <div class="dle-nas">
        <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/synology/">
          <span class="dle-tile__name">Synology</span>
          <span class="dle-icon" aria-hidden="true"><i class="fas fa-globe"></i></span>
        </a>
        <a class="dle-help" href="https://help.fileflex.com/pages/viewpage.action?pageId=49874282" target="_blank" rel="noopener">Help</a>
      </div>
      <div class="dle-nas">
        <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/qnap/">
          <span class="dle-tile__name">QNAP</span>
          <span class="dle-icon" aria-hidden="true"><i class="fas fa-globe"></i></span>
        </a>
        <a class="dle-help" href="https://help.fileflex.com/pages/viewpage.action?pageId=49874270" target="_blank" rel="noopener">Help</a>
      </div>
      <div class="dle-nas">
        <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/netgear/">
          <span class="dle-tile__name">NETGEAR</span>
          <span class="dle-icon" aria-hidden="true"><i class="fas fa-globe"></i></span>
        </a>
        <a class="dle-help" href="https://help.fileflex.com/pages/viewpage.action?pageId=49874275" target="_blank" rel="noopener">Help</a>
      </div>
      <div class="dle-nas">
        <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/asustor/">
          <span class="dle-tile__name">ASUSTOR</span>
          <span class="dle-icon" aria-hidden="true"><i class="fas fa-globe"></i></span>
        </a>
        <a class="dle-help" href="https://help.fileflex.com/pages/viewpage.action?pageId=49874265" target="_blank" rel="noopener">Help</a>
      </div>
      <div class="dle-nas">
        <a class="dle-tile" href="https://downloads.fileflex.com/downloads/passive/wd/">
          <span class="dle-tile__name">Western Digital</span>
          <span class="dle-icon" aria-hidden="true"><i class="fas fa-globe"></i></span>
        </a>
        <a class="dle-help" href="https://help.fileflex.com/fch/en/connecting-to-yourcontent/how-to-connect-to-a-western-digital-mycloud-nas" target="_blank" rel="noopener">Help</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero — reuses support hero image; dark overlay for legibility */
  #ptr-hero.dle-hero {
    background:
      linear-gradient(rgba(11, 18, 36, 0.55), rgba(11, 18, 36, 0.55)),
      url('/images/support/iStock-1135951621-web.jpg') center/cover no-repeat;
    min-height: 340px;
    padding: 90px 6vw 60px;
    text-align: left;
  }
  .dle-hero__inner { max-width: 1100px; margin: 0 auto; }
  #ptr-hero.dle-hero .ptr-hero__title { text-align: left; }
  .ptr-hero__sub {
    color: #fff;
    font-size: clamp(16px, 1.4vw, 19px);
    opacity: 0.92;
    margin: 12px 0 0;
    max-width: 720px;
  }

  /* Try CTA */
  .dle-try__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    padding: 8px 0;
  }
  .dle-try__title {
    font-size: clamp(20px, 2vw, 26px);
    color: #0E1A2B;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .dle-pill {
    display: inline-block;
    background: #e8590a;
    color: #fff;
    padding: 12px 28px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    transition: background 160ms ease;
    white-space: nowrap;
  }
  .dle-pill:hover { background: #c54a05; color: #fff; }

  /* Row layout: heading column on left, items on right */
  .dle-row__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    align-items: start;
  }
  .dle-row__title {
    font-size: clamp(22px, 2.2vw, 28px);
    color: #0E1A2B;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  @media (max-width: 768px) {
    .dle-row__inner { grid-template-columns: 1fr; gap: 24px; }
    .dle-row__title { text-align: center; }
  }

  .dle-grid {
    display: grid;
    gap: 28px;
  }
  .dle-grid--4 { grid-template-columns: repeat(4, 1fr); }
  .dle-grid--5 { grid-template-columns: repeat(5, 1fr); }
  @media (max-width: 900px) {
    .dle-grid--4, .dle-grid--5 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .dle-grid--4, .dle-grid--5 { grid-template-columns: 1fr; }
  }

  /* Tile */
  .dle-tile {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: #0E1A2B;
    gap: 14px;
    padding: 16px 8px;
    border-radius: 8px;
    transition: transform 160ms ease;
  }
  .dle-tile:hover { transform: translateY(-3px); }
  .dle-tile:hover .dle-tile__name { color: #e8590a; }
  .dle-tile--empty { pointer-events: none; }

  /* Fixed-height text block so all icons align across the row,
     regardless of name/desc wrapping (e.g. Windows Integrated). */
  .dle-tile__text {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    min-height: 72px;
    gap: 4px;
  }
  .dle-tile__name {
    display: block;
    font-weight: 700;
    font-size: 15px;
    color: #e8590a;
    line-height: 1.3;
  }
  .dle-tile__desc {
    display: block;
    font-size: 13px;
    color: #4a5260;
    line-height: 1.4;
  }

  .dle-icon {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: #fff;
    color: #e8590a;
    border: 2px solid #e8590a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .dle-icon i { font-size: 36px; line-height: 1; }

  /* Mobile badges */
  .dle-badges {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .dle-badge { display: inline-block; line-height: 0; }
  .dle-badge img { display: block; max-width: 100%; height: auto; }

  /* NAS column */
  .dle-nas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .dle-help {
    color: #e8590a;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  .dle-help:hover { text-decoration: underline; }

  /* Separator */
  .dle-sep {
    max-width: 1100px;
    height: 1px;
    background: #dbdbdb;
    margin: 0 auto;
  }

  /* Tighten row vertical rhythm */
  .pf-section.dle-row { padding: 50px 6vw; }
  .pf-section.dle-try { padding: 56px 6vw; }
</style>

</Layout>
