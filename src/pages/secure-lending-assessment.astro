---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';
import '../styles/lending-assessment.css';

// Lead capture + report delivery is handled server-side by the Cloudflare Pages
// Function at functions/api/send-assessment.js (Resend). No API keys live here.
//
// Bot protection (Cloudflare Turnstile). The site key is public by design (it ships in
// the page HTML), so it's embedded as the default; override via PUBLIC_TURNSTILE_SITE_KEY
// build env var if needed. Server enforcement is separate: it only kicks in once
// TURNSTILE_SECRET is set in the Cloudflare Function env (the secret NEVER lives in code).
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAAepoW6FVjST6ttz';

// ---- Assessment configuration ------------------------------------------------
// Each question: id, text, optional note, and options [label, points].
const SECTIONS = [
  {
    id: 's1',
    short: 'Lending Processes',
    title: 'Lending Collaboration Processes',
    max: 15,
    benchmark: 62,
    questions: [
      { id: 'q1', text: 'How are borrower documents typically exchanged?', multi: true, options: [['Primarily email attachments', 0], ['Mix of email and shared folders', 2], ['Secure portal used for some processes', 4], ['Secure collaboration platform used consistently', 5]] },
      { id: 'q2', text: 'How many external parties typically participate in lending transactions?', note: 'Helps qualify transaction complexity.', options: [['0–1', 5], ['2–3', 4], ['4–6', 3], ['More than 6', 2]] },
      { id: 'q3', text: 'Can external participants access documents without receiving email attachments?', options: [['No', 0], ['Sometimes', 2], ['Usually', 4], ['Always', 5]] },
    ],
  },
  {
    id: 's2',
    short: 'Access Controls',
    title: 'Access Controls',
    max: 20,
    benchmark: 58,
    questions: [
      { id: 'q4', text: 'How is access granted to lending documents?', multi: true, options: [['Shared folders with broad permissions', 0], ['Group-based permissions', 2], ['Role-based permissions', 4], ['Granular document-level permissions', 5]] },
      { id: 'q5', text: 'Can access be revoked immediately when no longer required?', options: [['No', 0], ['Manually with significant effort', 2], ['Usually', 4], ['Immediately and consistently', 5]] },
      { id: 'q6', text: 'Are external parties restricted to only the documents they need?', options: [['Rarely', 0], ['Sometimes', 2], ['Usually', 4], ['Always', 5]] },
      { id: 'q7', text: 'Are temporary access periods automatically enforced?', options: [['No', 0], ['Rarely', 1], ['Sometimes', 3], ['Consistently', 5]] },
    ],
  },
  {
    id: 's3',
    short: 'Auditability',
    title: 'Visibility and Auditability',
    max: 20,
    benchmark: 64,
    questions: [
      { id: 'q8', text: 'Can you identify who accessed a document?', options: [['No', 0], ['For some systems', 2], ['Usually', 4], ['Always', 5]] },
      { id: 'q9', text: 'Can you determine when a document was accessed?', options: [['No', 0], ['Limited visibility', 2], ['Most activity', 4], ['Complete visibility', 5]] },
      { id: 'q10', text: 'Can you determine whether documents were downloaded?', options: [['No', 0], ['Some visibility', 2], ['Most cases', 4], ['Complete visibility', 5]] },
      { id: 'q11', text: 'Can audit reports be generated easily?', options: [['No', 0], ['Manual effort required', 2], ['Moderate effort', 4], ['Automated reporting', 5]] },
    ],
  },
  {
    id: 's4',
    short: 'Data Protection',
    title: 'Data Protection',
    max: 20,
    benchmark: 47,
    questions: [
      { id: 'q12', text: 'How many copies of borrower documents typically exist during a loan process?', options: [['Many uncontrolled copies', 0], ['Several copies', 2], ['Limited copies', 4], ['Minimal duplication', 5]] },
      { id: 'q13', text: 'Can users access documents without downloading them?', options: [['No', 0], ['Limited scenarios', 2], ['Most scenarios', 4], ['Consistently', 5]] },
      { id: 'q14', text: 'Can external parties share documents with your institution through a secure process?', options: [['No', 0], ['Limited capabilities', 2], ['Most use cases supported', 4], ['Fully supported', 5]] },
      { id: 'q15', text: 'Does sensitive borrower information remain under organizational control throughout the process?', options: [['Rarely', 0], ['Sometimes', 2], ['Usually', 4], ['Consistently', 5]] },
    ],
  },
  {
    id: 's5',
    short: 'Zero Trust Readiness',
    title: 'Zero Trust Readiness',
    max: 20,
    benchmark: 55,
    questions: [
      { id: 'q16', text: 'Do you currently use Multi-Factor Authentication (MFA)?', options: [['No', 0], ['Partial deployment', 2], ['Broad deployment', 4], ['Universal deployment', 5]] },
      { id: 'q17', text: 'Do you currently use Conditional Access policies?', options: [['No', 0], ['Limited deployment', 2], ['Moderate deployment', 4], ['Extensive deployment', 5]] },
      { id: 'q18', text: "How would you describe your organization's Zero Trust maturity?", options: [['Not started', 0], ['Early stages', 2], ['Developing', 3], ['Mature', 4], ['Advanced', 5]] },
      { id: 'q19', text: 'Does your Zero Trust strategy explicitly address data access and collaboration?', options: [['No', 0], ['Under consideration', 2], ['Partially implemented', 4], ['Fully implemented', 5]] },
    ],
  },
  {
    id: 's6',
    short: 'Business Impact',
    title: 'Business Impact',
    max: 10,
    benchmark: 52,
    questions: [
      { id: 'q20', text: 'How often do document-sharing issues delay loan processing?', options: [['Frequently', 0], ['Occasionally', 2], ['Rarely', 4], ['Never', 5]] },
      { id: 'q21', text: 'How confident are you that current lending collaboration processes support both compliance and operational efficiency?', options: [['Not confident', 0], ['Somewhat confident', 2], ['Confident', 4], ['Very confident', 5]] },
    ],
  },
];

// Per-category narrative (assessment + opportunity/strength) by band, plus
// recommended actions used in the improvement roadmap.
const CATEGORY_META = {
  s1: {
    actions: [
      { title: 'Eliminate email-based document exchange', detail: 'Stop using email attachments and consumer apps to move borrower documents, and route every exchange through a single secure channel instead. Email leaves uncontrollable copies in inboxes you cannot monitor or revoke, so removing it from the workflow directly closes one of the largest sources of lending data exposure and version confusion.' },
      { title: 'Adopt a consistent secure collaboration platform', detail: 'Standardize the entire lending team — and your external participants — on one secure collaboration platform rather than a patchwork of tools. Consistency means access, auditability, and data-protection controls apply uniformly to every transaction instead of varying by whoever set up the share, which both lowers risk and speeds processing.' },
      { title: 'Enable external access without attachments', detail: 'Give borrowers, processors, and attorneys a way to view and exchange documents through secure, permissioned access rather than receiving copies as attachments. This keeps the institution in control of the file at all times, so access can be limited and revoked and sensitive data never leaves your environment in the first place.' },
    ],
    bands: {
      strong: { assessment: 'Your organization relies on secure collaboration for most of the lending workflow, with limited dependence on manual document exchange.', note: 'You are well positioned to scale secure lending collaboration.', detail: 'Because most borrower documents already move through a controlled platform rather than email or consumer apps, sensitive financial information spends little time in uncontrolled inboxes or on personal devices. This reduces your attack surface, shortens loan cycle times, and gives you a defensible position with examiners. The remaining opportunity is to bring the last manual workflows — and any holdout external parties — onto the same secure channel.', type: 'strength' },
      moderate: { assessment: 'Your organization has reduced dependence on manual document exchange and has implemented secure collaboration practices for portions of the lending workflow.', note: 'Further reducing email-based document sharing may improve both security and operational efficiency.', detail: 'Parts of your lending workflow still rely on email attachments or ad-hoc file sharing, which means borrower tax returns, pay stubs, and account statements periodically leave your control and land in inboxes you cannot monitor or revoke. Each of those exchanges is a potential disclosure event and a gap in your audit trail, and it slows processing whenever participants hunt for the latest version. Consolidating every exchange onto one secure platform closes that exposure and speeds the workflow.', type: 'opportunity' },
      weak: { assessment: 'Borrower documents are still exchanged largely through email and ad-hoc methods, increasing exposure and slowing the workflow.', note: 'Introducing a secure collaboration platform can reduce risk and accelerate loan processing.', detail: 'Borrower documents are exchanged largely through email and other ad-hoc methods, so highly sensitive financial information routinely leaves your control the moment it is sent — copied to personal devices, forwarded beyond the intended recipient, and impossible to recall. This creates continuous disclosure and compliance risk, leaves no reliable record of who received what, and causes frequent processing delays from version confusion. Replacing email-based exchange with a secure platform is the single highest-impact step you can take.', type: 'opportunity' },
    },
  },
  s2: {
    actions: [
      { title: 'Implement granular, document-level permissions', detail: 'Move from broad folder- or group-level sharing to least-privilege permissions set at the individual document level, so each participant sees only what their role in the transaction requires. This shrinks the blast radius of any compromised or stale account and gives you defensible evidence that access was appropriately limited.' },
      { title: 'Automate access expiration', detail: 'Configure access to expire automatically when a transaction stage completes or a set period elapses, rather than relying on staff to remember to revoke it. Standing, never-removed access is a primary cause of data exposure; time-bounding it ensures borrower files stop being reachable the moment there is no longer a business reason for access.' },
      { title: 'Improve external user governance', detail: 'Put clear controls around how external parties are verified, granted access, monitored, and removed, including tracking exactly what each outside participant can reach. External users are the hardest to track and the easiest to over-provision, so governing them tightly removes one of the most common and overlooked sources of lending data leakage.' },
    ],
    bands: {
      strong: { assessment: 'Granular, least-privilege permissions govern most access, with timely revocation when access is no longer required.', note: 'Access governance is a competitive strength for your institution.', detail: 'Least-privilege permissions mean each borrower, processor, attorney, and staff member sees only the documents they genuinely need, and access ends the moment it is no longer required. This dramatically limits how much data any single compromised or departing account can reach, and it gives you clean, defensible evidence of access governance during audits and examinations.', type: 'strength' },
      moderate: { assessment: 'Basic access controls are in place; however, permissions may still be broader than necessary for some internal and external participants.', note: 'Implementing more granular controls can reduce unnecessary exposure of borrower information.', detail: 'Access today is governed mostly by group- or folder-level permissions that are often broader than any one participant actually needs, and revocation depends on someone remembering to remove access manually. That means borrower files frequently stay reachable by people who no longer have a business reason to see them, widening the blast radius of any compromised or stale account. Moving to document-level permissions with automatic expiration shrinks that exposure without adding day-to-day work.', type: 'opportunity' },
      weak: { assessment: 'Access is largely governed by broad, shared permissions that are difficult to revoke once granted.', note: 'Adopting role- and document-level permissions with automatic expiration will materially lower risk.', detail: 'Access is largely controlled through broad shared folders that are difficult to revoke once granted, so once someone is let in they often retain access indefinitely — including external parties and former staff. A single compromised credential can therefore expose a large volume of borrower information, and you have little ability to prove access was appropriately limited. Adopting role- and document-level permissions with automatic expiration is essential to bringing this risk under control.', type: 'opportunity' },
    },
  },
  s3: {
    actions: [
      { title: 'Centralize access and activity logging', detail: 'Bring document access and activity records into one place so every view, share, and download is captured in a single, consistent log. Scattered or missing logs make audits slow and incident investigations unreliable; a unified record lets you prove who accessed what and quickly scope any potential exposure.' },
      { title: 'Automate audit reporting', detail: 'Replace manual log gathering with automated, exportable audit reports you can produce on demand. This turns examiner and compliance requests from multi-day fire drills into a few clicks, and ensures the evidence you hand over is complete and consistent every time.' },
      { title: 'Track document downloads and actions', detail: 'Capture not just who opened a document but whether it was downloaded, printed, or shared onward, so you have a complete picture of how borrower data has been handled. Download and re-share events are exactly where data slips out of your control, so tracking them is essential for both early detection and breach-scope analysis.' },
    ],
    bands: {
      strong: { assessment: 'You maintain strong visibility into document access and user activity.', note: 'Your organization appears well-positioned for compliance and audit requirements.', detail: 'You can readily show who accessed each document, when, and what they did, and you can produce that evidence on demand. That turns audits and examiner requests from fire drills into routine exports, and it lets you detect unusual access before it becomes an incident.', type: 'strength' },
      moderate: { assessment: 'You have partial visibility into who accessed documents and when, but reporting still requires manual effort.', note: 'Centralizing activity logging and automating reports will strengthen audit readiness.', detail: 'You have partial visibility — you can reconstruct some access activity, but it is spread across systems and assembling a complete picture still takes manual effort. In an examination or a suspected incident, that delay matters: you may be unable to quickly prove who saw a borrower file or whether data was downloaded. Centralizing activity logging and automating reporting closes that gap and shortens your response time.', type: 'opportunity' },
      weak: { assessment: 'Visibility into document access and downloads is limited, making audits difficult and time-consuming.', note: 'Implementing complete, exportable activity logging should be a near-term priority for compliance.', detail: 'Visibility into who accessed borrower documents, when, and whether they were downloaded is limited, so audits are slow and incident investigations are largely guesswork. Without a complete, exportable record of document activity you cannot reliably demonstrate compliance to examiners or determine the scope of a potential breach. Implementing centralized, automated activity logging should be a near-term priority.', type: 'opportunity' },
    },
  },
  s4: {
    actions: [
      { title: 'Reduce document duplication', detail: 'Cut down the number of copies of each borrower document created during a loan by keeping files in a single controlled location instead of emailing and re-saving them. Every uncontrolled copy is an independent breach and compliance liability that lingers after closing, so minimizing duplication directly reduces your long-term exposure.' },
      { title: 'Limit downloads with view-only access', detail: 'Default to view-only access so participants can read and work with documents without pulling copies onto their own devices and cloud accounts. Keeping files in place under your control — rather than downloaded and scattered — removes the most common and hardest-to-track source of data breaches.' },
      { title: 'Improve external collaboration controls', detail: 'Provide a secure, controlled way for outside parties to both receive and submit documents, instead of relying on email or unmanaged uploads. Controlled two-way collaboration keeps borrower data inside your governed environment throughout the transaction, closing the gap that opens whenever files move to or from third parties.' },
    ],
    bands: {
      strong: { assessment: 'Borrower data largely stays under organizational control, with minimal duplication and downloading.', note: 'Strong data control reduces breach and compliance exposure.', detail: 'Borrower data largely stays in place under your control, with minimal copying and downloading, so there are few uncontrolled copies of sensitive files scattered across devices and cloud accounts. That sharply reduces both your breach exposure and the compliance burden of tracking where regulated data lives.', type: 'strength' },
      moderate: { assessment: 'Borrower information may still be duplicated or downloaded during portions of the lending lifecycle.', note: 'Reducing data movement and improving controlled access could significantly lower risk.', detail: 'Borrower information is still duplicated or downloaded during parts of the lending lifecycle, which means copies of sensitive files accumulate on laptops, personal cloud storage, and third-party systems beyond your visibility. Every uncontrolled copy is a separate breach and compliance liability that persists long after the loan closes. Shifting to view-only, no-download access that keeps files in place would materially reduce that footprint.', type: 'opportunity' },
      weak: { assessment: 'Borrower documents are frequently copied and downloaded, leaving sensitive data outside your control.', note: 'Adopting view-only, no-download access to files in place will dramatically reduce exposure.', detail: 'Borrower documents are frequently copied and downloaded, leaving sensitive financial data sitting outside your control on devices and systems you cannot monitor or wipe. Those scattered copies are the most common source of data breaches and the hardest to account for during an audit or a regulatory inquiry. Adopting view-only, no-download access to files in place would dramatically cut this exposure.', type: 'opportunity' },
    },
  },
  s5: {
    actions: [
      { title: 'Expand MFA toward universal coverage', detail: 'Extend multi-factor authentication to all users and access paths rather than a subset, so a stolen password alone can never unlock borrower data. MFA is the most cost-effective control against the credential theft behind most breaches, and partial coverage simply tells attackers where the unprotected doors are.' },
      { title: 'Adopt conditional access policies', detail: 'Use conditional access to evaluate context — device, location, and risk — before granting access, so logins that look risky are challenged or blocked. This moves you from "correct password equals trusted" toward continuous, risk-based verification, a core Zero Trust principle and a meaningful barrier to account takeover.' },
      { title: 'Extend Zero Trust to data and collaboration', detail: 'Carry Zero Trust beyond identity and the network all the way to the lending documents themselves by implementing FileFlex Enterprise. FileFlex Enterprise applies Zero Trust Data Access to borrower files wherever they already live, enforcing least-privilege, view-only, no-download access with instant revocation and a complete audit trail — without moving or copying your data. This closes the final gap between a strong login posture and genuinely protected borrower information, and is the highest-impact step toward optimized, secure lending collaboration.' },
    ],
    bands: {
      strong: { assessment: 'Zero Trust is broadly deployed and beginning to extend toward data and collaboration workflows.', note: 'You are positioned to lead on Zero Trust Data Access.', detail: 'Zero Trust is broadly deployed across identity and access, and you are beginning to extend those principles toward the data and collaboration layer where lending information actually lives. Carrying Zero Trust all the way to the document itself — not just the network and login — is what closes the final gap between a strong security posture and genuinely protected borrower data.', type: 'strength' },
      moderate: { assessment: 'Identity and authentication controls are well established.', note: 'Expanding Zero Trust principles directly to lending data and collaboration workflows may further strengthen security.', detail: 'Your identity and authentication controls are well established, but Zero Trust largely stops at the login and network layer and does not yet follow the data itself. That leaves a gap: once a user is authenticated, borrower documents are often broadly accessible, downloadable, and untracked. Extending Zero Trust principles directly to lending data and collaboration — for example with FileFlex Enterprise — is what turns a strong identity posture into actual protection for sensitive files.', type: 'opportunity' },
      weak: { assessment: 'Zero Trust adoption is at an early stage, with limited MFA and conditional access in place.', note: 'Establishing MFA and conditional access is the foundation for securing lending data.', detail: 'Zero Trust adoption is at an early stage, with limited MFA and conditional access, so access to borrower data depends heavily on perimeter trust and standing permissions. That model assumes anyone inside is trustworthy, which is exactly the assumption modern attacks exploit. Establishing MFA and conditional access is the foundation, and from there Zero Trust must be extended to the lending data itself.', type: 'opportunity' },
    },
  },
  s6: {
    actions: [
      { title: 'Eliminate email attachments', detail: 'Remove email attachments from the borrower document workflow entirely, replacing them with secure, permissioned access. Beyond the security benefit, this ends the version confusion and re-sending that slow loan processing, so it improves both compliance and cycle time at once.' },
      { title: 'Streamline borrower document collection', detail: 'Give borrowers a simple, secure way to submit required documents in one place rather than over scattered emails and channels. A smoother intake reduces back-and-forth, shortens time-to-close, and keeps sensitive financial data inside your controlled environment from the very first handoff.' },
      { title: 'Improve third-party collaboration', detail: 'Make it easy for processors, attorneys, and other third parties to participate through secure, auditable access instead of insecure workarounds. When the secure path is also the fastest path, staff and partners stop reverting to email — improving borrower experience, productivity, and data protection together.' },
    ],
    bands: {
      strong: { assessment: 'Collaboration processes reliably support both compliance and operational efficiency.', note: 'Efficient, compliant collaboration is a measurable business advantage.', detail: 'Your collaboration processes reliably support both compliance and day-to-day efficiency, so secure document handling is helping rather than hindering loan timelines and borrower experience. That alignment is a genuine competitive advantage — security that speeds the business instead of slowing it.', type: 'strength' },
      moderate: { assessment: 'Collaboration mostly supports operations, though occasional document-sharing friction affects loan timelines.', note: 'Streamlining secure collaboration can further improve borrower experience and efficiency.', detail: 'Collaboration mostly supports operations, but occasional document-sharing friction — chasing the right version, re-sending attachments, waiting on external parties — still adds delay to loan timelines and frustration for borrowers. Those frictions also tend to push staff back toward insecure shortcuts like email. Streamlining secure collaboration removes the delay and the temptation at the same time.', type: 'opportunity' },
      weak: { assessment: 'Document-sharing inefficiencies may be contributing to delays in loan processing.', note: 'Modernizing collaboration workflows may improve borrower experiences and operational productivity.', detail: 'Document-sharing inefficiencies are likely contributing to measurable delays in loan processing and a poorer borrower experience, and they push staff toward insecure workarounds to get deals done. Slow, friction-filled collaboration costs you both in cycle time and in risk. Modernizing these workflows improves borrower experience, productivity, and security together.', type: 'opportunity' },
    },
  },
};

const totalMax = SECTIONS.reduce((s, sec) => s + sec.max, 0);

// Data passed to the client for scoring + rendering.
const CONFIG = { sections: SECTIONS, meta: CATEGORY_META, totalMax, turnstile: !!TURNSTILE_SITE_KEY };

let qCounter = 0;
---

<Layout
  title="Secure Lending Collaboration Assessment | FileFlex Enterprise"
  description="Take the free Secure Lending Collaboration Assessment. Benchmark your lending document collaboration against peers across access control, auditability, data protection and Zero Trust readiness — and get a maturity score with a prioritized improvement roadmap."
>

<Nav />

<!-- HERO -->
<section id="sla-hero" aria-labelledby="sla-hero-heading">
  <div class="sla-hero__inner">
    <span class="sla-hero__eyebrow">Free Assessment · 5 minutes</span>
    <h1 id="sla-hero-heading" class="sla-hero__title">Secure Lending Collaboration Assessment</h1>
    <p class="sla-hero__lede">
      Measure how securely and efficiently your institution shares borrower documents across
      the lending lifecycle. Answer 21 short questions to receive your maturity score, a
      category-by-category breakdown, a peer benchmark, and a prioritized improvement roadmap.
    </p>
    <ul class="sla-hero__meta">
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Personalized maturity score
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
        Benchmark against peers
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Downloadable PDF report
      </li>
    </ul>
  </div>
</section>

<!-- MAIN -->
<section id="sla-main">
  <div class="sla-main__inner">

    <div class="sla-intro" id="sla-intro">
      <p>
        Your results appear on-screen instantly, and we email you a PDF copy of your report. We
        use your contact details only to send your results and, with your consent, to follow up
        about improving secure lending collaboration. The whole assessment takes about five minutes.
      </p>
    </div>

    <!-- FORM -->
    <form id="sla-form" class="sla-form" novalidate>

      <div class="sla-progress" aria-hidden="true">
        <div class="sla-progress__track"><div class="sla-progress__fill" id="sla-progress-fill"></div></div>
        <p class="sla-progress__label" id="sla-progress-label">0 of 21 questions answered</p>
      </div>

      <!-- Pre-survey -->
      <fieldset class="sla-section" style="border:0;padding:28px 28px 22px;">
        <div class="sla-section__head">
          <span class="sla-section__num">About you</span>
        </div>
        <h2 class="sla-section__title">Where should we send your report?</h2>
        <p class="sla-section__max">All fields required.</p>
        <div class="sla-fields">
          <div class="sla-field sla-field--full">
            <label for="sla-name">Full name <span class="sla-req" aria-hidden="true">*</span></label>
            <input id="sla-name" name="fullname" type="text" autocomplete="name" required />
          </div>
          <div class="sla-field">
            <label for="sla-title">Title <span class="sla-req" aria-hidden="true">*</span></label>
            <input id="sla-title" name="jobtitle" type="text" autocomplete="organization-title" required />
          </div>
          <div class="sla-field">
            <label for="sla-company">Company <span class="sla-req" aria-hidden="true">*</span></label>
            <input id="sla-company" name="company" type="text" autocomplete="organization" required />
          </div>
          <div class="sla-field sla-field--full">
            <label for="sla-email">Work email <span class="sla-req" aria-hidden="true">*</span></label>
            <input id="sla-email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
      </fieldset>

      <!-- Sections -->
      {SECTIONS.map((sec, si) => (
        <fieldset class="sla-section" data-section={sec.id} data-max={sec.max}>
          <div class="sla-section__head">
            <span class="sla-section__num">Section {si + 1}</span>
          </div>
          <h2 class="sla-section__title">{sec.title}</h2>
          {sec.questions.map((q) => {
            qCounter += 1;
            const n = qCounter;
            return (
              <div class="sla-q" role="group" aria-labelledby={`lbl-${q.id}`}>
                <p class="sla-q__text" id={`lbl-${q.id}`}>
                  {n}. {q.text} <span class="sla-req" aria-hidden="true">*</span>
                  {q.multi && <span class="sla-q__note">Select all that apply.</span>}
                  {q.note && <span class="sla-q__note">{q.note}</span>}
                </p>
                <div class="sla-opts">
                  {q.options.map((opt, oi) => (
                    <label class="sla-opt">
                      <input type={q.multi ? 'checkbox' : 'radio'} name={q.id} value={opt[1]} data-points={opt[1]} required={!q.multi && oi === 0} />
                      <span>{opt[0]}</span>
                    </label>
                  ))}
                </div>
              </div>
            );
          })}
        </fieldset>
      ))}

      <!-- Post-survey -->
      <fieldset class="sla-section">
        <div class="sla-section__head">
          <span class="sla-section__num">One last thing</span>
        </div>
        <h2 class="sla-section__title">Organization size</h2>
        <p class="sla-section__max">Helps us tailor recommendations.</p>
        <div class="sla-field sla-field--full">
          <label for="sla-users">How many users are managed by your IT department? <span class="sla-req" aria-hidden="true">*</span></label>
          <select id="sla-users" name="it_user_range" required>
            <option value="" selected disabled>Select a range…</option>
            <option value="1–50">1–50</option>
            <option value="51–250">51–250</option>
            <option value="251–1,000">251–1,000</option>
            <option value="1,001–5,000">1,001–5,000</option>
            <option value="5,000+">5,000+</option>
          </select>
        </div>
      </fieldset>

      <!-- consent + honeypot -->
      <div class="sla-consent">
        <label class="sla-opt" style="border:0;padding:0;background:none;">
          <input type="checkbox" id="sla-consent" name="communicationConsent" value="true" />
          <span>I agree to receive communications from fileflex.com about my results and related topics. You can unsubscribe at any time. See our <a href="https://www.qnext.com/privacy-policy/" target="_blank" rel="noopener">Privacy Policy</a>.</span>
        </label>
      </div>
      <div class="sla-honeypot" aria-hidden="true">
        <label for="sla-website-url">Leave this field blank</label>
        <input id="sla-website-url" type="text" name="website_url_confirm" tabindex="-1" autocomplete="off" />
      </div>

      {TURNSTILE_SITE_KEY && (
        <div class="sla-turnstile">
          <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" data-action="lending-assessment"></div>
        </div>
      )}

      <div class="sla-actions">
        <button type="submit" class="sla-btn" id="sla-submit">See my results</button>
      </div>
      <div class="sla-error" id="sla-error" role="alert"></div>
    </form>

    <!-- REPORT (rendered by JS) -->
    <div id="sla-report" aria-live="polite"></div>

  </div>
</section>

<script is:inline define:vars={{ CONFIG }}>
  (function () {
    var form = document.getElementById('sla-form');
    if (!form) return;
    var sections = CONFIG.sections;
    var meta = CONFIG.meta;
    var totalMax = CONFIG.totalMax;
    var errorEl = document.getElementById('sla-error');
    var fillEl = document.getElementById('sla-progress-fill');
    var labelEl = document.getElementById('sla-progress-label');
    var reportEl = document.getElementById('sla-report');
    var submitBtn = document.getElementById('sla-submit');
    var renderedAt = Date.now();

    // Preload the FileFlex logo so it is ready to embed on the PDF cover.
    var brandLogo = new Image();
    brandLogo.src = '/images/fileflex-logo.webp';

    var allQ = [];
    sections.forEach(function (s) { s.questions.forEach(function (q) { allQ.push(q.id); }); });

    function answeredCount() {
      var c = 0;
      allQ.forEach(function (id) { if (form.querySelector('input[name="' + id + '"]:checked')) c++; });
      return c;
    }
    function updateProgress() {
      var c = answeredCount();
      var pct = Math.round((c / allQ.length) * 100);
      if (fillEl) fillEl.style.width = pct + '%';
      if (labelEl) labelEl.textContent = c + ' of ' + allQ.length + ' questions answered';
    }
    form.addEventListener('change', updateProgress);
    updateProgress();

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function band(pct) { return pct >= 70 ? 'strong' : (pct >= 40 ? 'moderate' : 'weak'); }
    function rateLabel(b) { return b === 'strong' ? 'Strong' : (b === 'moderate' ? 'Moderate' : 'High Risk'); }
    function riskOf(pct) { return pct >= 70 ? 'Low Risk' : (pct >= 40 ? 'Moderate Risk' : 'High Risk'); }
    function maturity(pct) {
      if (pct >= 81) return 'Level 5 — Optimized Collaboration';
      if (pct >= 61) return 'Level 4 — Managed Collaboration';
      if (pct >= 41) return 'Level 3 — Defined Collaboration';
      if (pct >= 21) return 'Level 2 — Developing Collaboration';
      return 'Level 1 — Ad Hoc Collaboration';
    }

    // Maturity levels for the lending collaboration journey (shared by the
    // on-screen report and the PDF). Thresholds match maturity() above.
    var LV = {
      1: { name: 'Ad Hoc Collaboration', desc: 'Borrower documents are exchanged largely through email and ad-hoc methods with little central control. Access, auditability and data protection depend on manual effort, leaving sensitive lending information exposed and slowing loan processing.' },
      2: { name: 'Developing Collaboration', desc: 'Your institution has begun moving beyond email-based document exchange, with secure collaboration used for parts of the lending workflow. Foundational controls exist but coverage is inconsistent across access, auditability and data protection.' },
      3: { name: 'Defined Collaboration', desc: 'Secure collaboration practices are established across much of the lending lifecycle. Access controls and activity logging are in place, though gaps in granular permissions, data control or auditability still create avoidable risk and friction.' },
      4: { name: 'Managed Collaboration', desc: 'Borrower collaboration is governed by consistent, least-privilege controls with strong visibility into document access. Sensitive data largely stays under your control, and most lending workflows are both secure and efficient.' },
      5: { name: 'Optimized Collaboration', desc: 'Secure lending collaboration is fully optimized — granular least-privilege access, complete auditability, and minimal data duplication across the entire lending lifecycle. Zero Trust principles extend directly to your borrower documents and external collaboration.' }
    };
    var NEXT = {
      1: 'Reaching Developing Collaboration means replacing email attachments with a secure collaboration platform for your highest-risk lending workflows, and establishing basic access controls and activity logging.',
      2: 'Reaching Defined Collaboration means extending secure collaboration consistently across the lending lifecycle, with role-based access, exportable audit trails, and reduced document duplication.',
      3: 'Reaching Managed Collaboration means tightening to granular, least-privilege permissions with automatic expiration, view-only access that keeps borrower data under your control, and automated audit reporting.',
      4: 'Reaching Optimized Collaboration means extending Zero Trust Data Access across every borrower document and external party — granular permissions, instant revocation, and complete audit trails with no data movement.'
    };
    function levelOf(pct) { return pct >= 81 ? 5 : pct >= 61 ? 4 : pct >= 41 ? 3 : pct >= 21 ? 2 : 1; }

    var CHK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
    var ALERT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
    var ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>';

    function score() {
      var cats = sections.map(function (s) {
        var raw = 0;
        s.questions.forEach(function (q) {
          var sel = form.querySelectorAll('input[name="' + q.id + '"]:checked');
          if (!sel.length) return;
          if (q.multi) {
            var sum = 0;
            for (var i = 0; i < sel.length; i++) sum += Number(sel[i].getAttribute('data-points')) || 0;
            raw += Math.round(sum / sel.length);
          } else {
            raw += Number(sel[0].getAttribute('data-points')) || 0;
          }
        });
        var pct = Math.round((raw / s.max) * 100);
        return { id: s.id, short: s.short, title: s.title, raw: raw, max: s.max, pct: pct, benchmark: s.benchmark };
      });
      var totalRaw = cats.reduce(function (a, c) { return a + c.raw; }, 0);
      var overall = Math.round((totalRaw / totalMax) * 100);
      return { cats: cats, totalRaw: totalRaw, overall: overall };
    }

    function render(data) {
      var cats = data.cats;
      var overall = data.overall;
      var name = (form.querySelector('#sla-name').value || '').trim();
      var company = (form.querySelector('#sla-company').value || '').trim();

      // score header
      var html = '';
      html += '<p class="sla-report__brand">Zero Trust Lending Collaboration Assessment™</p>';
      html += '<p class="sla-report__for">Prepared for ' + esc(name || 'you') + (company ? ', ' + esc(company) : '') + '</p>';

      html += '<div class="sla-report__tools">';
      html += '<button type="button" class="sla-btn" id="sla-print">Download PDF report</button>';
      html += '<button type="button" class="sla-btn--ghost sla-btn" id="sla-retake">Retake assessment</button>';
      html += '</div>';
      html += '<p class="sla-report__status" id="sla-email-status" role="status"></p>';

      // level header
      var level = levelOf(overall);
      var pct = Math.round((level / 5) * 100);
      html += '<div class="sla-level">';
      html += '<div class="sla-level__dial" style="--pct:' + pct + '"><div class="sla-level__dial-inner"><div class="sla-level__dial-num">' + level + '<span class="sla-level__dial-of">/5</span></div><span class="sla-level__dial-word">Maturity</span></div></div>';
      html += '<div class="sla-level__meta"><p class="sla-level__eyebrow">Level ' + level + ' of 5</p><h2 class="sla-level__name">' + esc(LV[level].name) + '</h2><p class="sla-level__desc">' + esc(LV[level].desc) + '</p></div>';
      html += '</div>';

      // next milestone
      if (level < 5) {
        html += '<div class="sla-next"><p class="sla-next__eyebrow">Your next milestone</p>';
        html += '<p class="sla-next__name">Level ' + (level + 1) + ' — ' + esc(LV[level + 1].name) + '</p>';
        html += '<p>' + esc(NEXT[level]) + '</p></div>';
      }

      // category score bars
      html += '<div class="sla-card"><h3 class="sla-card__title">Your Category Scores</h3><p class="sla-card__sub">How you scored across the dimensions of secure lending collaboration. The marker shows the Credit Union peer average for each area.</p><div class="sla-bars">';
      cats.forEach(function (c) {
        var b = band(c.pct);
        var fillCls = b === 'strong' ? ' sla-bar__fill--strong' : (b === 'weak' ? ' sla-bar__fill--weak' : '');
        html += '<div class="sla-bar"><div class="sla-bar__top"><span class="sla-bar__label">' + esc(c.short) + '</span><span class="sla-bar__val">' + c.pct + '%</span></div>';
        html += '<div class="sla-bar__track"><div class="sla-bar__fill' + fillCls + '" data-w="' + c.pct + '"></div><span class="sla-bar__bench" style="left:' + c.benchmark + '%"></span></div></div>';
      });
      html += '</div><p class="sla-bars__legend"><span></span> Credit Union peer average</p></div>';

      // strengths / gaps
      var strengths = [], gaps = [];
      cats.forEach(function (c) {
        var m = meta[c.id].bands[band(c.pct)];
        if (m.type === 'strength') strengths.push(m.assessment);
        else gaps.push(m.assessment);
      });
      if (strengths.length) {
        html += '<div class="sla-card"><h3 class="sla-card__title">Your Strengths</h3><p class="sla-card__sub">What your organization is doing well today.</p><div class="sla-list sla-list--strength">';
        strengths.forEach(function (t) { html += '<div class="sla-list__item">' + CHK + '<span>' + esc(t) + '</span></div>'; });
        html += '</div></div>';
      }
      if (gaps.length) {
        html += '<div class="sla-card"><h3 class="sla-card__title">Your Gaps</h3><p class="sla-card__sub">Where lending data remains exposed and collaboration is incomplete.</p><div class="sla-list sla-list--gap">';
        gaps.forEach(function (t) { html += '<div class="sla-list__item">' + ALERT + '<span>' + esc(t) + '</span></div>'; });
        html += '</div></div>';
      }

      // recommendations — deduped actions from the 3 lowest categories
      var ranked = cats.slice().sort(function (a, b) { return a.pct - b.pct; }).slice(0, 3);
      var recs = [], seen = {};
      ranked.forEach(function (c) {
        meta[c.id].actions.forEach(function (a) { if (!seen[a.title]) { seen[a.title] = 1; recs.push(a); } });
      });
      if (recs.length) {
        html += '<div class="sla-card"><h3 class="sla-card__title">Recommended Next Steps</h3><p class="sla-card__sub">The actions that will most advance your secure lending collaboration maturity — what each recommendation is and why it matters.</p><div class="sla-list sla-list--rec">';
        recs.forEach(function (t) { html += '<div class="sla-list__item">' + ARROW + '<span><strong>' + esc(t.title) + '</strong><br>' + esc(t.detail) + '</span></div>'; });
        html += '</div></div>';
      }

      // CTA
      html += '<div class="sla-cta"><h2>See where FileFlex closes your gaps</h2><p>FileFlex Enterprise applies Zero Trust Data Access to your lending documents — least-privilege, view-only, no-download access with a complete audit trail, without moving your data. Talk to us about your priority areas above.</p><div class="sla-cta__row"><a class="sla-btn" href="/demo-request/">Request a demo</a><a class="sla-btn sla-btn--ghost" href="/secure-lending-collaboration/">Explore secure lending</a></div></div>';

      reportEl.innerHTML = html;
      reportEl.classList.add('is-show');

      // animate bars
      requestAnimationFrame(function () {
        var bars = reportEl.querySelectorAll('.sla-bar__fill');
        bars.forEach(function (el) { el.style.width = (el.getAttribute('data-w') || 0) + '%'; });
      });

      document.getElementById('sla-print').addEventListener('click', function () { if (pdfState && pdfState.save) { pdfState.save(); } else { window.print(); } });
      document.getElementById('sla-retake').addEventListener('click', function () {
        reportEl.classList.remove('is-show');
        reportEl.innerHTML = '';
        form.reset();
        updateProgress();
        submitBtn.disabled = false;
        form.style.display = '';
        document.getElementById('sla-intro').style.display = '';
        if (CONFIG.turnstile && window.turnstile) { try { window.turnstile.reset(); } catch (e) {} }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // ---- PDF generation + email delivery -----------------------------------
    var ENDPOINT = '/api/send-assessment';
    var pdfState = null; // { base64, save }
    var pdfLibs = null;

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = src; s.async = true;
        s.onload = function () { resolve(); };
        s.onerror = function () { reject(new Error('Failed to load ' + src)); };
        document.head.appendChild(s);
      });
    }
    function ensurePdfLibs() {
      if (pdfLibs) return pdfLibs;
      pdfLibs = loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js').then(function () {
        return loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js');
      });
      return pdfLibs;
    }

    function gatherContact() {
      var users = form.querySelector('#sla-users');
      return {
        name: (form.querySelector('#sla-name').value || '').trim(),
        title: (form.querySelector('#sla-title').value || '').trim(),
        company: (form.querySelector('#sla-company').value || '').trim(),
        email: (form.querySelector('#sla-email').value || '').trim(),
        users: users ? (users.value || '').trim() : '',
        consent: !!(form.querySelector('#sla-consent') && form.querySelector('#sla-consent').checked)
      };
    }
    function gatherAnswers() {
      var out = [];
      sections.forEach(function (s) {
        s.questions.forEach(function (q) {
          var sel = form.querySelectorAll('input[name="' + q.id + '"]:checked');
          var labels = [];
          var points = 0;
          for (var i = 0; i < sel.length; i++) {
            var lbl = sel[i].closest('label');
            var sp = lbl ? lbl.querySelector('span') : null;
            labels.push(sp ? sp.textContent.trim() : sel[i].value);
          }
          if (sel.length) {
            if (q.multi) {
              var sum = 0;
              for (var j = 0; j < sel.length; j++) sum += Number(sel[j].getAttribute('data-points')) || 0;
              points = Math.round(sum / sel.length);
            } else {
              points = Number(sel[0].getAttribute('data-points')) || 0;
            }
          }
          out.push({ section: s.short, question: q.text, answer: labels.join('; '), points: points });
        });
      });
      return out;
    }

    function setEmailStatus(msg, kind) {
      var el = document.getElementById('sla-email-status');
      if (!el) return;
      el.textContent = msg;
      el.className = 'sla-report__status' + (kind ? ' is-' + kind : '');
    }

    function buildPdf(data, contact) {
      var jsPDF = window.jspdf.jsPDF;
      var doc = new jsPDF({ unit: 'pt', format: 'a4' });
      var pageW = doc.internal.pageSize.getWidth();
      var pageH = doc.internal.pageSize.getHeight();
      var M = 56;
      var contentW = pageW - M * 2;
      var cx = pageW / 2;

      var ORANGE = [232, 89, 10];
      var INK = [23, 23, 26];
      var SOFT = [92, 100, 112];
      var LINE = [224, 227, 232];
      var TRACK = [234, 236, 240];
      var WASH = [250, 244, 238];
      var WHITE = [255, 255, 255];

      var today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      var year = new Date().getFullYear();

      function setColor(c) { doc.setTextColor(c[0], c[1], c[2]); }
      function fill(c) { doc.setFillColor(c[0], c[1], c[2]); }
      function brandMark(x, by, size) {
        doc.setFont('helvetica', 'bold'); doc.setFontSize(size); setColor(INK);
        doc.text('FileFlex', x, by);
        var w = doc.getTextWidth('FileFlex');
        doc.setFont('helvetica', 'normal'); setColor(ORANGE);
        doc.text(' Enterprise', x + w, by);
      }
      // Draw the FileFlex logo in the cover's upper-left; fall back to the
      // text wordmark if the image hasn't loaded or can't be rasterized.
      function coverLogo() {
        try {
          if (brandLogo && brandLogo.complete && brandLogo.naturalWidth) {
            var c = document.createElement('canvas');
            c.width = brandLogo.naturalWidth; c.height = brandLogo.naturalHeight;
            c.getContext('2d').drawImage(brandLogo, 0, 0);
            var lw = 132, lh = lw * (brandLogo.naturalHeight / brandLogo.naturalWidth);
            doc.addImage(c.toDataURL('image/png'), 'PNG', M, 44, lw, lh);
            return;
          }
        } catch (e) {}
        brandMark(M, 64, 12);
      }

      // Maturity levels (LV / NEXT / levelOf) are defined once at IIFE scope
      // and shared by the on-screen report and this PDF.
      var level = levelOf(data.overall);
      var levelName = LV[level].name;

      // ---------------------------------------------------------------
      // COVER PAGE
      // ---------------------------------------------------------------
      fill(ORANGE); doc.rect(0, 0, pageW, 12, 'F');

      coverLogo();

      doc.setFont('helvetica', 'bold'); doc.setFontSize(10); setColor(SOFT);
      doc.text('CONFIDENTIAL ASSESSMENT REPORT', cx, 132, { align: 'center', charSpace: 1.4 });
      fill(ORANGE); doc.rect(cx - 30, 150, 60, 3, 'F');

      doc.setFont('helvetica', 'bold'); doc.setFontSize(25); setColor(INK);
      doc.text('Secure Lending Collaboration', cx, 320, { align: 'center' });
      doc.text('Assessment', cx, 354, { align: 'center' });

      var pf = 452;
      doc.setFont('helvetica', 'bold'); doc.setFontSize(9.5); setColor(SOFT);
      doc.text('PREPARED FOR', cx, pf, { align: 'center', charSpace: 1.2 });
      var ny = pf + 30;
      if (contact.company) {
        doc.setFont('helvetica', 'bold'); doc.setFontSize(18); setColor(INK);
        doc.text(contact.company, cx, ny, { align: 'center' }); ny += 24;
      }
      var line2 = (contact.name ? contact.name.toUpperCase() : 'PREPARED FOR YOU') + (contact.email ? '   |   ' + contact.email : '');
      doc.setFont('helvetica', 'normal'); doc.setFontSize(11); setColor(INK);
      doc.text(line2, cx, ny, { align: 'center' }); ny += 20;
      doc.setFont('helvetica', 'normal'); doc.setFontSize(10); setColor(SOFT);
      doc.text(today, cx, ny, { align: 'center' });

      // Current maturity level indicator with L1..L5 progression
      var mlY = 612;
      fill(WASH); doc.roundedRect(M + 24, mlY - 36, contentW - 48, 150, 10, 10, 'F');
      doc.setFont('helvetica', 'bold'); doc.setFontSize(9.5); setColor(ORANGE);
      doc.text('CURRENT MATURITY LEVEL', cx, mlY, { align: 'center', charSpace: 1.2 });
      doc.setFont('helvetica', 'bold'); doc.setFontSize(20); setColor(INK);
      doc.text('Level ' + level + ': ' + levelName, cx, mlY + 34, { align: 'center' });
      (function () {
        var n = 5, gap = 10, w = 56, h = 26;
        var total = n * w + (n - 1) * gap;
        var sx = cx - total / 2;
        var py = mlY + 56;
        for (var i = 1; i <= n; i++) {
          var x = sx + (i - 1) * (w + gap);
          var on = i <= level;
          fill(on ? ORANGE : TRACK); doc.roundedRect(x, py, w, h, 5, 5, 'F');
          doc.setFont('helvetica', 'bold'); doc.setFontSize(10); setColor(on ? WHITE : SOFT);
          doc.text('L' + i, x + w / 2, py + 17, { align: 'center' });
        }
      })();

      doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5); setColor(SOFT);
      doc.text('\u00A9 ' + year + ' Qnext Corp. All rights reserved.   |   fileflex.com', cx, pageH - 52, { align: 'center' });

      // ---------------------------------------------------------------
      // CONTENT PAGES
      // ---------------------------------------------------------------
      var y = 0;
      function pageHeader() {
        fill(ORANGE); doc.rect(0, 0, pageW, 6, 'F');
        brandMark(M, 38, 9.5);
        fill(LINE); doc.rect(M, 50, contentW, 0.8, 'F');
        y = 90;
      }
      function newPage() { doc.addPage(); pageHeader(); }
      function ensure(need) { if (y + need > pageH - 60) { newPage(); } }

      function sectionHeading(txt) {
        ensure(50);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(11); setColor(INK);
        doc.text(txt.toUpperCase(), M, y, { charSpace: 1.7 });
        y += 9;
        fill(ORANGE); doc.rect(M, y, 38, 2.5, 'F');
        y += 24;
      }
      function paragraph(txt, opts) {
        opts = opts || {};
        var size = opts.size || 10.5;
        var color = opts.color || INK;
        var lead = opts.lead || 15;
        doc.setFont('helvetica', opts.bold ? 'bold' : 'normal'); doc.setFontSize(size); setColor(color);
        var lines = doc.splitTextToSize(txt, contentW);
        for (var i = 0; i < lines.length; i++) {
          ensure(lead);
          doc.text(lines[i], M, y);
          y += lead;
        }
        y += (opts.gap == null ? 11 : opts.gap);
      }
      function bulletBlock(txt) {
        doc.setFont('helvetica', 'normal'); doc.setFontSize(10.5); setColor(INK);
        var lines = doc.splitTextToSize(txt, contentW - 18);
        ensure(lines.length * 15 + 6);
        fill(ORANGE); doc.circle(M + 3, y - 3.5, 2, 'F');
        for (var j = 0; j < lines.length; j++) {
          doc.text(lines[j], M + 18, y); y += 15;
        }
        y += 10;
      }
      // Heading (bold, bulleted) + a "what" body line and a "why it matters"
      // detail paragraph. Used for the strengths and gaps sections so each
      // entry explains the area and its impact in depth.
      function richBlock(heading, body, detail) {
        ensure(46);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(11); setColor(INK);
        var hl = doc.splitTextToSize(heading, contentW - 18);
        fill(ORANGE); doc.circle(M + 3, y - 3.5, 2.2, 'F');
        for (var i = 0; i < hl.length; i++) { ensure(15); doc.text(hl[i], M + 18, y); y += 15; }
        y += 3;
        if (body) {
          doc.setFont('helvetica', 'normal'); doc.setFontSize(10); setColor(INK);
          var bl = doc.splitTextToSize(body, contentW - 18);
          for (var j = 0; j < bl.length; j++) { ensure(14); doc.text(bl[j], M + 18, y); y += 14; }
        }
        if (detail) {
          y += 3;
          doc.setFont('helvetica', 'normal'); doc.setFontSize(10); setColor(SOFT);
          var dl = doc.splitTextToSize(detail, contentW - 18);
          for (var k = 0; k < dl.length; k++) { ensure(14); doc.text(dl[k], M + 18, y); y += 14; }
        }
        y += 14;
      }

      newPage();

      // ---- Executive summary ----
      sectionHeading('Executive Summary');
      var leadName = contact.company || contact.name || 'Your organization';
      doc.setFont('helvetica', 'normal'); doc.setFontSize(11); setColor(INK);
      doc.text(leadName + ' is at', M, y); y += 26;
      doc.setFont('helvetica', 'bold'); doc.setFontSize(17);
      var lp = 'Level ' + level + ': ';
      setColor(INK); doc.text(lp, M, y);
      setColor(ORANGE); doc.text(levelName, M + doc.getTextWidth(lp), y); y += 24;
      paragraph(LV[level].desc, { size: 10.5 });

      if (level < 5) {
        doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
        var ndesc = doc.splitTextToSize(NEXT[level], contentW - 32);
        var boxH = 26 + 18 + ndesc.length * 14 + 16;
        ensure(boxH + 12);
        fill(WASH); doc.rect(M, y, contentW, boxH, 'F');
        fill(ORANGE); doc.rect(M, y, 3.5, boxH, 'F');
        var bx = M + 18, by = y + 24;
        doc.setFont('helvetica', 'bold'); doc.setFontSize(9); setColor(ORANGE);
        doc.text('YOUR NEXT STEP', bx, by, { charSpace: 1 }); by += 22;
        doc.setFont('helvetica', 'bold'); doc.setFontSize(12); setColor(INK);
        doc.text('Level ' + (level + 1) + ': ' + LV[level + 1].name, bx, by); by += 18;
        doc.setFont('helvetica', 'normal'); doc.setFontSize(10); setColor(SOFT);
        for (var i = 0; i < ndesc.length; i++) { doc.text(ndesc[i], bx, by); by += 14; }
        y += boxH + 20;
      }

      // ---- Maturity roadmap ----
      sectionHeading('Lending Collaboration Maturity Roadmap');
      for (var li = 1; li <= 5; li++) {
        ensure(30);
        var current = (li === level);
        var rowH = 26;
        if (current) {
          fill(WASH); doc.rect(M, y - 4, contentW, rowH, 'F');
          fill(ORANGE); doc.rect(M, y - 4, 3.5, rowH, 'F');
        }
        fill(current ? ORANGE : TRACK); doc.circle(M + 18, y + 9, 3.5, 'F');
        doc.setFont('helvetica', current ? 'bold' : 'normal'); doc.setFontSize(10.5); setColor(current ? INK : SOFT);
        doc.text('Level ' + li + ' — ' + LV[li].name, M + 32, y + 12);
        if (current) {
          doc.setFont('helvetica', 'bold'); doc.setFontSize(8.5); setColor(ORANGE);
          doc.text('YOUR POSITION', pageW - M - 6, y + 12, { align: 'right', charSpace: 0.8 });
        }
        y += rowH + 5;
      }
      y += 12;

      // ---- Score breakdown by category (scores + bars + notes + peer benchmark) ----
      sectionHeading('Score Breakdown by Category');
      data.cats.forEach(function (c) {
        var pct = Math.min(100, Math.max(4, c.pct));
        ensure(78);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(11); setColor(INK);
        doc.text(c.title, M, y);
        doc.text(c.raw + ' / ' + c.max, pageW - M, y, { align: 'right' });
        y += 10;
        var barH = 8;
        fill(TRACK); doc.roundedRect(M, y, contentW, barH, 4, 4, 'F');
        fill(ORANGE); doc.roundedRect(M, y, Math.min(contentW, Math.max(barH, contentW * pct / 100)), barH, 4, 4, 'F');
        // peer benchmark tick
        var bxp = M + contentW * Math.min(100, Math.max(0, c.benchmark)) / 100;
        fill(INK); doc.rect(bxp - 0.75, y - 3, 1.5, barH + 6, 'F');
        y += barH + 15;
        doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5); setColor(SOFT);
        var nl = doc.splitTextToSize(meta[c.id].bands[band(c.pct)].assessment, contentW);
        for (var k = 0; k < nl.length; k++) { ensure(13); doc.text(nl[k], M, y); y += 13; }
        y += 3;
        var delta = c.pct - c.benchmark;
        ensure(13);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(9); setColor(SOFT);
        doc.text('Peer average ' + c.benchmark + '%  ·  You scored ' + c.pct + '% (' + (delta >= 0 ? '+' : '') + delta + ' pts vs peers)', M, y);
        y += 16;
      });
      y += 2;

      // ---- What your organization is doing well ----
      var strengths = [];
      var gaps = [];
      data.cats.forEach(function (c) {
        var bnd = meta[c.id].bands[band(c.pct)];
        var entry = { title: c.title, body: bnd.assessment + ' ' + bnd.note, detail: bnd.detail };
        if (bnd.type === 'strength') strengths.push(entry); else gaps.push(entry);
      });

      if (strengths.length) {
        sectionHeading('What Your Organization Is Doing Well');
        paragraph('The areas below are working in your favor today — each notes the strength and why it benefits your institution.', { color: SOFT, size: 10 });
        strengths.forEach(function (s) { richBlock(s.title, s.body, s.detail); });
        y += 4;
      }

      // ---- Identified gaps & opportunities ----
      if (gaps.length) {
        sectionHeading('Identified Gaps & Opportunities');
        paragraph('The following areas represent opportunities to strengthen your secure lending collaboration. For each, we explain what the gap is and why it matters — the specific risk it creates for your institution.', { color: SOFT, size: 10 });
        gaps.forEach(function (g) { richBlock(g.title, g.body, g.detail); });
        y += 4;
      }

      // ---- Recommendations (numbered, orange tiles) — actions for the 3 priority areas ----
      var ranked = data.cats.slice().sort(function (a, b) { return a.pct - b.pct; }).slice(0, 3);
      var recs = [];
      var recSeen = {};
      ranked.forEach(function (c) { meta[c.id].actions.forEach(function (a) { if (!recSeen[a.title]) { recSeen[a.title] = 1; recs.push(a); } }); });
      if (recs.length) {
        sectionHeading('Recommendations');
        paragraph('Prioritized actions for the three areas where focused effort will have the greatest impact on your lending collaboration maturity. For each, we describe what the recommendation is and why it matters.', { color: SOFT, size: 10 });
        var numW = 32;
        recs.forEach(function (t, i) {
          var titleLines = doc.splitTextToSize(t.title, contentW - numW);
          var detailLines = doc.splitTextToSize(t.detail, contentW - numW);
          ensure(Math.max(24, titleLines.length * 15 + detailLines.length * 14) + 18);
          fill(ORANGE); doc.roundedRect(M, y - 12, 20, 20, 3, 3, 'F');
          doc.setFont('helvetica', 'bold'); doc.setFontSize(10.5); setColor(WHITE);
          doc.text(String(i + 1), M + 10, y + 2, { align: 'center' });
          doc.setFont('helvetica', 'bold'); doc.setFontSize(11); setColor(INK);
          for (var j = 0; j < titleLines.length; j++) {
            if (j > 0) ensure(15);
            doc.text(titleLines[j], M + numW, y); y += 15;
          }
          y += 3;
          doc.setFont('helvetica', 'normal'); doc.setFontSize(10); setColor(SOFT);
          for (var k = 0; k < detailLines.length; k++) {
            ensure(14);
            doc.text(detailLines[k], M + numW, y); y += 14;
          }
          y += 16;
        });
      }

      var lastContentPage = doc.internal.getNumberOfPages();

      // ---------------------------------------------------------------
      // CLOSING CTA PAGE
      // ---------------------------------------------------------------
      doc.addPage();
      fill(ORANGE); doc.rect(0, 0, pageW, 6, 'F');
      var ccy = 232;
      doc.setFont('helvetica', 'bold'); doc.setFontSize(10); setColor(ORANGE);
      doc.text('READY TO SECURE YOUR LENDING COLLABORATION?', cx, ccy, { align: 'center', charSpace: 1.2 });
      ccy += 18;
      fill(ORANGE); doc.rect(cx - 26, ccy, 52, 3, 'F');
      ccy += 48;
      doc.setFont('helvetica', 'bold'); doc.setFontSize(23); setColor(INK);
      doc.text('See How FileFlex Can Close', cx, ccy, { align: 'center' }); ccy += 32;
      doc.text('Your Lending Collaboration Gaps', cx, ccy, { align: 'center' }); ccy += 42;
      doc.setFont('helvetica', 'normal'); doc.setFontSize(11); setColor(SOFT);
      var ctaDesc = doc.splitTextToSize('FileFlex Enterprise applies Zero Trust Data Access to your lending documents — least-privilege, view-only, no-download access with a complete audit trail, without moving your data.', 400);
      for (var ci = 0; ci < ctaDesc.length; ci++) { doc.text(ctaDesc[ci], cx, ccy, { align: 'center' }); ccy += 17; }
      ccy += 30;
      var btnW = 156, btnH = 40;
      fill(ORANGE); doc.roundedRect(cx - btnW / 2, ccy, btnW, btnH, 6, 6, 'F');
      doc.setFont('helvetica', 'bold'); doc.setFontSize(11.5); setColor(WHITE);
      doc.text('Request a Demo', cx, ccy + 25, { align: 'center' });
      ccy += btnH + 42;
      doc.setFont('helvetica', 'normal'); doc.setFontSize(10.5); setColor(INK);
      doc.text('fileflex.com   |   info@qnext.com', cx, ccy, { align: 'center' });
      doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5); setColor(SOFT);
      doc.text('\u00A9 ' + year + ' Qnext Corp. All rights reserved.', cx, pageH - 52, { align: 'center' });

      // ---- footers / page numbers on narrative content pages ----
      for (var p = 2; p <= lastContentPage; p++) {
        doc.setPage(p);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(8); setColor(SOFT);
        doc.text('\u00A9 ' + year + ' Qnext Corp. All rights reserved.   |   fileflex.com', M, pageH - 28);
        doc.text('Page ' + (p - 1) + ' of ' + (lastContentPage - 1), pageW - M, pageH - 28, { align: 'right' });
      }

      var uri = doc.output('datauristring');
      var base64 = uri.substring(uri.indexOf(',') + 1);
      var fname = 'FileFlex-Lending-Assessment' + (contact.company ? '-' + contact.company.replace(/[^a-z0-9]+/gi, '-') : '') + '.pdf';
      return { base64: base64, save: function () { doc.save(fname); } };
    }

    function finalize(data) {
      var contact = gatherContact();
      setEmailStatus('Preparing your PDF report...');
      ensurePdfLibs().then(function () {
        try {
          pdfState = buildPdf(data, contact);
        } catch (err) {
          setEmailStatus('Your report is shown below. (PDF generation was unavailable.)', 'warn');
          return;
        }
        var honeyEl = form.querySelector('[name="website_url_confirm"]');
        var payload = {
          contact: contact,
          overall: data.overall,
          maturity: maturity(data.overall),
          risk: riskOf(data.overall),
          categories: data.cats.map(function (c) {
            return { short: c.short, title: c.title, raw: c.raw, max: c.max, pct: c.pct, benchmark: c.benchmark, rating: rateLabel(band(c.pct)) };
          }),
          answers: gatherAnswers(),
          pdfBase64: pdfState.base64,
          turnstileToken: (function () { var t = form.querySelector('[name="cf-turnstile-response"]'); return t ? t.value : ''; })(),
          website_url_confirm: honeyEl ? honeyEl.value : ''
        };
        setEmailStatus('Emailing your report to ' + (contact.email || 'you') + '...');
        fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
          .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            if (res.ok && res.j && res.j.ok) {
              setEmailStatus('We have emailed your report to ' + contact.email + '. You can also download it above.', 'ok');
            } else {
              setEmailStatus('Your report is ready below - use "Download PDF report" to save it. (We could not email it just now.)', 'warn');
            }
          })
          .catch(function () {
            setEmailStatus('Your report is ready below - use "Download PDF report" to save it. (We could not email it just now.)', 'warn');
          });
      }).catch(function () {
        setEmailStatus('Your report is shown below - use "Download PDF report" to print/save it.', 'warn');
      });
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      errorEl.classList.remove('is-show');

      var honey = form.querySelector('[name="website_url_confirm"]');
      if (honey && honey.value) return;
      if (Date.now() - renderedAt < 2500) {
        errorEl.textContent = 'Please take a moment to review your answers before submitting.';
        errorEl.classList.add('is-show');
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      var c = answeredCount();
      if (c < allQ.length) {
        errorEl.textContent = 'Please answer all ' + allQ.length + ' questions — ' + (allQ.length - c) + ' remaining.';
        errorEl.classList.add('is-show');
        var firstMissing = null;
        for (var i = 0; i < allQ.length; i++) {
          if (!form.querySelector('input[name="' + allQ[i] + '"]:checked')) { firstMissing = allQ[i]; break; }
        }
        if (firstMissing) {
          var grp = document.getElementById('lbl-' + firstMissing);
          if (grp) grp.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      if (CONFIG.turnstile) {
        var tEl = form.querySelector('[name="cf-turnstile-response"]');
        if (!tEl || !tEl.value) {
          errorEl.textContent = 'Please complete the verification check, then submit.';
          errorEl.classList.add('is-show');
          return;
        }
      }

      var data = score();
      submitBtn.disabled = true;

      form.style.display = 'none';
      document.getElementById('sla-intro').style.display = 'none';
      render(data);
      finalize(data);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>

{TURNSTILE_SITE_KEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>}

</Layout>
