---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';
import '../styles/platform.css';
import '../styles/architecture-engineering.css';

const challengeCards = [
  { title: 'Large Project Files', text: 'Access large project files where they already reside — without moving or synchronizing the data.', image: '/images/architecture-engineering-updated/workflow.webp', alt: 'Engineering workstation showing a detailed digital project model' },
  { title: 'Distributed Data', text: 'Project information may reside across offices, file servers, NAS, SharePoint, cloud repositories and hybrid infrastructure.', image: '/images/architecture-engineering-updated/distributed-data.webp', alt: 'Server and NAS storage equipment in a glass-walled engineering office IT room' },
  { title: 'External Collaboration', text: 'Consultants, contractors and project partners need controlled access to specific project information.', image: '/images/architecture-engineering-updated/collaboration.webp', alt: 'Architecture project team collaborating around plans' },
  { title: 'Valuable Intellectual Property', text: "Designs, drawings, specifications and engineering documentation represent some of the firm's most valuable information.", image: '/images/architecture-engineering-updated/landscape.webp', alt: 'Landscape architecture plans and design work' },
];

const protections = [
  { title: 'Least-Privilege Access', text: 'Give users access only to the project files and folders they are authorized to use.', icon: 'M12 3 4 7v5c0 5 3.4 8 8 9 4.6-1 8-4 8-9V7l-8-4Zm-3 9 2 2 4-4' },
  { title: 'Controlled External Collaboration', text: 'Provide contractors, consultants and outside parties with controlled access to specific project information without unnecessarily exposing underlying infrastructure.', icon: 'M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-1a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 21a6 6 0 0 1 12 0H2Zm11.5 0a5 5 0 0 1 8.5-3.57V21h-8.5Z' },
  { title: 'Control Sharing and Downloading', text: 'Apply granular permissions including view-only, download and sharing restrictions where appropriate for sensitive information.', icon: 'M4 5.5A2.5 2.5 0 0 1 6.5 3h3l2 2h6A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5v-11Zm8 3v7m0 0-3-3m3 3 3-3' },
  { title: 'Activity Visibility', text: 'Maintain an activity log of access and sharing actions and export activity to SIEM/Syslog environments for centralized security visibility.', icon: 'M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Zm9.5 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z' },
];
---
<Layout title="Zero Trust Data Access for Architecture & Engineering | FileFlex" description="Protect CAD drawings, project files and engineering intellectual property with Zero Trust Data Access from FileFlex Enterprise.">
  <Nav />
  <main>
    <section class="ae-hero" aria-labelledby="ae-title">
      <div class="ae-shell ae-hero__inner">
        <p class="ae-eyebrow ae-eyebrow--light">Architecture &amp; Engineering</p>
        <h1 id="ae-title">Protect Engineering Data Without Disrupting How Engineers Work</h1>
        <p class="ae-hero__lede">Secure Zero Trust Data Access to CAD drawings, project files and intellectual property across distributed teams, offices, contractors and clients — without moving the data or changing existing storage infrastructure.</p>
        <a class="pf-btn pf-btn--lg pf-btn--uppercase" href="/demo-request/">Request a Demonstration</a>
        <p class="ae-hero__tags">CAD &amp; Large Files <span>•</span> Distributed Project Teams <span>•</span> Contractor Access <span>•</span> Existing Storage <span>•</span> Zero Trust Data Access</p>
      </div>
    </section>

    <section class="ae-section ae-section--mist" aria-labelledby="challenge-title">
      <div class="ae-shell">
        <div class="ae-intro">
          <p class="ae-eyebrow">A distributed reality</p>
          <h2 id="challenge-title">Engineering Data Wasn't Designed for Today's Distributed Workforce</h2>
          <p>Architecture and engineering firms depend on large, complex project files that may be distributed across file servers, NAS devices, SharePoint, cloud storage and multiple offices.</p>
          <p>At the same time, architects, engineers, project managers, consultants and contractors need access to that information from different locations throughout the life of a project.</p>
          <p>The challenge is providing secure, productive access to valuable project data without forcing firms to migrate information, expose infrastructure or disrupt established engineering workflows.</p>
        </div>
        <div class="ae-challenge-grid">
          {challengeCards.map((card) => (
            <article class="ae-challenge-card">
              <img src={card.image} alt={card.alt} loading="lazy" decoding="async" />
              <div><h3>{card.title}</h3><p>{card.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ae-section ae-section--white">
      <div class="ae-shell ae-split">
        <div class="ae-copy"><p class="ae-eyebrow">Keep data in place</p><h2>Move Access and Governance — Not the Data</h2><p>FileFlex Enterprise overlays existing architecture and engineering infrastructure to provide Zero Trust Data Access to project files wherever they already reside.</p><p>Instead of requiring organizations to move project information into another repository, FileFlex provides secure access to existing data across on-premises, cloud and hybrid environments.</p><p class="ae-emphasis">No mandatory migration. No parallel storage repository. No need to restructure existing project data.</p></div>
        <figure class="ae-graphic ae-graphic--compact"><img src="/images/architecture-engineering-updated/graphic-2.webp" alt="FileFlex access and governance overlay connecting to existing project data" loading="lazy" decoding="async" /></figure>
      </div>
    </section>

    <section class="ae-section ae-section--tint">
      <div class="ae-shell ae-split">
        <figure class="ae-photo"><img src="/images/architecture-engineering-updated/workflow.webp" alt="Engineer using a Windows workstation with a detailed CAD model" loading="lazy" decoding="async" /></figure>
        <div class="ae-copy"><p class="ae-eyebrow">Work the way you work</p><h2>Zero Trust That Fits the Engineering Workflow</h2><h3>Work From Windows. Not Another Portal.</h3><p>Engineering professionals spend their day in specialized applications and familiar Windows workflows. FileFlex Enterprise integrates directly into that environment, allowing authorized remote files to appear within Windows and supporting standard Open/Save operations from applications such as AutoCAD and Adobe.</p><p>Engineers work the way they already work while FileFlex governs access behind the scenes.</p></div>
      </div>
      <div class="ae-shell ae-workflow-points" id="ae-workflow-cards">
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="13" rx="2"/><path d="M8 21h8m-4-5v5M8 7h3v5H8zm5 0h3v5h-3z"/></svg>
          <b>Familiar Windows Workflow</b><span>Access authorized remote project files through familiar Windows environments.</span>
        </div>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="3" width="12" height="12" rx="2"/><path d="M2 7h12"/><rect x="10" y="11" width="12" height="10" rx="2"/><path d="m14 16 2 2 3-4"/></svg>
          <b>Application Integration</b><span>Work with files using standard Windows Open/Save workflows from supported applications.</span>
        </div>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="2" width="6" height="5" rx="1"/><rect x="2" y="17" width="6" height="5" rx="1"/><rect x="16" y="17" width="6" height="5" rx="1"/><path d="M12 7v5M5 17v-5h14v5"/></svg>
          <b>Distributed Access</b><span>Provide controlled access to project data across offices and remote locations.</span>
        </div>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Zm5 6 3 3 5-5"/></svg>
          <b>No Data Migration</b><span>Continue working with files in their existing storage locations.</span>
        </div>
      </div>
    </section>

    <section class="ae-section ae-section--navy" aria-labelledby="ip-title"><div class="ae-shell"><div class="ae-intro ae-intro--light"><p class="ae-eyebrow ae-eyebrow--light">Protect what differentiates you</p><h2 id="ip-title">Protect the Intellectual Property Behind Every Project</h2><p>Architectural drawings, engineering designs, specifications, technical documentation and project records represent years of expertise and significant commercial value.</p><p>FileFlex Enterprise extends Zero Trust principles directly to access to that information, giving organizations granular control over who can access sensitive project files and what they can do with them.</p></div><div class="ae-protection-grid">{protections.map((item) => <article><svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon}/></svg><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>

    <section class="ae-section ae-section--white"><div class="ae-shell ae-split"><div class="ae-copy"><p class="ae-eyebrow">Collaborate without exposure</p><h2>One Project. Many Organizations. Controlled Data Access.</h2><p>Modern architecture and engineering projects extend far beyond the walls of a single firm.</p><p>Architects collaborate with structural, mechanical and electrical engineers. Project managers coordinate with contractors and consultants. Clients require access to project information. Teams may operate from different offices, companies and IT environments.</p><p>FileFlex Enterprise provides a controlled data access layer across this distributed project ecosystem while allowing the organization responsible for the data to maintain governance over access.</p></div><figure class="ae-graphic"><img src="/images/architecture-engineering-updated/graphic-4.webp" alt="Modern project collaboration ecosystem governed by FileFlex" loading="lazy" decoding="async" /></figure></div></section>

    <section class="ae-section ae-section--tint"><div class="ae-shell ae-split"><figure class="ae-photo"><img src="/images/architecture-engineering-updated/collaboration.webp" alt="Architect and contractor collaborating on a project plan" loading="lazy" decoding="async" /></figure><div class="ae-copy"><p class="ae-eyebrow">Granular contractor access</p><h2>Give Contractors the Data They Need — Not Everything Around It</h2><p>Give contractors and specialist consultants granular access to the specific project files and folders they need — without unnecessarily exposing the underlying network or storage infrastructure.</p><p class="ae-emphasis">Provide access to the project — not the entire environment.</p></div></div><div class="ae-shell ae-network"><div class="ae-copy"><p class="ae-eyebrow">Data, not the network</p><h2>Give Users Access to Data — Not the Network</h2><p>Traditional remote-access approaches can require organizations to extend network connectivity to users simply so they can reach the files they need.</p><p>FileFlex Enterprise changes that model.</p><p>Authorized users request access to specific data. FileFlex evaluates the request and provides access to approved files and folders without giving the user general access to the underlying corporate network or storage infrastructure.</p></div><figure class="ae-graphic"><img src="/images/architecture-engineering-updated/graphic-5.webp" alt="Comparison of data access and network access" loading="lazy" decoding="async" /></figure></div></section>

    <section class="ae-section ae-section--white"><div class="ae-shell ae-split"><figure class="ae-graphic"><img src="/images/architecture-engineering-updated/graphic-6.webp" alt="Distributed engineering data environment connected through FileFlex" loading="lazy" decoding="async" /></figure><div class="ae-copy"><p class="ae-eyebrow">A common access layer</p><h2>Secure Access Across the Engineering Data Environment</h2><p>Architecture and engineering firms rarely store all project information in one place.</p><p>FileFlex Enterprise provides a common Zero Trust Data Access layer across heterogeneous storage environments, helping organizations govern access without forcing consolidation into a new repository.</p></div></div></section>

    <section class="ae-section ae-section--tint"><div class="ae-shell ae-split"><div class="ae-copy"><p class="ae-eyebrow">Built for the project site</p><h2>Built for Real Engineering Workflows</h2><h3>Real-World Example: Landscape Architecture</h3><p>Large design and project files can create significant challenges for distributed architecture teams, particularly when organizations want to preserve their existing storage infrastructure rather than move project information into another cloud repository.</p><p>FileFlex Enterprise enables remote access to large project files from their existing locations, helping distributed teams work with the information they need while maintaining centralized control over access.</p><p>The result: secure access to large project files without requiring a wholesale migration of existing data or a parallel storage environment.</p></div><figure class="ae-photo"><img src="/images/architecture-engineering-updated/landscape.webp" alt="Landscape architects working with a detailed site plan" loading="lazy" decoding="async" /></figure></div></section>

    <section class="ae-section ae-section--white"><div class="ae-shell ae-split"><figure class="ae-graphic"><img src="/images/architecture-engineering-updated/graphic-7.webp" alt="How engineering data access works through FileFlex policy enforcement" loading="lazy" decoding="async" /></figure><div class="ae-copy"><p class="ae-eyebrow">Policy enforced</p><h2>Security That Works Behind the Scenes</h2><p>Every request for project data passes through FileFlex Enterprise policy enforcement before access is granted.</p><p>Users do not connect directly to the underlying storage system. FileFlex mediates the request, applies access policies and retrieves authorized information through its secure connector architecture.</p></div></div></section>
    <section class="ae-section ae-section--tint"><div class="ae-shell ae-split"><div class="ae-copy"><p class="ae-eyebrow">The data layer</p><h2>Complete Zero Trust at the Data Layer</h2><p>Architecture and engineering firms have invested heavily in protecting identities, endpoints, networks and applications.</p><p>But those controls ultimately surround something even more valuable:</p><p class="ae-emphasis">The designs, drawings, specifications and intellectual property behind every project.</p><p>FileFlex Enterprise extends Zero Trust directly to that data, providing granular access control to files and folders across existing storage environments.</p></div><figure class="ae-graphic"><img src="/images/architecture-engineering-updated/graphic-8.webp" alt="Complete Zero Trust at the data layer" loading="lazy" decoding="async" /></figure></div></section>
    <section class="ae-final"><div class="ae-shell"><p class="ae-eyebrow ae-eyebrow--light">FileFlex Enterprise</p><h2>Protect Engineering Data Without Rebuilding Your Infrastructure</h2><p>Your project data is already distributed across offices, storage systems, applications and project teams.</p><p>You shouldn't have to move it all somewhere else to secure it.</p><p>FileFlex Enterprise adds Zero Trust Data Access across your existing environment, helping architects and engineers securely access and collaborate on valuable project information while preserving the infrastructure and workflows they already use.</p><a class="pf-btn pf-btn--lg pf-btn--uppercase" href="/demo-request/">Request an Architecture &amp; Engineering Demonstration</a></div></section>
  </main>
</Layout>