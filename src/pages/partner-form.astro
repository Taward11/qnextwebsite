---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';

const bullets = [
  'Add ZDTA Overlay Services to your offerings',
  'Deliver unified unstructured data access and data storage governance to your customers',
  '30 days free trial',
  'Access to the ZTDA Program',
  'Ongoing sales, marketing, and technical support',
  'On-demand training and certification',
  'Zero Trust Data Security designed for the hybrid workforce',
];

const radioOptions = [
  { value: 'I’m a company looking to sell this kind of zero trust solution',
    label: 'I’m a company looking to OEM or license this kind of zero trust solution' },
  { value: 'I’m a service provider in the data security area',
    label: 'I’m a service provider in the data security area' },
  { value: 'I’m currently providing competitor solutions and want a demo',
    label: 'I’m currently providing competitor solutions and want a demo' },
  { value: 'I’m a technology organization that wants to integrate the FileFlex Enterprise solution into my product offering',
    label: 'I’m a technology organization that wants to integrate the FileFlex Enterprise solution into my product offering' },
  { value: 'Other (please specify):',
    label: 'Other (please specify):' },
];

const HS_PORTAL = '21348727';
const HS_FORM = '7f266485-c9ed-4a4c-94fd-884177054240';
---

<Layout
  title="Become a Zero Trust Data Access Security Partner | FileFlex Enterprise"
  description="Fast track your ZTDA Security Services business. Apply to become a FileFlex Enterprise Zero Trust Data Access security partner."
>

<Nav current="partner" />

<section id="pf-hero" aria-labelledby="pf-hero-heading">
  <div class="pf-hero__inner">
    <h1 id="pf-hero-heading" class="pf-hero__title">
      Become a Zero Trust Data Access Security Partner
    </h1>
  </div>
</section>

<section id="pf-main" aria-labelledby="pf-main-heading">
  <div class="pf-main__inner">

    <aside class="pf-aside" aria-label="Program highlights">
      <img
        class="pf-aside__logo"
        src="/images/partner/ztda-logo.png"
        alt="ZTDA — Zero Trust Data Access"
        width="300" height="89"
        loading="eager" decoding="async"
      />
      <h2 class="pf-aside__title">
        Fast track your ZTDA Security Services Business
      </h2>
      <ul class="pf-aside__list">
        {bullets.map((b) => (
          <li>
            <svg class="pf-check" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="11" fill="#e8590a" />
              <polyline points="7,12.5 10.5,16 17,9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </aside>

    <div class="pf-form-wrap">
      <h2 id="pf-main-heading" class="pf-form__title">
        We Make Partner Program Certification Fast and Efficient
      </h2>

      <form
        id="pf-form"
        class="pf-form"
        novalidate
        data-portal-id={HS_PORTAL}
        data-form-id={HS_FORM}
      >
        <fieldset class="pf-fieldset pf-fieldset--radio">
          <legend>Please choose one of the following <span class="pf-req" aria-hidden="true">*</span></legend>
          {radioOptions.map((opt, i) => (
            <label class="pf-radio">
              <input
                type="radio"
                name="please_choose_one_of_the_following"
                value={opt.value}
                required={i === 0}
              />
              <span>{opt.label}</span>
            </label>
          ))}
        </fieldset>

        <div class="pf-grid pf-grid--2">
          <div class="pf-field">
            <label for="pf-firstname">First name <span class="pf-req" aria-hidden="true">*</span></label>
            <input id="pf-firstname" name="firstname" type="text" autocomplete="given-name" required />
          </div>
          <div class="pf-field">
            <label for="pf-lastname">Last name <span class="pf-req" aria-hidden="true">*</span></label>
            <input id="pf-lastname" name="lastname" type="text" autocomplete="family-name" required />
          </div>
        </div>

        <div class="pf-field">
          <label for="pf-company">Company name <span class="pf-req" aria-hidden="true">*</span></label>
          <input id="pf-company" name="company" type="text" autocomplete="organization" required />
        </div>

        <div class="pf-grid pf-grid--2">
          <div class="pf-field">
            <label for="pf-email">Email <span class="pf-req" aria-hidden="true">*</span></label>
            <input id="pf-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="pf-field">
            <label for="pf-phone">Phone number <span class="pf-req" aria-hidden="true">*</span></label>
            <input id="pf-phone" name="phone" type="tel" autocomplete="tel" minlength="7" maxlength="20" required />
          </div>
        </div>

        <div class="pf-grid pf-grid--2">
          <div class="pf-field">
            <label for="pf-website">Website URL <span class="pf-req" aria-hidden="true">*</span></label>
            <input id="pf-website" name="website" type="url" autocomplete="url" placeholder="https://" required />
          </div>
          <div class="pf-field">
            <label for="pf-country">Country/Region <span class="pf-req" aria-hidden="true">*</span></label>
            <input id="pf-country" name="country" type="text" autocomplete="country-name" required />
          </div>
        </div>

        <div class="pf-field">
          <label for="pf-endusers">How many end users do you support across all your service offerings? <span class="pf-req" aria-hidden="true">*</span></label>
          <input id="pf-endusers" name="how_many_end_users_do_you_support_across_all_your_service_offerings_" type="number" min="0" step="1" required />
        </div>

        <div class="pf-field">
          <label for="pf-offerings">List your security current offerings: <span class="pf-req" aria-hidden="true">*</span></label>
          <textarea id="pf-offerings" name="list_your_security_current_offerings_" rows="4" required></textarea>
        </div>

        <div class="pf-consent">
          <p>fileflex.com is committed to protecting and respecting your privacy, and we'll only use your personal information to administer your account and to provide the products and services you requested from us. From time to time, we would like to contact you about our products and services, as well as other content that may be of interest to you. If you consent to us contacting you for this purpose, please tick below to say how you would like us to contact you:</p>
          <label class="pf-checkbox">
            <input type="checkbox" id="pf-comm-consent" name="communicationConsent" value="true" />
            <span>I agree to receive other communications from fileflex.com.</span>
          </label>
          <p class="pf-consent__fine">You can unsubscribe from these communications at any time. For more information on how to unsubscribe, our privacy practices, and how we are committed to protecting and respecting your privacy, please review our <a href="https://www.qnext.com/privacy-policy/" target="_blank" rel="noopener">Privacy Policy</a>.</p>
          <p class="pf-consent__fine">By clicking Submit below, you consent to allow fileflex.com to store and process the personal information submitted above to provide you the content requested.</p>
        </div>

        <!-- Honeypot: real users won't fill this; bots usually will. Visually hidden, hidden from a11y tree. -->
        <div class="pf-honeypot" aria-hidden="true">
          <label for="pf-website-url-2">Leave this field blank</label>
          <input id="pf-website-url-2" type="text" name="website_url_confirm" tabindex="-1" autocomplete="off" />
        </div>

        <div class="pf-actions">
          <button type="submit" class="pf-submit">Submit</button>
        </div>
      </form>

      <div id="pf-status" class="pf-status" role="status" aria-live="polite"></div>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('pf-form');
    if (!form) return;
    var status = document.getElementById('pf-status');
    var submitBtn = form.querySelector('.pf-submit');
    var portalId = form.dataset.portalId;
    var formId = form.dataset.formId;
    var endpoint = 'https://api.hsforms.com/submissions/v3/integration/submit/' + portalId + '/' + formId;
    var MIN_FILL_MS = 2500; // bots typically submit < 2.5s after page load
    var renderedAt = Date.now();

    function setStatus(msg, cls) {
      status.textContent = msg;
      status.className = 'pf-status pf-status--' + cls;
    }
    function getHsCookie() {
      var m = document.cookie.match(/(?:^|;\s*)hubspotutk=([^;]+)/);
      return m ? m[1] : '';
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }

      // Honeypot — if filled, silently "succeed" so bots don't retry
      var honey = form.querySelector('[name="website_url_confirm"]');
      if (honey && honey.value) {
        form.style.display = 'none';
        setStatus('Thanks for submitting the Partner Application Form. Someone will contact you shortly.', 'ok');
        return;
      }

      // Timing gate — too-fast submits are almost certainly bots
      if (Date.now() - renderedAt < MIN_FILL_MS) {
        setStatus('Please take a moment to review your entries before submitting.', 'err');
        return;
      }

      var fd = new FormData(form);
      var fields = [];
      var SKIP = { communicationConsent: 1, website_url_confirm: 1 };
      fd.forEach(function (value, name) {
        if (SKIP[name]) return;
        fields.push({ name: name, value: String(value) });
      });

      var commConsent = form.querySelector('#pf-comm-consent').checked;
      var hutk = getHsCookie();
      var payload = {
        submittedAt: Date.now(),
        fields: fields,
        context: { pageUri: window.location.href, pageName: document.title },
        legalConsentOptions: {
          consent: {
            consentToProcess: true,
            text: 'By clicking Submit below, you consent to allow fileflex.com to store and process the personal information submitted above to provide you the content requested.',
            communications: [{
              value: commConsent,
              subscriptionTypeId: 32387186,
              text: 'I agree to receive other communications from fileflex.com.',
            }],
          },
        },
      };
      if (hutk) payload.context.hutk = hutk;

      submitBtn.disabled = true;
      setStatus('Sending…', 'pending');

      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (r) {
          return r.text().then(function (t) {
            var body;
            try { body = JSON.parse(t); } catch (_) { body = { message: t.slice(0, 200) }; }
            return { ok: r.ok, status: r.status, body: body };
          });
        })
        .then(function (res) {
          if (res.ok) {
            form.style.display = 'none';
            setStatus('Thanks for submitting the Partner Application Form. Someone will contact you shortly.', 'ok');
            status.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            var msg = 'Submission failed. Please review the form and try again.';
            if (res.body && res.body.errors && res.body.errors.length) {
              msg = res.body.errors.map(function (e) { return e.message || e.errorType; }).join(' ');
            } else if (res.body && res.body.message) {
              msg = res.body.message;
            }
            setStatus(msg + ' (HTTP ' + res.status + ')', 'err');
            submitBtn.disabled = false;
          }
        })
        .catch(function () {
          setStatus('Network error. Please try again or contact us directly.', 'err');
          submitBtn.disabled = false;
        });
    });
  })();
</script>

</Layout>

<style>
  /* ============================================================
     HERO
     ============================================================ */
  #pf-hero {
    background: #0E1A2B;
    padding: 120px 7vw 56px;
  }
  .pf-hero__inner { max-width: 1200px; margin: 0 auto; }
  .pf-hero__title {
    font-family: "Inter", sans-serif;
    color: #fff;
    font-size: clamp(28px, 3.6vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  /* ============================================================
     MAIN — two-column
     ============================================================ */
  #pf-main {
    background: #f1f1f1;
    padding: 72px 7vw 96px;
  }
  .pf-main__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 420px) 1fr;
    gap: 64px;
    align-items: start;
  }

  /* aside */
  .pf-aside__logo {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    margin: 0 0 24px;
  }
  .pf-aside__title {
    font-family: "Inter", sans-serif;
    color: #0E1A2B;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 24px;
  }
  .pf-aside__list { list-style: none; padding: 0; margin: 0; }
  .pf-aside__list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-family: "Inter", sans-serif;
    color: #2a2f3a;
    font-size: 16px;
    line-height: 1.55;
    margin-bottom: 14px;
  }
  .pf-check { flex: 0 0 22px; width: 22px; height: 22px; margin-top: 2px; }

  /* form */
  .pf-form__title {
    font-family: "Inter", sans-serif;
    color: #0E1A2B;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0 0 28px;
  }
  .pf-form { font-family: "Inter", sans-serif; }
  .pf-req { color: #b00020; margin-left: 2px; }

  .pf-fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 22px;
  }
  .pf-fieldset legend {
    font-size: 14px;
    font-weight: 600;
    color: #0E1A2B;
    margin-bottom: 10px;
    padding: 0;
  }
  .pf-radio {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 6px 0;
    color: #2a2f3a;
    font-size: 15px;
    line-height: 1.45;
    cursor: pointer;
  }
  .pf-radio input { margin-top: 4px; accent-color: #e8590a; }

  .pf-field { margin-bottom: 16px; }
  .pf-field label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #0E1A2B;
    margin-bottom: 6px;
  }
  .pf-field input,
  .pf-field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 12px;
    font-family: "Inter", sans-serif;
    font-size: 15px;
    color: #0E1A2B;
    background: #fff;
    border: 1px solid #cfd4dc;
    border-radius: 3px;
  }
  .pf-field textarea { resize: vertical; min-height: 110px; }
  .pf-field input:focus,
  .pf-field textarea:focus {
    outline: none;
    border-color: #e8590a;
    box-shadow: 0 0 0 2px rgba(232, 89, 10, 0.18);
  }
  .pf-field input:invalid:not(:placeholder-shown) { border-color: #b00020; }

  .pf-grid { display: grid; gap: 16px; }
  .pf-grid--2 { grid-template-columns: 1fr 1fr; }

  .pf-consent {
    margin: 18px 0 8px;
    padding: 16px;
    background: #f6f8fb;
    border-left: 3px solid #021372;
    border-radius: 2px;
  }
  .pf-consent p {
    font-size: 13.5px;
    line-height: 1.55;
    color: #2a2f3a;
    margin: 0 0 12px;
  }
  .pf-consent__fine { color: #4a5260 !important; font-size: 12.5px !important; }
  .pf-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: #0E1A2B;
    cursor: pointer;
    margin: 6px 0 12px;
  }
  .pf-checkbox input { margin-top: 3px; accent-color: #e8590a; }
  .pf-consent a { color: #021372; text-decoration: underline; }

  /* Honeypot — visually hidden but reachable by bots that fill all inputs */
  .pf-honeypot {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .pf-actions { margin-top: 18px; }
  .pf-submit {
    background: #e8590a;
    color: #fff;
    border: 0;
    border-radius: 3px;
    padding: 12px 28px;
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .pf-submit:hover:not(:disabled) { background: #c54a07; }
  .pf-submit:disabled { opacity: 0.6; cursor: not-allowed; }

  .pf-status {
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 3px;
    font-size: 14px;
    display: none;
  }
  .pf-status--pending { display: block; background: #eef2fb; color: #021372; }
  .pf-status--ok      { display: block; background: #e6f4ea; color: #1e6b34; border: 1px solid #b6dcc1; }
  .pf-status--err     { display: block; background: #fdecea; color: #b00020; border: 1px solid #f5c2c0; }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 900px) {
    #pf-hero { padding: 100px 6vw 40px; }
    #pf-main { padding: 48px 6vw 64px; }
    .pf-main__inner { grid-template-columns: 1fr; gap: 48px; }
    .pf-grid--2 { grid-template-columns: 1fr; }
  }
</style>
