---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';

const bullets = [
  'Add ZDTA Overlay Services to your offerings',
  'Deliver unified unstructured data access and data storage governance to your customers',
  '30 days free trial',
  'Access to the ZTDA Program',
  'Ongoing sales, marketing, and technical support',
  'On-demand training and certification',
  'Zero Trust Data Security designed for the hybrid workforce',
];
---

<Layout
  title="Become a Zero Trust Data Access Security Partner | FileFlex Enterprise"
  description="Fast track your ZTDA Security Services business. Apply to become a FileFlex Enterprise Zero Trust Data Access security partner."
>

<Nav current="partner" />

<section id="pf-hero" aria-labelledby="pf-hero-heading">
  <div class="pf-hero__inner">
    <h1 id="pf-hero-heading" class="pf-hero__title">
      Become a Zero Trust Data Access Security Partner
    </h1>
  </div>
</section>

<section id="pf-main" aria-labelledby="pf-main-heading">
  <div class="pf-main__inner">

    <aside class="pf-aside" aria-label="Program highlights">
      <img
        class="pf-aside__logo"
        src="/images/partner/ztda-logo.png"
        alt="ZTDA — Zero Trust Data Access"
        width="300" height="89"
        loading="eager" decoding="async"
      />
      <h2 class="pf-aside__title">
        Fast track your ZTDA Security Services Business
      </h2>
      <ul class="pf-aside__list">
        {bullets.map((b) => (
          <li>
            <svg class="pf-check" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="11" fill="#e8590a" />
              <polyline points="7,12.5 10.5,16 17,9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </aside>

    <div class="pf-form" aria-label="Partner application form">
      <h2 id="pf-main-heading" class="pf-form__title">
        We Make Partner Program Certification Fast and Efficient
      </h2>

      <div id="pf-hubspot-form" class="pf-form__embed"></div>

      <noscript>
        <p class="pf-form__noscript">
          This form requires JavaScript. Please enable JavaScript or
          <a href="/contact-us/">contact us</a> directly.
        </p>
      </noscript>
    </div>

  </div>
</section>

<script type="text/javascript" src="https://js.hsforms.net/forms/embed/v2.js" is:inline></script>
<script is:inline>
  (function () {
    function mount() {
      if (typeof window.hbspt === 'undefined' || !window.hbspt.forms) {
        return setTimeout(mount, 100);
      }
      window.hbspt.forms.create({
        portalId: '21348727',
        formId: '7f266485-c9ed-4a4c-94fd-884177054240',
        region: 'na1',
        target: '#pf-hubspot-form',
      });
    }
    mount();
  })();
</script>

</Layout>

<style>
  /* ============================================================
     HERO
     ============================================================ */
  #pf-hero {
    background: #0E1A2B;
    padding: 120px 7vw 56px;
  }
  .pf-hero__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .pf-hero__title {
    font-family: "Inter", sans-serif;
    color: #fff;
    font-size: clamp(28px, 3.6vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  /* ============================================================
     MAIN — two-column
     ============================================================ */
  #pf-main {
    background: #f1f1f1;
    padding: 72px 7vw 96px;
  }
  .pf-main__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 420px) 1fr;
    gap: 64px;
    align-items: start;
  }

  /* aside */
  .pf-aside__logo {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    margin: 0 0 24px;
  }
  .pf-aside__title {
    font-family: "Inter", sans-serif;
    color: #0E1A2B;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 24px;
  }
  .pf-aside__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pf-aside__list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-family: "Inter", sans-serif;
    color: #2a2f3a;
    font-size: 16px;
    line-height: 1.55;
    margin-bottom: 14px;
  }
  .pf-check {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    margin-top: 2px;
  }

  /* form panel */
  .pf-form__title {
    font-family: "Inter", sans-serif;
    color: #0E1A2B;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0 0 28px;
  }
  .pf-form__embed {
    min-height: 320px;
  }
  .pf-form__noscript {
    font-family: "Inter", sans-serif;
    color: #2a2f3a;
    font-size: 15px;
  }

  /* HubSpot form base styling — keep neutral, let HS supply layout */
  .pf-form__embed :global(.hs-form-field) { margin-bottom: 14px; }
  .pf-form__embed :global(label) {
    display: block;
    font-family: "Inter", sans-serif;
    color: #0E1A2B;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .pf-form__embed :global(input[type="text"]),
  .pf-form__embed :global(input[type="email"]),
  .pf-form__embed :global(input[type="tel"]),
  .pf-form__embed :global(input[type="number"]),
  .pf-form__embed :global(textarea),
  .pf-form__embed :global(select) {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 12px;
    font-family: "Inter", sans-serif;
    font-size: 15px;
    color: #0E1A2B;
    background: #fff;
    border: 1px solid #cfd4dc;
    border-radius: 3px;
  }
  .pf-form__embed :global(input:focus),
  .pf-form__embed :global(textarea:focus),
  .pf-form__embed :global(select:focus) {
    outline: none;
    border-color: #e8590a;
    box-shadow: 0 0 0 2px rgba(232, 89, 10, 0.18);
  }
  .pf-form__embed :global(.hs-button),
  .pf-form__embed :global(input[type="submit"]) {
    background: #e8590a;
    color: #fff;
    border: 0;
    border-radius: 3px;
    padding: 12px 22px;
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 8px;
  }
  .pf-form__embed :global(.hs-button:hover),
  .pf-form__embed :global(input[type="submit"]:hover) {
    background: #c54a07;
  }
  .pf-form__embed :global(.hs-error-msgs) {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    color: #b00020;
    font-size: 13px;
  }
  .pf-form__embed :global(.hs-richtext),
  .pf-form__embed :global(.hs-richtext p) {
    font-family: "Inter", sans-serif;
    color: #2a2f3a;
    font-size: 14px;
    line-height: 1.6;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 900px) {
    #pf-hero { padding: 100px 6vw 40px; }
    #pf-main { padding: 48px 6vw 64px; }
    .pf-main__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
