<!-- ============================================================
     SECTION 10 — FAQ
     ============================================================ -->
<section class="pf-section pf-section--white" aria-labelledby="bk-faq-heading">
  <div class="pf-section__inner">
    <p class="pf-eyebrow pf-eyebrow--center">FAQ</p>
    <h2 id="bk-faq-heading" class="pf-title pf-title--center">Frequently Asked Questions</h2>
    <div class="bk-faq__list">
      {faqs.map((f) => (
        <details class="bk-faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
