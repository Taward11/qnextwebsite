            <td><span class="bk-no" aria-label="No">&#10007;</span></td>
            <td class="bk-col-ff"><span class="bk-yes" aria-label="Yes">&#10003;</span></td>
          </tr>
          <tr>
            <th scope="row" class="bk-compare__feature">Works with existing storage</th>
