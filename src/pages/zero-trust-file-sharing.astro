<!-- ============================================================
     SECTION 4 — HOW IT WORKS (6 steps)
     ============================================================ -->
<section class="pf-section pf-section--white" aria-labelledby="fs-how-heading">
  <div class="pf-section__inner">
    <p class="pf-eyebrow pf-eyebrow--center">How It Works</p>
    <h2 id="fs-how-heading" class="pf-title pf-title--center">How Secure File Sharing Works</h2>
    <p class="pf-lede pf-lede--center pf-lede--soft">
      A simple, governed path from request to access — with control maintained at every step.
    </p>
    <div class="fs-steps">
      <article class="fs-step">
        <span class="fs-step__num" aria-hidden="true">1</span>
        <h3>Access Requested</h3>
        <p>A user requests access to a file or folder.</p>
      </article>
      <article class="fs-step">
        <span class="fs-step__num" aria-hidden="true">2</span>
        <h3>Identity Verified</h3>
        <p>Identity is verified using strong authentication and risk signals.</p>
      </article>
      <article class="fs-step">
        <span class="fs-step__num" aria-hidden="true">3</span>
        <h3>Permissions Applied</h3>
        <p>Granular access permissions are applied based on role, context and policy.</p>
      </article>
      <article class="fs-step">
        <span class="fs-step__num" aria-hidden="true">4</span>
        <h3>Accessed Securely</h3>
        <p>The user accesses only the information they're authorized to view or use.</p>
      </article>
      <article class="fs-step">
        <span class="fs-step__num" aria-hidden="true">5</span>
        <h3>Activity Logged</h3>
        <p>All activity is monitored and logged in real time for anomalies and policy violations.</p>
      </article>
      <article class="fs-step">
        <span class="fs-step__num" aria-hidden="true">6</span>
        <h3>Revocable Anytime</h3>
        <p>Access can be modified or revoked at any time, instantly.</p>
      </article>
    </div>
    <ul class="fs-checks">
      <li>Identity is verified</li>
      <li>Access is controlled</li>
      <li>Activity is monitored</li>
      <li>Data remains protected</li>
      <li>Audit trails are maintained</li>
    </ul>
  </div>
</section>

