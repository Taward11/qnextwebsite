---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';
import '../styles/platform.css';
import '../styles/lending.css';
import '../styles/member-portals.css';
import '../styles/file-sharing.css';
---

<Layout
  title="Secure File Sharing | Zero Trust Data Access | FileFlex Enterprise"
  description="Enable employees, members, partners and third parties to securely share files while keeping complete visibility, governance and control. FileFlex replaces email attachments, shared links and FTP with Zero Trust Data Access — your data never leaves your control."
  faq={[
    { q: "What is secure file sharing with Zero Trust Data Access?", a: "Secure file sharing with Zero Trust Data Access means access to information is governed at the data level rather than by moving copies of files around. Identity is verified, permissions are granular and contextual, every action is logged, and data stays in your existing storage. FileFlex lets employees, members, partners and vendors access exactly what they're authorized to — nothing more." },
    { q: "How is this different from email attachments, shared links or FTP?", a: "Email attachments, shared links, consumer file-sharing and FTP all move or copy files, creating multiple uncontrolled copies, excessive permissions and limited visibility. FileFlex keeps a single source of truth in your storage and governs access to it, with view-only, no-download and instant-revocation controls plus a complete audit trail." },
    { q: "Can we share securely with external partners and vendors?", a: "Yes. FileFlex supports secure external collaboration with customers, members, partners, vendors and contractors — including virtual data rooms for M&A, due diligence, lending and regulatory reviews — all with least-privilege access and full auditability." },
    { q: "How does secure file sharing support compliance and audit?", a: "Every access, download, upload and share is recorded in an immutable, exportable log, and permissions are enforced at a granular level. That gives auditors and regulators clear evidence of access controls, data governance and activity tracking across sensitive financial, legal and compliance documents." }
  ]}
>

<!-- ============================================================
     NAVIGATION
     ============================================================ -->
<Nav />

<!-- ============================================================
     HERO
     ============================================================ -->
<section id="fs-hero" aria-labelledby="fs-hero-heading">
  <div class="ld-hero__content">
    <span class="ld-hero__eyebrow">FileFlex for Secure File Sharing</span>
    <h1 id="fs-hero-heading" class="ld-hero__title">
      Secure File Sharing Without Losing Control of Your Data
    </h1>
    <p class="ld-hero__lede">
      Enable employees, members, partners and third parties to securely access and exchange
      information while maintaining complete visibility, governance and control.
    </p>

    <p class="ld-hero__sub-title">
      Replace email attachments, shared links and unsecured file transfer with Zero Trust Data Access.
    </p>
    <p class="ld-hero__sub">
      Sharing should never require sacrificing control. At every stage, FileFlex keeps governance
      in your hands:
    </p>
    <ul class="ld-hero__needs">
      <li>Verify identity</li>
      <li>Control access</li>
      <li>Monitor activity</li>
      <li>Protect data</li>
      <li>Maintain audit trails</li>
    </ul>

    <p class="ld-hero__solution">
      Users get simple, secure access to the information they need — while your organization keeps
      sensitive data under governance from user to file to core systems.
    </p>

    <div class="mp-hero__ctas">
      <a class="pf-btn pf-btn--lg pf-btn--uppercase" href="/demo-request/">Request a Demo &rsaquo;</a>
      <a class="pf-btn pf-btn--lg pf-btn--uppercase pf-btn--outline" href="/contact-fileflex/">Talk to a Security Specialist &rsaquo;</a>
    </div>
  </div>
</section>

<!-- ============================================================
     SYSTEM OVERVIEW (hero graphic)
     ============================================================ -->
<section class="pf-section pf-section--light" aria-labelledby="fs-overview-heading">
  <div class="pf-section__inner">
    <p class="pf-eyebrow pf-eyebrow--center">The Big Picture</p>
    <h2 id="fs-overview-heading" class="pf-title pf-title--center">Secure Sharing. Complete Control. Full Visibility.</h2>
    <p class="pf-lede pf-lede--center pf-lede--soft">
      Authorized users connect to protected data through a single layer of Zero Trust Data Access —
      so information is shared with confidence and governed with control.
    </p>
    <figure class="mp-framework">
      <img
        src="/images/file-sharing/secure-file-sharing-overview.webp"
        alt="Secure file sharing system overview: authorized users — employees, members, partners, vendors and any authorized user — connect through a central Secure File Sharing layer powered by Zero Trust Data Access to reach protected data such as financial records, loan documents, contracts and legal files, compliance files and sensitive information. Zero Trust Data Access verifies identity, controls access, monitors activity, protects data and maintains audit trails."
        loading="lazy"
        decoding="async"
        width="1600"
        height="569"
      />
    </figure>
  </div>
</section>

