---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="FileFlex Enterprise — Zero Trust Data Access (Variant)"
  description="A creative variant of the FileFlex homepage exploring an Illumio-inspired design language."
>

<!-- ============================================================
     UTILITY BAR
     ============================================================ -->
<div class="il-utility">
  <div class="il-utility__inner">
    <a href="#" class="il-utility__alert">Experienced a Breach?</a>
    <span class="il-utility__sep">|</span>
    <a href="#">Support</a>
    <span class="il-utility__sep">|</span>
    <a href="#">Contact Us</a>
    <span class="il-utility__sep">|</span>
    <a href="#">+1 855 426 3983</a>
  </div>
</div>

<!-- ============================================================
     PRIMARY NAVIGATION
     ============================================================ -->
<header class="il-nav">
  <div class="il-nav__inner">
    <a href="/" class="il-nav__brand" aria-label="FileFlex home">
      <span class="il-nav__mark" aria-hidden="true"></span>
      <span class="il-nav__wordmark">fileflex</span>
    </a>
    <nav class="il-nav__links" aria-label="Primary">
      <a href="#">Why FileFlex</a>
      <a href="#">Platform</a>
      <a href="#">Solutions</a>
      <a href="#">Partners</a>
      <a href="#">Resources</a>
      <a href="#">Company</a>
    </nav>
    <div class="il-nav__cta">
      <button class="il-icon-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </button>
      <a href="#" class="il-btn-pill">Explore Insights</a>
    </div>
  </div>
</header>

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="il-hero">
  <div class="il-hero__inner">
    <div class="il-hero__text">
      <h1 class="il-hero__headline">
        Secure the <span class="il-accent">Data Layer</span><br />
        of Zero Trust
      </h1>
      <p class="il-hero__sub">
        80% of all corporate data is unstructured — identity locked,
        network locked, application locked. The data itself remains wide open.
        It's time to close that gap.
      </p>
      <div class="il-hero__actions">
        <a href="#" class="il-btn-pill il-btn-pill--lg">Learn more</a>
        <a href="#" class="il-link-arrow">Watch the film
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="il-hero__dots" aria-hidden="true">
        <span class="active"></span><span></span><span></span><span></span>
      </div>
    </div>
    <div class="il-hero__visual" aria-hidden="true">
      <div class="il-hero__visual-inner">
        <div class="il-hero__glow"></div>
        <div class="il-hero__shard"></div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     LOGO STRIP
     ============================================================ -->
<section class="il-logos" aria-label="Trusted by">
  <div class="il-logos__inner">
    <p class="il-logos__caption">Trusted by security leaders</p>
    <div class="il-logos__row">
      <img src="/images/Illumio-logo-grey.webp" alt="Illumio" loading="lazy" decoding="async" />
      <img src="/images/zscaler-logo-grey.webp" alt="Zscaler" loading="lazy" decoding="async" />
      <img src="https://fileflex.com/wp-content/uploads/2025/12/Cisco-logo-grey.png.webp" alt="Cisco" loading="lazy" decoding="async" />
      <img src="https://fileflex.com/wp-content/uploads/2025/12/Palo-Alto-logo-grey.png.webp" alt="Palo Alto Networks" loading="lazy" decoding="async" />
      <img src="/images/Microsoft-logo-grey.webp" alt="Microsoft" loading="lazy" decoding="async" />
      <img src="https://fileflex.com/wp-content/uploads/2026/01/cloudfare.webp" alt="Cloudflare" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<!-- ============================================================
     THE GAP — PROBLEM / SOLUTION
     ============================================================ -->
<section class="il-gap">
  <div class="il-gap__inner">
    <p class="il-eyebrow">The Zero Trust Data Gap</p>
    <h2 class="il-section-title">
      Hackers don't steal your network.<br />
      <span class="il-accent">They steal your data.</span>
    </h2>
    <div class="il-gap__grid">
      <article class="il-card">
        <p class="il-card__label">The problem</p>
        <h3 class="il-card__title">Today's Zero Trust stops at identity, networks, and applications.</h3>
        <p class="il-card__body">
          Unstructured data — the files where your IP and regulated information
          actually live — sits outside that perimeter. It's the last unprotected
          surface.
        </p>
      </article>
      <article class="il-card il-card--filled">
        <p class="il-card__label">The solution</p>
        <h3 class="il-card__title">Zero Trust Data Access completes the strategy in the data layer.</h3>
        <p class="il-card__body">
          Least-privilege, just-in-time, fully governed access applied directly
          to files wherever they reside — without moving them, without VPNs,
          without migration.
        </p>
        <a href="#" class="il-link-arrow il-link-arrow--light">Read the brief
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </article>
    </div>
  </div>
</section>

</Layout>

<style is:global>
  /* ============================================================
     ILLUMIO-INSPIRED VARIANT — scoped to .il- classes
     ============================================================ */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  :root {
    --il-bg: #ffffff;
    --il-ink: #0E1A2B;
    --il-ink-soft: #4A5A6E;
    --il-line: #E5E8ED;
    --il-accent: #ED5B2D;
    --il-accent-dark: #C9461B;
    --il-surface-dark: #0E1A2B;
  }

  body:has(.il-hero) {
    background: var(--il-bg);
    color: var(--il-ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
    margin: 0;
  }

  [class^="il-"], [class*=" il-"] { box-sizing: border-box; }
  .il-accent { color: var(--il-accent); }

  /* ---------- Utility bar ---------- */
  .il-utility {
    background: #0a1422;
    color: #cdd5e0;
    font-size: 13px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .il-utility__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 10px 32px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 14px;
  }
  .il-utility a { color: inherit; text-decoration: none; }
  .il-utility a:hover { color: #fff; }
  .il-utility__alert { color: var(--il-accent); font-weight: 500; }
  .il-utility__sep { color: rgba(255,255,255,0.25); }

  /* ---------- Primary nav ---------- */
  .il-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,0.96);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--il-line);
  }
  .il-nav__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .il-nav__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--il-ink);
  }
  .il-nav__mark {
    width: 28px; height: 28px;
    background: var(--il-accent);
    border-radius: 6px;
    display: inline-block;
    position: relative;
  }
  .il-nav__mark::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 2px solid #fff;
    border-radius: 2px;
  }
  .il-nav__wordmark {
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  .il-nav__links {
    display: flex;
    gap: 32px;
    margin-left: 24px;
  }
  .il-nav__links a {
    color: var(--il-ink);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: color .15s;
  }
  .il-nav__links a:hover { color: var(--il-accent); }
  .il-nav__cta {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .il-icon-btn {
    width: 40px; height: 40px;
    border-radius: 8px;
    border: 1px solid var(--il-line);
    background: #fff;
    color: var(--il-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .il-icon-btn:hover { border-color: var(--il-ink); }

  /* ---------- Pill button ---------- */
  .il-btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background: var(--il-accent);
    color: #fff;
    font-weight: 500;
    font-size: 15px;
    border-radius: 999px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background .15s, transform .15s;
  }
  .il-btn-pill:hover { background: var(--il-accent-dark); }
  .il-btn-pill--lg { padding: 16px 32px; font-size: 16px; }

  /* ---------- Hero ---------- */
  .il-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 50%, rgba(237,91,45,0.05), transparent 60%),
      var(--il-bg);
  }
  .il-hero__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 32px 96px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: 560px;
  }
  .il-hero__headline {
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    color: var(--il-ink);
  }
  .il-hero__sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--il-ink-soft);
    max-width: 480px;
    margin: 0 0 36px;
  }
  .il-hero__actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .il-link-arrow {
    color: var(--il-ink);
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .il-link-arrow:hover { color: var(--il-accent); }
  .il-link-arrow svg { transition: transform .15s; }
  .il-link-arrow:hover svg { transform: translateX(3px); }
  .il-link-arrow--light { color: #fff; }
  .il-link-arrow--light:hover { color: var(--il-accent); }

  .il-hero__dots {
    margin-top: 56px;
    display: flex;
    gap: 10px;
  }
  .il-hero__dots span {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--il-line);
  }
  .il-hero__dots .active { background: var(--il-accent); }

  /* Hero visual placeholder — abstract orange shard */
  .il-hero__visual {
    position: relative;
    height: 100%;
    min-height: 420px;
  }
  .il-hero__visual-inner {
    position: absolute;
    inset: 0;
  }
  .il-hero__glow {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 70%; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(237,91,45,0.18), transparent 65%);
    border-radius: 50%;
    filter: blur(20px);
  }
  .il-hero__shard {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) rotate(-12deg);
    width: 60%; aspect-ratio: 1.2;
    background:
      linear-gradient(135deg, transparent 0%, rgba(237,91,45,0.85) 40%, #C9461B 70%, #0E1A2B 100%);
    clip-path: polygon(0 50%, 35% 0, 100% 30%, 85% 100%, 15% 80%);
    box-shadow: 0 30px 80px rgba(237,91,45,0.25);
  }

  /* ---------- Logo strip ---------- */
  .il-logos {
    border-top: 1px solid var(--il-line);
    border-bottom: 1px solid var(--il-line);
    padding: 56px 32px;
  }
  .il-logos__inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .il-logos__caption {
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--il-ink-soft);
    margin: 0 0 32px;
  }
  .il-logos__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .il-logos__row img {
    height: 32px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
    transition: opacity .2s;
  }
  .il-logos__row img:hover { opacity: 1; }

  /* ---------- The Gap ---------- */
  .il-gap {
    padding: 120px 32px;
  }
  .il-gap__inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .il-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--il-accent);
    margin: 0 0 20px;
  }
  .il-section-title {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--il-ink);
    margin: 0 0 64px;
    max-width: 900px;
  }
  .il-gap__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .il-card {
    background: #fff;
    border: 1px solid var(--il-line);
    border-radius: 20px;
    padding: 48px;
  }
  .il-card--filled {
    background: var(--il-surface-dark);
    border-color: var(--il-surface-dark);
    color: #fff;
  }
  .il-card__label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--il-accent);
    margin: 0 0 20px;
  }
  .il-card__title {
    font-size: 28px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
  }
  .il-card--filled .il-card__title { color: #fff; }
  .il-card__body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--il-ink-soft);
    margin: 0 0 24px;
  }
  .il-card--filled .il-card__body { color: rgba(255,255,255,0.75); }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .il-nav__links { display: none; }
    .il-hero__inner { grid-template-columns: 1fr; padding: 56px 24px 72px; }
    .il-hero__visual { min-height: 320px; order: -1; }
    .il-gap { padding: 80px 24px; }
    .il-gap__grid { grid-template-columns: 1fr; }
    .il-card { padding: 32px; }
    .il-utility__inner { padding: 10px 16px; gap: 10px; font-size: 12px; flex-wrap: wrap; }
  }
</style>
