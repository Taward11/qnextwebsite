     USE CASES — ACCORDION-STYLE LINKS
     ============================================================ -->
<section class="il-cases">
  <div class="il-cases__inner">
    <p class="il-eyebrow">Use cases</p>
    <h2 class="il-section-title">Trusted by organizations to deliver real outcomes.</h2>
    <ul class="il-cases__list">
      <li>
        <a href="#">
          <span><strong>A Financial Institution.</strong> Zero Trust Virtual Data Rooms to centralize and secure mortgage workflows.</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </li>
      <li>
        <a href="#">
          <span><strong>A Nuclear Power Utility.</strong> Securing access to large technical libraries on legacy FTP servers.</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </li>
      <li>
        <a href="#">
          <span><strong>A Law Firm.</strong> Low-cost, zero-trust access to sensitive case files on legacy NAS devices.</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </li>
      <li>
        <a href="#">
          <span><strong>A Landscape Architecture Firm.</strong> Fast, secure access to massive project files without risky sync or cloud migration.</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </li>
      <li>
        <a href="#">
          <span><strong>A Hospital.</strong> Protecting access and sharing of personal health information with ZTDA for Windows.</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
