</section>

<!-- ============================================================
     KEY CAPABILITIES
     ============================================================ -->
<section class="il-features il-features--alt">
  <div class="il-features__inner">
    <p class="il-eyebrow">Key capabilities</p>
    <h2 class="il-section-title">Four pillars of Zero Trust Data Access.</h2>
    <div class="il-features__grid">
      <article class="il-feature">
        <div class="il-feature__icon il-feature__icon--filled">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2L3 7v6c0 5 4 8 9 9 5-1 9-4 9-9V7l-9-5z"/><path d="M9 12l2 2 4-4"/></svg>
        </div>
        <h4>Data Governance</h4>
        <p>Complete control over your data — where it lives, who can access it, and what they can do with it — through centralized policy and on-demand auditability.</p>
        <a href="#" class="il-link-arrow">Read more
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
