<!-- ============================================================
     VIDEO MODAL
     ============================================================ -->
<div class="pf-modal-overlay" id="sec-modal" role="dialog" aria-modal="true" aria-label="Video player">
  <a class="pf-modal-backdrop" href="#!" aria-label="Close video"></a>
  <div class="pf-modal">
    <a class="pf-modal-close" href="#!" aria-label="Close video">&times;</a>
    <iframe src="https://www.youtube-nocookie.com/embed/_9K6-YxINTQ?rel=0&modestbranding=1" title="The Missing Security Layer That Truly Matters" loading="lazy" allow="encrypted-media" allowfullscreen></iframe>
  </div>
</div>

</Layout>
