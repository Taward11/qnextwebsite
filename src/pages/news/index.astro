---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { getNewsPosts, formatDate } from '../../lib/blog';
import '../../styles/fileflex.css';
import '../../styles/blog.css';

const posts = await getNewsPosts();
---

<Layout title="News | FileFlex" description="Press releases and corporate announcements from Qnext Corp.">

  <Nav current="" />

  <div class="news-index-wrap">
   <div class="news-index">
    <header class="news-index__header">
      <h1 class="news-index__title">News</h1>
      <p class="news-index__lede">Press releases and corporate announcements from Qnext Corp.</p>
    </header>

    {posts.length === 0 ? (
      <p class="news-index__empty">No news releases yet.</p>
    ) : (
      <ul class="news-index__list">
        {posts.map((p) => (
          <li class="news-index__item">
            {p.data.featuredImage && (
              <a class="news-index__media" href={`/news/${p.slug}/`} aria-hidden="true" tabindex="-1">
                <img src={p.data.featuredImage} alt="" loading="lazy" decoding="async" />
              </a>
            )}
            <div class="news-index__body">
              <p class="news-index__meta">{formatDate(p.data.date)}</p>
              <h2 class="news-index__heading">
                <a href={`/news/${p.slug}/`}>{p.data.title}</a>
              </h2>
              {p.data.excerpt && <p class="news-index__excerpt">{p.data.excerpt}</p>}
            </div>
          </li>
        ))}
      </ul>
    )}
   </div>
  </div>
</Layout>

<style>
  .news-index-wrap { background: #fff; }
  .news-index {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 6vw 90px;
  }
  .news-index__header { margin-bottom: 40px; }
  .news-index__title {
    color: #0E1A2B;
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .news-index__lede {
    color: #4a5260;
    font-size: 16px;
    margin: 0;
  }
  .news-index__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 32px;
  }
  .news-index__item {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 28px;
    padding-bottom: 32px;
    border-bottom: 1px solid #ececec;
  }
  .news-index__item:last-child { border-bottom: 0; }
  .news-index__media img {
    display: block;
    width: 100%;
    height: 170px;
    object-fit: cover;
    border-radius: 6px;
  }
  .news-index__meta {
    color: #4a5260;
    font-size: 13px;
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .news-index__heading {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .news-index__heading a {
    color: #0E1A2B;
    text-decoration: none;
  }
  .news-index__heading a:hover { color: #e8590a; }
  .news-index__excerpt {
    color: #2a2f3a;
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }
  .news-index__empty { color: #4a5260; font-size: 15px; }
  @media (max-width: 720px) {
    .news-index__item { grid-template-columns: 1fr; }
    .news-index__media img { height: 200px; }
  }
</style>
