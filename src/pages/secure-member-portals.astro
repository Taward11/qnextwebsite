---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';
import '../styles/platform.css';
import '../styles/lending.css';
import '../styles/member-portals.css';
---

<Layout
  title="Secure Member Portals for Credit Unions | FileFlex Enterprise"
  description="Deliver a secure digital member experience without sacrificing control. FileFlex gives credit unions secure document exchange, member self-service and digital collaboration powered by Zero Trust Data Access — without email attachments or moving your data."
  faq={[
    { q: "What is a secure member portal?", a: "A secure member portal lets credit union members log in to upload documents, submit applications, receive statements and communicate with staff in a controlled, audited environment. FileFlex powers it with Zero Trust Data Access, so identity is verified, access is least-privilege, every action is logged and member data stays in your systems." },
    { q: "How does FileFlex protect sensitive member information?", a: "FileFlex governs access at the data level. Members and staff get scoped, least-privilege access to exactly the documents a request requires, with view-only, no-download and instant revocation options. Files stay in your existing storage, nothing is copied into third-party clouds, and every access, upload, download and share is immutably logged." },
    { q: "Can members exchange documents without email attachments or public file-sharing?", a: "Yes. Instead of emailing driver's licenses, tax returns and financial statements or using consumer file-sharing services, members upload and access documents through a policy-controlled portal. The credit union keeps full visibility and a complete audit trail of who accessed what and when." },
    { q: "How does a secure member portal support compliance and audit?", a: "FileFlex records every member and staff interaction in an immutable, exportable log and enforces granular permissions. That gives examiners and auditors clear evidence of access controls, data governance and activity tracking across loan applications, account opening and ongoing member services." }
  ]}
>

<!-- ============================================================
     NAVIGATION
     ============================================================ -->
<Nav />

<!-- ============================================================
     HERO
     ============================================================ -->
<section id="mp-hero" aria-labelledby="mp-hero-heading">
  <div class="ld-hero__content">
    <span class="ld-hero__eyebrow">FileFlex for Member Experience</span>
    <h1 id="mp-hero-heading" class="ld-hero__title">
      Deliver a Secure Digital Member Experience Without Sacrificing Control
    </h1>
    <p class="ld-hero__lede">
      Provide members with secure, convenient access to documents, applications and collaboration
      tools while keeping sensitive information under your control.
    </p>

    <p class="ld-hero__sub-title">Enable secure member collaboration with Zero Trust Data Access.</p>
    <p class="ld-hero__sub">
      Members move through a simple, secure journey — and your credit union keeps governance at
      every step:
    </p>
    <ul class="ld-hero__needs">
      <li>Verify identity</li>
      <li>Control access</li>
      <li>Monitor activity</li>
      <li>Protect member data</li>
      <li>Maintain audit trails</li>
      <li>Keep the experience simple</li>
    </ul>

    <p class="ld-hero__solution">
      Members receive a modern digital experience while the credit union maintains security,
      visibility and governance from member to portal to core systems.
    </p>

    <div class="mp-hero__ctas">
      <a class="pf-btn pf-btn--lg pf-btn--uppercase" href="/demo-request/">Request a Demo &rsaquo;</a>
    </div>
  </div>
</section>

<!-- ============================================================
     SECTION 1 — MEMBER EXPECTATIONS HAVE CHANGED
     ============================================================ -->
