    <a href="/" class="ms-nav__brand" aria-label="FileFlex home">
      <span class="ms-nav__mark" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span class="ms-nav__wordmark">FileFlex</span>
    </a>
    <nav class="ms-nav__links" aria-label="Main">
      <a href="#">Zero Trust Data</a>
      <a href="#">Platform</a>
      <a href="#">Copilot Security</a>
      <a href="#">Windows</a>
      <a href="#">SharePoint</a>
      <a href="#">Partners</a>
      <a href="#">Resources</a>
      <a href="#">Support</a>
    </nav>
    <div class="ms-nav__utility">
      <button class="ms-nav__util-btn" type="button">
        All FileFlex
        <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
      <button class="ms-nav__util-btn" type="button" aria-label="Search">
        Search
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
      </button>
      <a href="#" class="ms-nav__util-btn">Sign in
        <span class="ms-nav__avatar" aria-hidden="true">JD</span>
      </a>
    </div>
  </div>
</header>

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="ms-hero" aria-label="Hero">
  <div class="ms-hero__bg" aria-hidden="true"></div>
  <div class="ms-hero__inner">
    <button class="ms-hero__pause" type="button" aria-label="Pause carousel">
      <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><rect x="3" y="2" width="3" height="10" fill="currentColor"/><rect x="8" y="2" width="3" height="10" fill="currentColor"/></svg>
    </button>
    <h1 class="ms-hero__headline">
      Secure the data layer of Zero Trust
    </h1>
    <p class="ms-hero__sub">
      Least-privilege, just-in-time, fully governed access applied directly to files — wherever they reside. No migration, no VPNs, no agents on the endpoint.
    </p>

    <!-- 3-up product cards on hero -->
    <div class="ms-hero__cards">
      <article class="ms-pcard">
        <div class="ms-pcard__media" data-tone="aurora">
          <div class="ms-pcard__glow" aria-hidden="true"></div>
          <svg class="ms-pcard__icon" viewBox="0 0 64 64" width="120" height="120" aria-hidden="true">
            <defs>
              <linearGradient id="g1" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0" stop-color="#FF7A45"/>
                <stop offset="1" stop-color="#FF3D00"/>
              </linearGradient>
            </defs>
            <rect x="10" y="14" width="44" height="36" rx="4" fill="none" stroke="url(#g1)" stroke-width="2.5"/>
            <path d="M22 28h20M22 36h14" stroke="url(#g1)" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="47" cy="42" r="6" fill="url(#g1)"/>
            <path d="M44 42l2.4 2.4L50 41" stroke="#fff" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="ms-pcard__title">FileFlex for Enterprise</h3>
        <p class="ms-pcard__sub">Zero Trust Data Access at scale</p>
        <a href="#" class="ms-btn ms-btn--light">Learn more</a>
      </article>

      <article class="ms-pcard">
        <div class="ms-pcard__media" data-tone="ember">
          <div class="ms-pcard__glow" aria-hidden="true"></div>
          <svg class="ms-pcard__icon" viewBox="0 0 64 64" width="120" height="120" aria-hidden="true">
            <defs>
              <linearGradient id="g2" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0" stop-color="#7CC8FF"/>
                <stop offset="1" stop-color="#2D80FF"/>
              </linearGradient>
            </defs>
            <path d="M32 8l22 10v14c0 13-10 21-22 24-12-3-22-11-22-24V18z" fill="none" stroke="url(#g2)" stroke-width="2.5" stroke-linejoin="round"/>
            <path d="M24 32l6 6 12-12" stroke="url(#g2)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="ms-pcard__title">FileFlex for Copilot</h3>
        <p class="ms-pcard__sub">Governed AI access to unstructured data</p>
        <a href="#" class="ms-btn ms-btn--light">Learn more</a>
      </article>

      <article class="ms-pcard">
        <div class="ms-pcard__media" data-tone="violet">
          <div class="ms-pcard__glow" aria-hidden="true"></div>
          <svg class="ms-pcard__icon" viewBox="0 0 64 64" width="120" height="120" aria-hidden="true">
            <defs>
              <linearGradient id="g3" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0" stop-color="#C77DFF"/>
                <stop offset="1" stop-color="#7B2CBF"/>
              </linearGradient>
            </defs>
            <circle cx="32" cy="32" r="22" fill="none" stroke="url(#g3)" stroke-width="2.5"/>
            <path d="M16 32h32M32 16c5 4 8 10 8 16s-3 12-8 16c-5-4-8-10-8-16s3-12 8-16z" stroke="url(#g3)" stroke-width="2.5" fill="none"/>
          </svg>
        </div>
        <h3 class="ms-pcard__title">FileFlex Hybrid Cloud</h3>
        <p class="ms-pcard__sub">Federated access across on-prem & cloud</p>
        <a href="#" class="ms-btn ms-btn--light">Learn more</a>
