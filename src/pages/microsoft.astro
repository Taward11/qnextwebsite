<!-- ============================================================
     PROMO BAND 1 — Big editorial split (img left / text right)
     ============================================================ -->
<section class="ms-promo">
  <div class="ms-promo__inner">
    <div class="ms-promo__visual">
      <img src="/images/windows-integration.webp" alt="Federated Windows access in File Explorer across cloud, on-premises, SharePoint and remote repositories" loading="lazy" decoding="async" />
    </div>
    <div class="ms-promo__copy">
      <p class="ms-eyebrow">Federated Windows Access</p>
      <h2 class="ms-h2">Your team works in File Explorer. Now it just works — everywhere.</h2>
      <p class="ms-lede">
        Cloud repositories, on-prem NAS, SharePoint libraries, even Tokyo office shares — accessed natively from Windows, with policy enforced at the file.
      </p>
      <a href="#" class="ms-btn ms-btn--dark">Learn more</a>
    </div>
  </div>
</section>

<!-- ============================================================
     PROMO BAND 2 — Full-bleed dark band
     ============================================================ -->
<section class="ms-darkband">
  <div class="ms-darkband__inner">
    <p class="ms-eyebrow ms-eyebrow--light">The Zero Trust Data Gap</p>
    <h2 class="ms-h2 ms-h2--light">
      Hackers don't steal your network. They steal your data.
    </h2>
    <p class="ms-lede ms-lede--light">
      80% of corporate data is unstructured — and it sits outside identity, network, and application Zero Trust. FileFlex closes the data layer.
    </p>

    <div class="ms-darkband__grid">
      <div class="ms-stat">
        <p class="ms-stat__num">80<span>%</span></p>
        <p class="ms-stat__label">Of corporate data is unstructured files</p>
      </div>
      <div class="ms-stat">
        <p class="ms-stat__num">0</p>
        <p class="ms-stat__label">Files moved during deployment</p>
      </div>
      <div class="ms-stat">
        <p class="ms-stat__num">&lt;24<span>hr</span></p>
        <p class="ms-stat__label">Typical time to first governed share</p>
      </div>
      <div class="ms-stat">
        <p class="ms-stat__num">1</p>
        <p class="ms-stat__label">Overlay across every repository</p>
      </div>
    </div>

    <div class="ms-darkband__cta">
      <a href="#" class="ms-btn ms-btn--light">Read the brief</a>
      <a href="#" class="ms-link-arrow">Watch the film
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ============================================================
     PROMO BAND 3 — Editorial split reversed (text left / img right)
     ============================================================ -->
<section class="ms-promo ms-promo--reverse">
  <div class="ms-promo__inner">
    <div class="ms-promo__copy">
      <p class="ms-eyebrow">Built for Copilot</p>
      <h2 class="ms-h2">Let Copilot reason over the files Copilot was never allowed to see.</h2>
      <p class="ms-lede">
        Grounding agents in unstructured enterprise data — securely. FileFlex enforces least-privilege at the file so Copilot can be powerful and compliant at the same time.
      </p>
      <a href="#" class="ms-btn ms-btn--dark">Explore Copilot integration</a>
    </div>
    <div class="ms-promo__visual ms-promo__visual--diagram">
      <img src="/images/zt-solution.webp" alt="Complete Zero Trust framework with FileFlex closing the data layer" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

