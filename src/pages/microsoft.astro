<style is:global>
  /* ---------- Microsoft-inspired tokens ---------- */
  .ms-root {
    --ms-ink: #000;
    --ms-ink-soft: #616161;
    --ms-line: #E6E6E6;
    --ms-bg: #fff;
    --ms-bg-alt: #F2F2F2;
    --ms-dark: #0A0A0A;
    --ms-card: #1F1F1F;
    --ms-accent: #0067C0;
    font-family: "Segoe UI", "Segoe UI Variable", -apple-system, BlinkMacSystemFont, Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--ms-ink);
    background: var(--ms-bg);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  .ms-root * { box-sizing: border-box; }
  .ms-root img { max-width: 100%; height: auto; display: block; }
  .ms-root a { color: inherit; text-decoration: none; }

  /* ---------- Shared atoms ---------- */
  .ms-eyebrow {
    text-transform: none;
    font-size: 13px;
    font-weight: 600;
    color: var(--ms-ink-soft);
    margin: 0 0 14px;
    letter-spacing: 0;
  }
  .ms-eyebrow--light { color: rgba(255,255,255,0.7); }
  .ms-h2 {
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
    color: var(--ms-ink);
  }
  .ms-h2--light { color: #fff; }
  .ms-lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--ms-ink-soft);
    margin: 0 0 28px;
    max-width: 56ch;
  }
  .ms-lede--light { color: rgba(255,255,255,0.78); }

  .ms-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    border-radius: 2px;
    transition: opacity 0.15s, transform 0.15s;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .ms-btn--light { background: #fff; color: #000; }
  .ms-btn--light:hover { background: #f0f0f0; }
  .ms-btn--dark { background: #000; color: #fff; }
  .ms-btn--dark:hover { background: #1a1a1a; }
  .ms-btn--ghost-light {
    background: transparent; color: #fff; border-color: rgba(255,255,255,0.6);
  }

  .ms-link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    transition: gap 0.2s;
  }
  .ms-link-arrow--dark { color: #000; }
  .ms-link-arrow:hover { gap: 10px; text-decoration: underline; }

  /* ---------- Nav ---------- */
