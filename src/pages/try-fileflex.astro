---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';

const bullets = [
  '30-day free trial — full features, no credit card required',
  'Zero Trust Data Access for unstructured data across your hybrid environment',
  'Secure remote access to on-prem file shares and cloud storage',
  'Granular, micro-segmented permissions with no VPN required',
  'Centralized audit trail and policy controls for IT',
  'Deploys in days, not months — no data migration needed',
  'Free onboarding support from the FileFlex team',
];

const HS_PORTAL = '21348727';
const HS_FORM = 'fd55f82f-60ba-4db3-b0b6-ffcba491d7cf';
---

<Layout
  title="Try FileFlex Enterprise — Free 30-Day Trial | FileFlex Enterprise"
  description="Start your free 30-day trial of FileFlex Enterprise. Zero Trust Data Access for the hybrid workforce — secure remote access to unstructured data without a VPN."
>

<Nav />

<section id="tf-hero" aria-labelledby="tf-hero-heading">
  <div class="tf-hero__inner">
    <h1 id="tf-hero-heading" class="tf-hero__title">
      Try FileFlex Enterprise — Free for 30 Days
    </h1>
  </div>
</section>

<section id="tf-main" aria-labelledby="tf-main-heading">
  <div class="tf-main__inner">

    <aside class="tf-aside" aria-label="Why try FileFlex Enterprise">
      <h2 class="tf-aside__title">
        Zero Trust Data Access for the Hybrid Workforce
      </h2>
      <ul class="tf-aside__list">
        {bullets.map((b) => (
          <li>
            <svg class="tf-check" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="11" fill="#e8590a" />
              <polyline points="7,12.5 10.5,16 17,9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </aside>

    <div class="tf-form-wrap">
      <h2 id="tf-main-heading" class="tf-form__title">
        Request Your Free Trial
      </h2>

      <form
        id="tf-form"
        class="tf-form"
        novalidate
        data-portal-id={HS_PORTAL}
        data-form-id={HS_FORM}
      >
        <div class="tf-grid tf-grid--2">
          <div class="tf-field">
            <label for="tf-firstname">First name <span class="tf-req" aria-hidden="true">*</span></label>
            <input id="tf-firstname" name="firstname" type="text" autocomplete="given-name" required />
          </div>
          <div class="tf-field">
            <label for="tf-lastname">Last name <span class="tf-req" aria-hidden="true">*</span></label>
            <input id="tf-lastname" name="lastname" type="text" autocomplete="family-name" required />
          </div>
        </div>

        <div class="tf-field">
          <label for="tf-company">Company name <span class="tf-req" aria-hidden="true">*</span></label>
          <input id="tf-company" name="company" type="text" autocomplete="organization" required />
        </div>

        <div class="tf-grid tf-grid--2">
          <div class="tf-field">
            <label for="tf-email">Email <span class="tf-req" aria-hidden="true">*</span></label>
            <input id="tf-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="tf-field">
            <label for="tf-phone">Phone <span class="tf-req" aria-hidden="true">*</span></label>
            <input id="tf-phone" name="phone" type="tel" autocomplete="tel" minlength="7" maxlength="20" required />
          </div>
        </div>

        <div class="tf-grid tf-grid--2">
          <div class="tf-field">
            <label for="tf-city">City <span class="tf-req" aria-hidden="true">*</span></label>
            <input id="tf-city" name="city" type="text" autocomplete="address-level2" required />
          </div>
          <div class="tf-field">
            <label for="tf-country">Country/Region <span class="tf-req" aria-hidden="true">*</span></label>
            <input id="tf-country" name="country" type="text" autocomplete="country-name" required />
          </div>
        </div>

        <div class="tf-field">
          <label for="tf-size">Company size (number of employees)</label>
          <input id="tf-size" name="company_size_for_forms" type="number" min="0" step="1" />
        </div>

        <div class="tf-consent">
          <p>fileflex.com is committed to protecting and respecting your privacy, and we'll only use your personal information to administer your account and to provide the products and services you requested from us. From time to time, we would like to contact you about our products and services, as well as other content that may be of interest to you. If you consent to us contacting you for this purpose, please tick below to say how you would like us to contact you:</p>
          <label class="tf-checkbox">
            <input type="checkbox" id="tf-comm-consent" name="communicationConsent" value="true" />
            <span>I agree to receive other communications from fileflex.com.</span>
          </label>
          <p class="tf-consent__fine">You can unsubscribe from these communications at any time. For more information on how to unsubscribe, our privacy practices, and how we are committed to protecting and respecting your privacy, please review our <a href="https://www.qnext.com/privacy-policy/" target="_blank" rel="noopener">Privacy Policy</a>.</p>
          <p class="tf-consent__fine">By clicking Submit below, you consent to allow fileflex.com to store and process the personal information submitted above to provide you the content requested.</p>
        </div>

        <!-- Honeypot: real users won't fill this; bots usually will. Visually hidden, hidden from a11y tree. -->
        <div class="tf-honeypot" aria-hidden="true">
          <label for="tf-website-url-2">Leave this field blank</label>
          <input id="tf-website-url-2" type="text" name="website_url_confirm" tabindex="-1" autocomplete="off" />
        </div>

        <div class="tf-actions">
          <button type="submit" class="tf-submit">Submit</button>
        </div>
      </form>

      <div id="tf-status" class="tf-status" role="status" aria-live="polite"></div>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('tf-form');
    if (!form) return;
    var status = document.getElementById('tf-status');
    var submitBtn = form.querySelector('.tf-submit');
    var portalId = form.dataset.portalId;
    var formId = form.dataset.formId;
    var endpoint = 'https://api.hsforms.com/submissions/v3/integration/submit/' + portalId + '/' + formId;
    var MIN_FILL_MS = 2500;
    var renderedAt = Date.now();
    var SUCCESS_MSG = 'Thanks for submitting the free trial request. Someone will contact you shortly.';

    function setStatus(msg, cls) {
      status.textContent = msg;
      status.className = 'tf-status tf-status--' + cls;
    }
    function getHsCookie() {
      var m = document.cookie.match(/(?:^|;\s*)hubspotutk=([^;]+)/);
      return m ? m[1] : '';
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }

      var honey = form.querySelector('[name="website_url_confirm"]');
      if (honey && honey.value) {
        form.style.display = 'none';
        setStatus(SUCCESS_MSG, 'ok');
        return;
      }
      if (Date.now() - renderedAt < MIN_FILL_MS) {
        setStatus('Please take a moment to review your entries before submitting.', 'err');
        return;
      }

      var fd = new FormData(form);
      var fields = [];
      var SKIP = { communicationConsent: 1, website_url_confirm: 1 };
      fd.forEach(function (value, name) {
        if (SKIP[name]) return;
        if (value === '' || value == null) return; // skip empty optional fields
        fields.push({ name: name, value: String(value) });
      });

      var commConsent = form.querySelector('#tf-comm-consent').checked;
      var hutk = getHsCookie();
      var payload = {
        submittedAt: Date.now(),
        fields: fields,
        context: { pageUri: window.location.href, pageName: document.title },
        legalConsentOptions: {
          consent: {
            consentToProcess: true,
            text: 'By clicking Submit below, you consent to allow fileflex.com to store and process the personal information submitted above to provide you the content requested.',
            communications: [{
              value: commConsent,
              subscriptionTypeId: 32387186,
              text: 'I agree to receive other communications from fileflex.com.',
            }],
          },
        },
      };
      if (hutk) payload.context.hutk = hutk;

      submitBtn.disabled = true;
      setStatus('Sending…', 'pending');

      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (r) {
          return r.text().then(function (t) {
            var body;
            try { body = JSON.parse(t); } catch (_) { body = { message: t.slice(0, 200) }; }
            return { ok: r.ok, status: r.status, body: body };
          });
        })
        .then(function (res) {
          if (res.ok) {
            form.style.display = 'none';
            setStatus(SUCCESS_MSG, 'ok');
            status.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            var msg = 'Submission failed. Please review the form and try again.';
            if (res.body && res.body.errors && res.body.errors.length) {
              msg = res.body.errors.map(function (e) { return e.message || e.errorType; }).join(' ');
            } else if (res.body && res.body.message) {
              msg = res.body.message;
            }
            setStatus(msg + ' (HTTP ' + res.status + ')', 'err');
            submitBtn.disabled = false;
          }
        })
        .catch(function () {
          setStatus('Network error. Please try again or contact us directly.', 'err');
          submitBtn.disabled = false;
        });
    });
  })();
</script>

</Layout>

<style>
  /* HERO */
  #tf-hero {
    background: #0E1A2B;
    padding: 120px 7vw 56px;
  }
  .tf-hero__inner { max-width: 1200px; margin: 0 auto; }
  .tf-hero__title {
    font-family: "Inter", sans-serif;
    color: #fff;
    font-size: clamp(28px, 3.6vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  /* MAIN — two-column */
  #tf-main {
    background: #f1f1f1;
    padding: 72px 7vw 96px;
  }
  .tf-main__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 420px) 1fr;
    gap: 64px;
    align-items: start;
  }

  /* aside */
  .tf-aside__title {
    font-family: "Inter", sans-serif;
    color: #0E1A2B;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 24px;
  }
  .tf-aside__list { list-style: none; padding: 0; margin: 0; }
  .tf-aside__list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-family: "Inter", sans-serif;
    color: #2a2f3a;
    font-size: 16px;
    line-height: 1.55;
    margin-bottom: 14px;
  }
  .tf-check { flex: 0 0 22px; width: 22px; height: 22px; margin-top: 2px; }

  /* form */
  .tf-form__title {
    font-family: "Inter", sans-serif;
    color: #0E1A2B;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0 0 28px;
  }
  .tf-form { font-family: "Inter", sans-serif; }
  .tf-req { color: #b00020; margin-left: 2px; }

  .tf-field { margin-bottom: 16px; }
  .tf-field label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #0E1A2B;
    margin-bottom: 6px;
  }
  .tf-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 12px;
    font-family: "Inter", sans-serif;
    font-size: 15px;
    color: #0E1A2B;
    background: #fff;
    border: 1px solid #cfd4dc;
    border-radius: 3px;
  }
  .tf-field input:focus {
    outline: none;
    border-color: #e8590a;
    box-shadow: 0 0 0 2px rgba(232, 89, 10, 0.18);
  }
  .tf-field input:invalid:not(:placeholder-shown) { border-color: #b00020; }

  .tf-grid { display: grid; gap: 16px; }
  .tf-grid--2 { grid-template-columns: 1fr 1fr; }

  .tf-consent {
    margin: 18px 0 8px;
    padding: 16px;
    background: #f6f8fb;
    border-left: 3px solid #021372;
    border-radius: 2px;
  }
  .tf-consent p {
    font-size: 13.5px;
    line-height: 1.55;
    color: #2a2f3a;
    margin: 0 0 12px;
  }
  .tf-consent__fine { color: #4a5260 !important; font-size: 12.5px !important; }
  .tf-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: #0E1A2B;
    cursor: pointer;
    margin: 6px 0 12px;
  }
  .tf-checkbox input { margin-top: 3px; accent-color: #e8590a; }
  .tf-consent a { color: #021372; text-decoration: underline; }

  /* Honeypot */
  .tf-honeypot {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .tf-actions { margin-top: 18px; }
  .tf-submit {
    background: #e8590a;
    color: #fff;
    border: 0;
    border-radius: 3px;
    padding: 12px 28px;
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .tf-submit:hover:not(:disabled) { background: #c54a07; }
  .tf-submit:disabled { opacity: 0.6; cursor: not-allowed; }

  .tf-status {
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 3px;
    font-size: 14px;
    display: none;
  }
  .tf-status--pending { display: block; background: #eef2fb; color: #021372; }
  .tf-status--ok      { display: block; background: #e6f4ea; color: #1e6b34; border: 1px solid #b6dcc1; }
  .tf-status--err     { display: block; background: #fdecea; color: #b00020; border: 1px solid #f5c2c0; }

  @media (max-width: 900px) {
    #tf-hero { padding: 100px 6vw 40px; }
    #tf-main { padding: 48px 6vw 64px; }
    .tf-main__inner { grid-template-columns: 1fr; gap: 48px; }
    .tf-grid--2 { grid-template-columns: 1fr; }
  }
</style>
