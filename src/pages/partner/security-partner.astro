---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import '../../styles/fileflex.css';
import '../../styles/platform.css';
import '../../styles/partner.css';
---

<Layout
  title="Become a FileFlex ZTDA Managed Services Security Partner | FileFlex Enterprise"
  description="As a FileFlex ZTDA Managed Services Security Partner, deliver our Zero Trust Data Access overlay service as your own zero trust data security solution. You set the prices, host the services, and bill the customer."
>

<Nav current="partner" />

<!-- ============================================================
     HERO
     ============================================================ -->
<section id="ptr-hero" class="sp-hero" aria-labelledby="ptr-hero-heading">
  <div class="ptr-hero__inner">
    <h1 id="ptr-hero-heading" class="ptr-hero__title">
      Become a FileFlex ZTDA Managed Services Security Partner
    </h1>
    <p class="ptr-hero__lede">
      As a FileFlex ZTDA Managed Services Security Partner you deliver our zero trust data overlay
      services as your own zero trust data security solution. You set your prices and margins.
      You host the services. You bill the customer.
    </p>
    <div class="ptr-hero__ctas">
      <a class="ptr-btn ptr-btn--orange" href="/partner-form/" target="_blank" rel="noopener">
        <span>Join Our Partner Team</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ============================================================
     READY — H2 centered + 2-column text intro
     ============================================================ -->
<section id="sp-ready" class="pf-section pf-section--white" aria-labelledby="sp-ready-heading">
  <div class="pf-section__inner">
    <h2 id="sp-ready-heading" class="pf-title pf-title--center sp-ready__title">
      With the FileFlex Enterprise ZTDA overlay service you will be geared up for the latest in remote worker cyber protection
    </h2>
    <div class="sp-ready__cols">
      <p>
        It's time to join the growing global network of managed security service providers and provide
        the FileFlex zero trust data security overlay service to enterprise, government, education and
        many other customers.
      </p>
      <p>
        Our <strong>ZTDA Managed Service Security Partner Program</strong> enables you to grow a
        robust zero trust data security services business by providing you with the sales, marketing,
        and technical support you need to give your clients amazing service levels.
      </p>
    </div>
  </div>
</section>

<!-- ============================================================
     IMAGE BANNER (before "How We Support")
     ============================================================ -->
<div class="sp-banner" role="img" aria-label="Cybersecurity overlay protecting enterprise data"></div>

<!-- ============================================================
     HOW WE SUPPORT — orange band heading
     ============================================================ -->
<section id="sp-support-head" class="sp-support-head" aria-labelledby="ptr-support-heading">
  <div class="pf-section__inner">
    <h2 id="ptr-support-heading" class="sp-support-head__title">How We Support Our ZTDA Managed Services Partners</h2>
  </div>
</section>

<section id="ptr-support" class="pf-section" aria-label="Partner support detail rows">
  <div class="pf-section__inner">
    <div class="ptr-support__rows">
      <!-- Row 1: Partner Success Team — text LEFT, image RIGHT -->
      <article class="ptr-srow ptr-srow--flip">
        <div class="ptr-srow__img" style="background-image:url('/images/partner/security-partner/minimize-ramsomeware-bg1.jpg')" aria-hidden="true"></div>
        <div class="ptr-srow__body">
          <p class="ptr-srow__eyebrow">Partner Success</p>
          <h3 class="ptr-srow__title">Partner Success Team</h3>
          <p class="ptr-srow__copy">
            Your success is our goal. Within 24 hours of registering, members of our Partner Success
            Team will contact you and get you up and running on our program. And, when you need some
            advice, the ZTDA Success Team will be there to help out.
          </p>
          <p class="ptr-srow__copy">
            Partner with FileFlex and we'll help you build and sustain a profitable customer
            relationship with our solutions. You will get product discounts, support and ongoing
            access to valuable content and webinars.
          </p>
        </div>
      </article>

      <!-- Row 2: Smart Marketing Tools — image LEFT, text RIGHT -->
      <article class="ptr-srow">
        <div class="ptr-srow__img" style="background-image:url('/images/partner/security-partner/iStock-826232986-web.jpg')" aria-hidden="true"></div>
        <div class="ptr-srow__body">
          <p class="ptr-srow__eyebrow">Sales &amp; Marketing</p>
          <h3 class="ptr-srow__title">Smart Marketing Tools to Increase Sales</h3>
          <p class="ptr-srow__copy">
            Close more deals and upsell more clients with proven sales and marketing assets. With
            campaigns-in-a-box, pricing and positioning guides, and demos at your fingertips, you've
            got everything you need to grow revenue, reduce churn, and ensure your success.
          </p>
          <ul class="ptr-srow__list">
            <li><strong>Account Dashboard</strong> — Get a quick summary of your account status.</li>
            <li><strong>Content Hub</strong> — Access our marketing content so you can provide your customers with useful information.</li>
            <li><strong>Support</strong> — Submit support requests to your assigned sales engineer.</li>
            <li><strong>Sales</strong> — Check out the latest materials, promotions and development programs plus pricing and licensing information.</li>
            <li><strong>Training</strong> — Send your technicians to attend our training seminars to receive certification.</li>
          </ul>
        </div>
      </article>

      <!-- Row 3: Certified ZTDA Education — text LEFT, image RIGHT -->
      <article class="ptr-srow ptr-srow--flip">
        <div class="ptr-srow__img" style="background-image:url('/images/partner/security-partner/iStock-1211994283-web.jpg')" aria-hidden="true"></div>
        <div class="ptr-srow__body">
          <p class="ptr-srow__eyebrow">Certification</p>
          <h3 class="ptr-srow__title">Certified ZTDA Education Program</h3>
          <p class="ptr-srow__copy">
            We want to make you experts. Our on-demand instruction program for technical and sales
            professionals is designed to enhance your zero trust data cybersecurity knowledge. Our
            ZTDA Programs include sales and support training, sales engineer certification and
            webinars to help you overcome today's and tomorrow's cyber challenges.
          </p>
        </div>
      </article>

      <!-- Row 4: Learn More — image LEFT, text RIGHT -->
      <article class="ptr-srow">
        <div class="ptr-srow__img" style="background-image:url('/images/partner/security-partner/iStock-1291478674-web.jpg')" aria-hidden="true"></div>
        <div class="ptr-srow__body">
          <p class="ptr-srow__eyebrow">Resources</p>
          <h3 class="ptr-srow__title">Learn More About Latest FileFlex Enterprise ZTDA</h3>
          <p class="ptr-srow__copy">
            Keep up with the latest news, posts, events, webinars and more. In our Virtual Learning
            Centre you can get the latest news and all kinds of whitepapers, webinars, blogs,
            brochures and other education resources.
          </p>
          <div class="sp-resources">
            <a class="ptr-btn ptr-btn--orange" href="/blog/" rel="noopener">
              <span>FileFlex Blog</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
            </a>
            <a class="ptr-btn ptr-btn--orange" href="/webinars/all-webinars/">
              <span>Explore Webinars</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ============================================================
     FINAL CTA
     ============================================================ -->
<section id="sp-final" class="sp-final" aria-labelledby="sp-final-heading">
  <div class="sp-final__inner">
    <h2 id="sp-final-heading" class="sr-only">Join Our Partner Team</h2>
    <a class="ptr-btn ptr-btn--orange" href="/partner-form/" target="_blank" rel="noopener">
      <span>Join Our Partner Team</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
    </a>
  </div>
</section>

<style>
  /* Hero background override — security-partner specific */
  #ptr-hero.sp-hero {
    background: #0b1224 url('/images/partner/security-partner/iStock-1226864145-web.jpg') center/cover no-repeat;
  }

  /* 2-column text intro under H2 */
  .sp-ready__title { max-width: 1100px; margin-left: auto; margin-right: auto; }
  .sp-ready__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 56px;
    max-width: 1100px;
    margin: 40px auto 0;
    font-family: 'DM Sans', sans-serif;
    color: #51606F;
    font-size: 17px;
    line-height: 1.65;
  }
  .sp-ready__cols p { margin: 0; }
  @media (max-width: 768px) {
    .sp-ready__cols { grid-template-columns: 1fr; gap: 20px; }
  }

  /* Image banner strip before support */
  .sp-banner {
    width: 100%;
    min-height: 260px;
    background: #0b1224 url('/images/partner/security-partner/iStock-1132045052-web.jpg') center/cover no-repeat;
  }
  @media (max-width: 768px) {
    .sp-banner { min-height: 180px; }
  }

  /* Orange support heading band */
  .sp-support-head {
    background: #e8590a;
    padding: 56px 6vw;
    text-align: center;
  }
  .sp-support-head__title {
    color: #fff;
    font-weight: 700;
    font-size: clamp(23px, 2.89vw, 37px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Resources buttons (Learn More section) */
  .sp-resources {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 20px;
  }

  /* Final CTA band */
  .sp-final {
    background: #394f66;
    padding: 60px 6vw;
    text-align: center;
  }
  .sp-final__inner { max-width: 1100px; margin: 0 auto; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
</style>

</Layout>
