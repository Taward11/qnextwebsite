---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/fileflex.css';
import '../styles/platform.css';
import '../styles/partner.css';
---

<Layout
  title="Partner Program — Zero Trust Data Access | FileFlex Enterprise"
  description="Join the FileFlex Enterprise ZTDA Security Partner Program. Become a Managed Services Security Partner or Technology Partner and deliver Zero Trust Data Access security overlay services to your customers."
>

<Nav current="partner" />

<!-- ============================================================
     HERO
     ============================================================ -->
<section id="ptr-hero" aria-labelledby="ptr-hero-heading">
  <div class="ptr-hero__inner">
    <img class="ptr-hero__logo" src="/images/partner/ZTDA-noTM.webp" alt="ZTDA — Zero Trust Data Access" loading="eager" fetchpriority="high" decoding="async" />
    <h1 id="ptr-hero-heading" class="ptr-hero__title">
      Join our Zero Trust Data Access Security Partner Program
    </h1>
    <p class="ptr-hero__lede">
      Bring order to the chaos of remote access to unstructured data for your customers with the
      FileFlex Enterprise Zero Trust Data Access security overlay service.
    </p>
    <div class="ptr-hero__ctas">
      <a class="ptr-btn ptr-btn--blue" href="/downloads/Qnext-Partner-Program.pdf" download>
        <span>Download Brochure</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13"/><polyline points="6 11 12 17 18 11"/><path d="M5 21h14"/></svg>
      </a>
      <a class="ptr-btn ptr-btn--orange" href="#ptr-final">
        <span>Join Our Partner Team</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ============================================================
     FAST TRACK
     ============================================================ -->
<section id="ptr-fast" class="pf-section pf-section--white" aria-labelledby="ptr-fast-heading">
  <div class="pf-section__inner">
    <p class="pf-eyebrow pf-eyebrow--center">The Program</p>
    <h2 id="ptr-fast-heading" class="pf-title pf-title--center">Fast Track Your ZTDA Security Services Business</h2>
    <p class="ptr-fast__intro">
      Let's all work together and deliver Zero Trust Data Access and sharing to everyone and minimize ransomware.
    </p>
    <ul class="ptr-fast__bullets">
      <li>Add ZTDA Overlay Services to your offerings</li>
      <li>Ongoing sales, marketing, and technical support</li>
      <li>Deliver unified unstructured data access</li>
      <li>On-demand training and certification</li>
      <li>30 days free trial</li>
      <li>Zero Trust Data Security designed for the hybrid workforce</li>
      <li>Access to the ZTDA Program</li>
    </ul>

    <div class="ptr-types">
      <article class="ptr-type ptr-type--msp">
        <div class="ptr-type__img" style="background-image:url('/images/partner/partner-msp.webp')" aria-hidden="true"></div>
        <div class="ptr-type__body">
          <p class="ptr-type__num">01 — MSP Track</p>
          <h3 class="ptr-type__title">Become a Managed Services Security Partner</h3>
          <p class="ptr-type__copy">
            We provide you with the world's #1 and only Zero Trust Data and Sharing overlay service. With
            FileFlex Enterprise you deliver enhanced unstructured data access, sharing and security while
            minimizing ransomware.
          </p>
          <a class="ptr-type__cta" href="#ptr-final" aria-label="Find out more about the MSP Track partnership">Find Out More</a>
        </div>
      </article>

      <article class="ptr-type ptr-type--tech">
        <div class="ptr-type__img" style="background-image:url('/images/partner/partner-tech.webp')" aria-hidden="true"></div>
        <div class="ptr-type__body">
          <p class="ptr-type__num">02 — Technology Partner Track</p>
          <h3 class="ptr-type__title">Become a Technology Partner</h3>
          <p class="ptr-type__copy">
            The ZTDA Technology Partner Program is a major integration relationship. You can integrate,
            embed, OEM or create specialized offerings as a ZTDA Technology Partner. We help you meet the
            ZTDA requirements of your customers by certifying integrations with the FileFlex Enterprise
            platform.
          </p>
          <a class="ptr-type__cta" href="#ptr-final" aria-label="Find out more about the Technology Partner Track">Find Out More</a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ============================================================
     HOW WE SUPPORT
     ============================================================ -->
<section id="ptr-support" class="pf-section" aria-labelledby="ptr-support-heading">
  <div class="pf-section__inner">
    <p class="pf-eyebrow pf-eyebrow--center">Partner Enablement</p>
    <h2 id="ptr-support-heading" class="pf-title pf-title--center">How We Support Our ZTDA Partners</h2>
    <p class="ptr-support__intro">
      Everything you need to grow revenue, reduce churn, and ensure your success as a Zero Trust Data
      Access partner — sales kits, certification, and a continuously updated learning library.
    </p>

    <div class="ptr-support__rows">
      <!-- Row 1: Marketing -->
      <article class="ptr-srow">
        <div class="ptr-srow__img" style="background-image:url('/images/partner/support-marketing.webp')" aria-hidden="true"></div>
        <div class="ptr-srow__body">
          <p class="ptr-srow__eyebrow">Sales & Marketing</p>
          <h3 class="ptr-srow__title">Smart Marketing Tools to Increase Sales</h3>
          <p class="ptr-srow__copy">
            Close more deals and upsell more clients with proven sales and marketing assets. With
            campaigns-in-a-box, pricing and positioning guides, and demos at your fingertips, you've got
            everything you need to grow revenue, reduce churn, and ensure your success.
          </p>
          <ul class="ptr-srow__list">
            <li><strong>Account Dashboard</strong> — A quick summary of your account status.</li>
            <li><strong>Content Hub</strong> — Marketing content so you can provide your customers with useful information.</li>
            <li><strong>Support</strong> — Submit support requests to your assigned sales engineer.</li>
            <li><strong>Sales</strong> — The latest materials, promotions and development programs plus pricing and licensing.</li>
            <li><strong>Training</strong> — Send your technicians to attend our training seminars to receive certification.</li>
          </ul>
        </div>
      </article>

      <!-- Row 2: Education (flipped) -->
      <article class="ptr-srow ptr-srow--flip">
        <div class="ptr-srow__img" style="background-image:url('/images/partner/support-education.webp')" aria-hidden="true"></div>
        <div class="ptr-srow__body">
          <p class="ptr-srow__eyebrow">Certification</p>
          <h3 class="ptr-srow__title">Certified ZTDA Education Program</h3>
          <p class="ptr-srow__copy">
            We want to make you experts. Our on-demand instruction program for technical and sales
            professionals is designed to enhance your zero trust data cybersecurity knowledge. ZTDA
            Programs include sales and support training, sales engineer certification and webinars to
            help you overcome today's and tomorrow's cyber challenges.
          </p>
          <ul class="ptr-srow__list">
            <li><strong>Sales Training</strong> — Position and pitch ZTDA confidently.</li>
            <li><strong>Sales Engineer Certification</strong> — Earn certified-engineer status.</li>
            <li><strong>Live & On-Demand Webinars</strong> — Stay ahead of emerging cyber challenges.</li>
          </ul>
        </div>
      </article>

      <!-- Row 3: Learning Centre -->
      <article class="ptr-srow">
        <div class="ptr-srow__img" style="background-image:url('/images/partner/support-learning.webp')" aria-hidden="true"></div>
        <div class="ptr-srow__body">
          <p class="ptr-srow__eyebrow">Resources</p>
          <h3 class="ptr-srow__title">Learn More About Latest FileFlex Enterprise ZTDA</h3>
          <p class="ptr-srow__copy">
            Keep up with the latest news, posts, events, webinars and more. In our Virtual Learning
            Centre you can get the latest news and all kinds of whitepapers, webinars, blogs, brochures
            and other education resources.
          </p>
          <div class="ptr-articles">
            <a class="ptr-article" href="/blog/" target="_blank" rel="noopener">
              <div class="ptr-article__img" style="background-image:url('/images/partner/article-banks.webp')" aria-hidden="true"></div>
              <p class="ptr-article__label">FileFlex Blog — Advantages of Zero Trust Virtual Data Rooms for Banks and Credit Unions</p>
            </a>
            <a class="ptr-article" href="/blog/" target="_blank" rel="noopener">
              <div class="ptr-article__img" style="background-image:url('/images/partner/article-hybrid.webp')" aria-hidden="true"></div>
              <p class="ptr-article__label">Explore Webinars — Federated Hybrid Access: Why Modern Organizations Can't Afford to Ignore It</p>
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ============================================================
     FINAL CTA
     ============================================================ -->
<section id="ptr-final" aria-labelledby="ptr-final-heading">
  <div class="ptr-final__inner">
    <h2 id="ptr-final-heading" class="ptr-final__title">Ready to deliver Zero Trust Data Access to your customers?</h2>
    <p class="ptr-final__copy">
      Join the FileFlex Enterprise ZTDA Partner Program and add the world's only Zero Trust Data and
      Sharing overlay service to your portfolio.
    </p>
    <div class="ptr-hero__ctas">
      <a class="ptr-btn ptr-btn--orange" href="/partner-form/">
        <span>Join Our Partner Team</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
      </a>
      <a class="ptr-btn ptr-btn--blue" href="/downloads/Qnext-Partner-Program.pdf" download>
        <span>Download Brochure</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13"/><polyline points="6 11 12 17 18 11"/><path d="M5 21h14"/></svg>
      </a>
    </div>
  </div>
</section>

</Layout>
